// Nar arayüz kitaplığının vitrini: her bileşen, birkaç örnek ve yanında
// onu üreten Nar kodu.
//
// Hem belge hem göz denetimi: bir bileşen bozulduğunda burada görünür.
//
//     nar build ornekler/arayuz_galerisi.nar --target web -o cikti/galeri.html
//     nar build ornekler/arayuz_galerisi.nar --target ghb

import "../araclar/arayuz.nar"
import "../araclar/kaliplar.nar"

struct Durum {
  var sekme: Int
  // canlı örneklerin durumu
  var ad: String
  var not: String
  var yas: Int
  var abone: Bool
  var sehir: String
  var ilerleme: Int
  var anahtar: Bool
  var radyo: String
  var kaydirici: Int
  var akordeon: Int
  var sayfa: Int
  var iletisim: Bool
  var menuSecimi: String
  var adim: Int
  var icSekme: Int
  var gezinti: Int
  var dugmeGrubu: Int
  var yildiz: Int
  var kaydirak: Int
  var katla: Bool
  var bildirim: Bool
  var yanPanel: Bool
  // görsel ayarlar
  var koyu: Bool
  var yumusak: Bool
  var takvim: TakvimDurumu
}

var uygulama: Uygulama<Durum>? = none

// Çizilmekte olan durum. İlk çizim `uygulamaBaslat`ın içinde olur; o an
// `uygulama` değişkenine henüz atama yapılmamıştır, bu yüzden bölümler
// durumu uygulamadan değil buradan okur.
var SON_DURUM: Durum? = none

fn guncelle(yeni: Durum) {
  if uygulama != none {
    uygulama!.degistir(yeni)
  }
}

fn d() -> Durum = SON_DURUM!

// --- bölüm kalıbı ---------------------------------------------------------
//
// Her bileşen aynı düzende sunulur: adı, ne işe yaradığı, canlı örnek,
// onu üreten Nar kodu ve o kodun ürettiği HTML. Üçü bir arada durmalı —
// vitrin aynı zamanda belgedir, ve HTML'i görmeden CSS'i yazılmaz.
//
// Üçüncü yüzü `Ornek` kendisi okur: çizdiği ağacın `innerHTML`i. Yani
// gösterilen HTML ile ekranda duran şey ayrışamaz.

fn bolum(baslik: String, aciklama: String, gosterim: Gorunum,
         kod: String) -> Gorunum = Sutun([
  Bosluk(8),
  AltBaslik(baslik),
  Paragraf(aciklama),
  Ornek("", kod, gosterim)
])

// --- 1. sayfa iskeleti ----------------------------------------------------
//
// Bootstrap navbar, Foundation top bar, MUI app bar, Tailwind hero/footer
// blokları — hepsi aynı dört parçayı çözüyor. Burada da dördü var ve
// dördü de durumsuz: hangi bağın etkin olduğunu uygulama söyler.

fn sayfaBolumu() -> Gorunum = Sutun([
  bolum("Üst şerit", "Marka, bağlantılar, sağda bir eylem. Dar ekranda bağ şeridi yerine menü çıkar; ikisi de her zaman basılır, hangisinin görüneceğine CSS karar verir.",
    Gezinti("Nar", ["Ürün", "Belgeler", "Fiyat", "Blog"], d().gezinti, |i| {
      let g = d()
      g.gezinti = i
      guncelle(g)
    }, Dugme("Başla", || { })),
    "Gezinti(\"Nar\", [\"Ürün\", \"Belgeler\", \"Fiyat\"], durum.sayfa,\n  |i| { durum.sayfa = i },\n  Dugme(\"Başla\", || { basla() }))"),

  bolum("Açılış", "Üst etiket, başlık, açıklama, eylemler. Başlık 22 karakterde kırılır: açılış başlığı okunacak değil, görülecek bir şeydir.",
    Kahraman("Yeni · v0.1", "Arayüzü dille yaz, CSS ile değil",
      "Görünüm ağacı bildirimseldir: ne istediğini yazarsın, HTML ve CSS ondan çıkar.",
      [Dugme("Başla", || { }), IkincilDugme("Belgeler", || { })]),
    "Kahraman(\"Yeni · v0.1\", \"Arayüzü dille yaz, CSS ile değil\",\n  \"Görünüm ağacı bildirimseldir...\",\n  [Dugme(\"Başla\", || { }), IkincilDugme(\"Belgeler\", || { })])"),

  bolum("Bölüm", "Başlık, açıklama ve içerik. Tanıtım sayfasının omurgası: aynı ritimle tekrar eden blok.",
    Bolum("Neden Nar?", "Üç cümlelik gerekçe, altında üç kart.",
      Izgara(3, [
        Kart("Az kod", [Metin("Aynı ekran, üçte bir satır.")]),
        Kart("Tek dil", [Metin("Arayüz, sunucu ve araçlar aynı yerde.")]),
        Kart("Ölçülü", [Metin("Kontrastlar tahmin edilmedi, ölçüldü.")])
      ])),
    "Bolum(\"Neden Nar?\", \"Üç cümlelik gerekçe.\",\n  Izgara(3, [Kart(\"Az kod\", [...]), ...]))"),

  bolum("Dip", "Sütunlara ayrılmış bağlantılar, altında tek satır not. Sütun sayısını ekran genişliği belirler.",
    AltBilgi(["Ürün", "Kaynak", "Kurum"], [
      [Bag("Belgeler", "#"), Bag("Bileşenler", "#"), Bag("Fiyat", "#")],
      [Bag("GitHub", "#"), Bag("Sürüm notları", "#")],
      [Bag("Hakkında", "#"), Bag("İletişim", "#")]
    ], "© 2026 Nar · MIT"),
    "AltBilgi([\"Ürün\", \"Kaynak\"], [\n  [Bag(\"Belgeler\", \"#\"), Bag(\"Bileşenler\", \"#\")],\n  [Bag(\"GitHub\", \"#\")]\n], \"© 2026 Nar · MIT\")"),

  bolum("Yol", "Nerede olduğunu gösterir. Son parça bağlantı değil — zaten oradasın.",
    Kirinti(["Belgeler", "Arayüz", "Bileşenler"], |i| {
      let g = d()
      g.gezinti = i
      guncelle(g)
    }),
    "Kirinti([\"Belgeler\", \"Arayüz\", \"Bileşenler\"], |i| { git(i) })"),

  bolum("Dördü bir arada", "`Yigin` boşluk bırakmaz; parçalar bitişir ve ortaya sayfanın kendisi çıkar. Kitaplık artık sayfanın içini değil, sayfayı kuruyor.",
    Yigin([
      Gezinti("Kavurma", ["Menü", "Hakkında"], 0, |i| { },
        SessizDugme("Giriş", || { })),
      Kahraman("", "Sabah taze kavrulur", "Günlük kavurma, aynı gün kargo.",
        [Dugme("Sipariş ver", || { })]),
      AltBilgi(["Kavurma"], [[Bag("İletişim", "#")]], "© 2026")
    ]),
    "Yigin([\n  Gezinti(\"Kavurma\", [\"Menü\", \"Hakkında\"], 0, |i| { git(i) },\n    SessizDugme(\"Giriş\", || { })),\n  Kahraman(\"\", \"Sabah taze kavrulur\", \"Günlük kavurma.\",\n    [Dugme(\"Sipariş ver\", || { })]),\n  AltBilgi([\"Kavurma\"], [[Bag(\"İletişim\", \"#\")]], \"© 2026\")\n])")
])

// --- 0. temel -------------------------------------------------------------

fn temelBolumu() -> Gorunum = Sutun([
  bolum("Yazı", "Başlıktan dipnota kadar altı kademe. Paragraf 66 karakterde kırılır; bu ölçü okumayı kolaylaştırır.",
    Sutun([
      Baslik("Nar ile arayüz"),
      AltBaslik("Alt başlık"),
      Metin("Düz metin satırı."),
      Paragraf("Paragraf uzun metin içindir. Genişliği sınırlanır, rengi biraz yumuşatılır; göz satır sonunu ararken yorulmasın."),
      Etiket("küçük etiket")
    ]),
    "Baslik(\"Nar ile arayüz\")\nAltBaslik(\"Alt başlık\")\nMetin(\"Düz metin satırı.\")\nParagraf(\"Paragraf uzun metin içindir...\")\nEtiket(\"küçük etiket\")"),

  bolum("Rozet", "Kısa durum etiketi. Beş ton: bilgi, başarı, uyarı, hata ve nötr.",
    Satir([
      Rozet("bilgi", TON_BILGI),
      Rozet("başarı", TON_BASARI),
      Rozet("uyarı", TON_UYARI),
      Rozet("hata", TON_HATA),
      Rozet("nötr", "notr"),
      Rozet("v0.1", "notr")
    ]),
    "Rozet(\"bilgi\", TON_BILGI)\nRozet(\"başarı\", TON_BASARI)\nRozet(\"nötr\", \"notr\")"),

  bolum("Simge", "Otuz sekiz çizgi simge. İçinde bulunduğu yazının rengini ve boyutunu alır; ayrıca renk vermek gerekmez.",
    Sutun([
      Satir([
        Simge("ara"), Simge("arti"), Simge("carpi"), Simge("onay"),
        Simge("bilgi"), Simge("basari"), Simge("uyari"), Simge("hata"),
        Simge("kalp"), Simge("yildiz"), Simge("ayar"), Simge("kullanici")
      ]),
      Satir([
        Simge("ev"), Simge("dosya"), Simge("klasor"), Simge("cop"),
        Simge("kalem"), Simge("indir"), Simge("yukle"), Simge("gunes"),
        Simge("ay"), Simge("menu"), Simge("nokta"), Simge("kilit")
      ]),
      Satir([
        Simge("posta"), Simge("takvim"), Simge("saat"), Simge("grafik"),
        Simge("filtre"), Simge("yenile"), Simge("kod"), Simge("oyna"),
        Simge("dur"), Simge("bag"), Simge("paket"), Simge("ok-sag")
      ])
    ]),
    "Simge(\"ara\")\nSimge(\"yildiz\")\n\n// Yazının içinde de kullanılır:\nSatir([Simge(\"saat\"), Metin(\"3 dakika önce\")])"),

  bolum("Avatar", "Resim varsa resim, yoksa addan çıkarılan baş harfler.",
    Satir([
      Avatar("Ayşe Yılmaz", ""),
      Avatar("Mehmet", ""),
      Avatar("Zeynep Kara Demir", ""),
      Metin("Ayşe Yılmaz"),
      Rozet("yönetici", "notr")
    ]),
    "Avatar(\"Ayşe Yılmaz\", \"\")        // baş harfler: AY\nAvatar(\"Ayşe\", \"/resim/ayse.jpg\")  // resim"),

  bolum("Bağlantı ve alıntı", "Dış bağlantılar yeni sekmede açılır ve `rel=noopener` alır.",
    Sutun([
      Bag("Nar deposu", "https://github.com/ridocs/nar-dili"),
      Alinti("Bir dilin gücü, yazdığın şeyin ne kadarını sildiğinle ölçülür.",
             "Nar rehberi")
    ]),
    "Bag(\"Nar deposu\", \"https://github.com/ridocs/nar-dili\")\nAlinti(\"Bir dilin gücü...\", \"Nar rehberi\")"),

  bolum("Düğmeler", "Dört ağırlık: birincil eylem, ikincil, sessiz ve tehlikeli. Bir ekranda tek birincil düğme olsun.",
    Sutun([
      Satir([
        Dugme("Kaydet", || { }),
        IkincilDugme("Vazgeç", || { }),
        SessizDugme("Daha sonra", || { }),
        TehlikeDugmesi("Sil", || { })
      ]),
      Satir([
        IkonDugme("kalem", "düzenle", || { }),
        IkonDugme("cop", "sil", || { }),
        IkonDugme("indir", "indir", || { }),
        IkonDugme("nokta", "daha fazla", || { })
      ])
    ]),
    "Dugme(\"Kaydet\", || { kaydet() })\nIkincilDugme(\"Vazgeç\", || { kapat() })\nSessizDugme(\"Daha sonra\", || { ertele() })\nTehlikeDugmesi(\"Sil\", || { sil() })\nIkonDugme(\"cop\", \"sil\", || { sil() })"),

  bolum("Düğme grubu", "Birbirini dışlayan birkaç seçenek. Sekmeden farkı: sayfayı değiştirmez, aynı şeyin görünümünü değiştirir.",
    DugmeGrubu(["Gün", "Hafta", "Ay"], d().dugmeGrubu, |i| {
      let g = d()
      g.dugmeGrubu = i
      guncelle(g)
    }),
    "DugmeGrubu([\"Gün\", \"Hafta\", \"Ay\"], durum.aralik,\n           |i| { durum.aralik = i })"),

  bolum("Kod bloğu", "Uzun satır sarmaz, kendi içinde kayar.",
    KodBloku("fn topla(a: Int, b: Int) -> Int {\n  return a + b\n}"),
    "KodBloku(\"fn selam(ad: String) -> String { ... }\")")
])

// --- 1. girdi -------------------------------------------------------------

fn girdiBolumu() -> Gorunum = Sutun([
  bolum("Metin girdisi", "Tek satır, çok satır ve sayı. Her biri yazdıkça haber verir.",
    Sutun([
      Alan("Ad", "Görünen adın.", Giris("adını yaz...", d().ad, |v| {
        let g = d()
        g.ad = v
        guncelle(g)
      })),
      Alan("Not", "Birkaç cümle yeter.", CokSatir("not bırak...", d().not, |v| {
        let g = d()
        g.not = v
        guncelle(g)
      })),
      Alan("Yaş", "", SayiGirisi("yaş", d().yas, |v| {
        let g = d()
        g.yas = v
        guncelle(g)
      })),
      Metin("girilen: ${d().ad} · ${d().yas}")
    ]),
    "Alan(\"Ad\", \"Görünen adın.\", Giris(\"adını yaz...\", durum.ad, |v| {\n  durum.ad = v\n}))"),

  bolum("Alan ve hata", "Etiket, girdi ve altında ipucu. Hatalıysa aynı yer kırmızıya döner.",
    Sutun([
      Alan("E-posta", "Kimseyle paylaşılmaz.",
           Giris("ornek@site.com", "", |v| { })),
      HataliAlan("E-posta", "Bu adres geçerli görünmüyor.",
                 Giris("ornek@site.com", "ornek@", |v| { }))
    ]),
    "Alan(\"E-posta\", \"Kimseyle paylaşılmaz.\", Giris(...))\nHataliAlan(\"E-posta\", \"Bu adres geçerli görünmüyor.\", Giris(...))"),

  bolum("Seçim", "Onay kutusu, anahtar, radyo ve açılır liste. Anahtar anında etki eden ayarlar için, onay kutusu kaydedilecek formlar için.",
    Sutun([
      Onay("Haberleri gönder", d().abone, |v| {
        let g = d()
        g.abone = v
        guncelle(g)
      }),
      Anahtar("Koyu tema", d().anahtar, |v| {
        let g = d()
        g.anahtar = v
        guncelle(g)
      }),
      Ayrac("radyo"),
      Radyo(["Günlük", "Haftalık", "Aylık"], d().radyo, |v| {
        let g = d()
        g.radyo = v
        guncelle(g)
      }),
      Ayrac("açılır liste"),
      Secim(["İstanbul", "Ankara", "İzmir", "Mardin"], d().sehir, |v| {
        let g = d()
        g.sehir = v
        guncelle(g)
      }),
      Metin("seçilen: ${d().radyo} · ${d().sehir}")
    ]),
    "Onay(\"Haberleri gönder\", durum.abone, |v| { durum.abone = v })\nAnahtar(\"Koyu tema\", durum.koyu, |v| { durum.koyu = v })\nRadyo([\"Günlük\", \"Haftalık\"], durum.sik, |v| { durum.sik = v })\nSecim([\"İstanbul\", \"Ankara\"], durum.sehir, |v| { durum.sehir = v })"),

  bolum("Takvim", "Giriş ve çıkış gününü seçtiren aralık takvimi. Önce giriş, sonra çıkış gününe tıkla; aradaki geceler şerit olur. Geçmiş günler kapalı.",
    Takvim(d().takvim, |yeni| {
      let g = d()
      g.takvim = yeni
      guncelle(g)
    }),
    "Takvim(durum.takvim, |yeni| { durum.takvim = yeni })\n\n// Durum: hangi ay görünüyor, hangi günler seçili\nlet t = takvimDurumu()   // bugünden başlayan iki aylık\nt.tekTarih = true        // aralık değil tek gün"),

  bolum("Kaydırıcı", "Aralıktan bir sayı. Değer sürüklerken anında görünür.",
    Sutun([
      Kaydirici(0, 100, d().kaydirici, |v| {
        let g = d()
        g.kaydirici = v
        guncelle(g)
      }),
      Ilerleme(d().kaydirici)
    ]),
    "Kaydirici(0, 100, durum.ses, |v| { durum.ses = v })\nIlerleme(durum.ses)"),

  bolum("Yıldız", "Puan verir. Seçili yıldıza tekrar basmak puanı sıfırlar — vazgeçmenin yolu olmalı.",
    Satir([
      Yildiz(d().yildiz, 5, |v| {
        let g = d()
        g.yildiz = v
        guncelle(g)
      }),
      Soluk(if d().yildiz == 0 { "puan yok" } else { "${d().yildiz} / 5" })
    ]),
    "Yildiz(durum.puan, 5, |v| { durum.puan = v })")
])

// --- 2. yerleşim ----------------------------------------------------------

fn kutucuk(yazi: String) -> Gorunum = Kutu([Metin(yazi)])

fn yerlesimBolumu() -> Gorunum = Sutun([
  bolum("Sütun, satır, esnek", "Sütun alt alta, satır yan yana dizer. Esnek yan yana dizer ama yer kalmayınca alt satıra taşar.",
    Sutun([
      Etiket("satır"),
      Satir([kutucuk("bir"), kutucuk("iki"), kutucuk("üç")]),
      Etiket("esnek"),
      Esnek([kutucuk("bir"), kutucuk("iki"), kutucuk("üç"), kutucuk("dört"),
             kutucuk("beş"), kutucuk("altı")])
    ]),
    "Satir([Kutu([Metin(\"bir\")]), Kutu([Metin(\"iki\")])])\nEsnek([...])   // yer kalmayınca alt satıra taşar"),

  bolum("Izgara", "Eşit sütunlar. Dar ekranda kendiliğinden tek sütuna iner.",
    Izgara(3, [
      kutucuk("1"), kutucuk("2"), kutucuk("3"),
      kutucuk("4"), kutucuk("5"), kutucuk("6")
    ]),
    "Izgara(3, [\n  Kutu([Metin(\"1\")]),\n  Kutu([Metin(\"2\")]),\n  Kutu([Metin(\"3\")])\n])"),

  bolum("Kart ve kutu", "Kart başlıklıdır, kutu başlıksız. İkisi de içindekileri alt alta dizer.",
    Satir([
      Kart("Başlıklı kart", [Metin("İçerik burada.")]),
      Kutu([AltBaslik("Kutu"), Metin("Başlığını kendin koyarsın.")])
    ]),
    "Kart(\"Başlıklı kart\", [Metin(\"İçerik burada.\")])\nKutu([Metin(\"Başlıksız.\")])"),

  bolum("Ayırıcılar", "Etiketli ayraç, düz çizgi ve boşluk.",
    Sutun([
      Metin("üstteki"),
      Ayrac("ya da"),
      Metin("alttaki"),
      Cizgi,
      Metin("çizgiden sonra")
    ]),
    "Ayrac(\"ya da\")\nCizgi\nBosluk(24)"),

  bolum("Mobil uyum", "Her görünüm kendi mobil davranışını taşır. Pencereyi daraltarak dene: satır sütuna döner, rozet kaybolur.",
    Sutun([
      Satir([kutucuk("sol"), kutucuk("orta"), kutucuk("sağ")]).mobildeSutun(),
      Satir([
        Metin("Bu rozet dar ekranda gizlenir:"),
        Rozet("yalnız geniş", TON_BILGI).mobildeGizle()
      ]),
      Tablo(["Ad", "Rol"], [["Ayşe", "yönetici"], ["Mehmet", "üye"]]).mobil(Liste(["Ayşe — yönetici", "Mehmet — üye"]))
    ]),
    "Satir([...]).mobildeSutun()\nRozet(\"yalnız geniş\", TON_BILGI).mobildeGizle()\nTablo(basliklar, satirlar).mobil(Liste([...]))"),

  bolum("Liste grubu", "Çizgiyle ayrılmış satırlar. `Liste` düz metin alır, bu her satıra istediğin görünümü koydurur.",
    ListeGrubu([
      SatirYay([Metin("Yayın anahtarı"), Rozet("etkin", TON_BASARI)]),
      SatirYay([Metin("Yedekleme"), Rozet("duraklatıldı", TON_UYARI)]),
      SatirYay([Metin("İki adımlı doğrulama"), SessizDugme("Aç", || { })])
    ]),
    "ListeGrubu([\n  SatirYay([Metin(\"Yayın anahtarı\"), Rozet(\"etkin\", TON_BASARI)]),\n  SatirYay([Metin(\"Yedekleme\"), Rozet(\"duraklatıldı\", TON_UYARI)])\n])"),

  bolum("Ortam", "Solda simge ya da avatar, sağda gövde. Yorum, bildirim ve akış satırlarının ortak iskeleti.",
    Sutun([
      Ortam(Avatar("Ayşe Yılmaz", ""), Sutun([
        Satir([Metin("Ayşe Yılmaz"), Soluk("2 dk")]),
        Metin("Takvim bileşenini denedim, aralık seçimi tam istediğim gibi.")
      ])),
      Ortam(Simge("paket"), Sutun([
        Metin("narc 0.1.0 yayımlandı"),
        Soluk("Boru işleci ve dilim erişimi eklendi.")
      ]))
    ]),
    "Ortam(Avatar(\"Ayşe Yılmaz\", \"\"), Sutun([\n  Satir([Metin(\"Ayşe Yılmaz\"), Soluk(\"2 dk\")]),\n  Metin(\"Takvim bileşenini denedim.\")\n]))"),

  bolum("Yığın", "Boşluksuz sütun. `Sutun` öğeler arasına boşluk koyar; sayfa iskeleti parçaları bitişmek zorunda olduğu için bu var.",
    Yigin([
      Uyari(TON_BILGI, "Üstteki"),
      Uyari(TON_BASARI, "Ortadaki"),
      Uyari(TON_UYARI, "Alttaki")
    ]),
    "Yigin([Gezinti(...), Kahraman(...), AltBilgi(...)])")
])

// --- 3. veri --------------------------------------------------------------

fn veriBolumu() -> Gorunum = Sutun([
  bolum("İstatistik", "Bir ölçüm ve nereye gittiği. Değişimin başındaki işaret rengi belirler.",
    Esnek([
      Istatistik("Günlük indirme", "12.480", "+18%"),
      Istatistik("Açık hata", "7", "-3"),
      Istatistik("Ortalama süre", "240 ms", "0%")
    ]),
    "Istatistik(\"Günlük indirme\", \"12.480\", \"+18%\")\nIstatistik(\"Açık hata\", \"7\", \"-3\")"),

  bolum("Çubuklar", "Küçük bir grafik. Değerler kendi en büyüğüne göre ölçeklenir.",
    Cubuklar([12, 19, 8, 24, 17, 28, 22],
             ["Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz"]),
    "Cubuklar([12, 19, 8, 24, 17, 28, 22],\n         [\"Pzt\", \"Sal\", \"Çar\", \"Per\", \"Cum\", \"Cmt\", \"Paz\"])"),

  bolum("Tablo", "Başlık satırı sabit biçimde; sayılar hizalı.",
    Tablo(["Paket", "Sürüm", "Boyut"], [
      ["narc", "0.1.0", "312 KB"],
      ["arayuz", "0.1.0", "89 KB"],
      ["hareket", "0.1.0", "12 KB"]
    ]),
    "Tablo([\"Paket\", \"Sürüm\", \"Boyut\"], [\n  [\"narc\", \"0.1.0\", \"312 KB\"],\n  [\"arayuz\", \"0.1.0\", \"89 KB\"]\n])"),

  bolum("Liste ve ilerleme", "Madde listesi ve yüzde çubuğu.",
    Sutun([
      Liste(["Derleyici", "Arayüz kitaplığı", "Paket yöneticisi"]),
      Ilerleme(72),
      Metin("%72 tamam")
    ]),
    "Liste([\"Derleyici\", \"Arayüz kitaplığı\"])\nIlerleme(72)"),

  bolum("Adımlar", "Nerede olduğunu ve kaç adım kaldığını gösterir. Düğmelerle dene.",
    Sutun([
      Adimlar(["Hesap", "Ödeme", "Onay", "Bitti"], d().adim),
      Satir([
        IkincilDugme("Geri", || {
          let g = d()
          if g.adim > 0 {
            g.adim -= 1
          }
          guncelle(g)
        }),
        Dugme("İleri", || {
          let g = d()
          if g.adim < 3 {
            g.adim += 1
          }
          guncelle(g)
        })
      ])
    ]),
    "Adimlar([\"Hesap\", \"Ödeme\", \"Onay\", \"Bitti\"], durum.adim)"),

  bolum("Sayfalama", "Uzun listeleri böler. Uçlarda düğmeler kendiliğinden kapanır.",
    Sayfalama(d().sayfa, 8, |n| {
      let g = d()
      g.sayfa = n
      guncelle(g)
    }),
    "Sayfalama(durum.sayfa, 8, |n| { durum.sayfa = n })"),

  bolum("Zaman çizgisi", "Sırası olan olaylar. Noktalar arasındaki çizgi CSS'ten gelir, öğe başına ek işaret yok.",
    Zaman(["09:12", "09:40", "11:05", "14:22"],
          ["Depo klonlandı", "Derleme başarılı — 441 test geçti",
           "Sürüm etiketlendi: v0.1.0", "Yayına alındı"]),
    "Zaman([\"09:12\", \"09:40\"],\n      [\"Depo klonlandı\", \"Derleme başarılı\"])"),

  bolum("Kaydırak", "Tek tek gezilen öğeler. Uçlarda sarmalar: son öğeden ileri gitmek başa döner.",
    Kaydirak([
      Kart("Takvim", [Metin("Giriş ve çıkış tarihi seçtiren aralık takvimi.")]),
      Kart("Tablo", [Metin("Dar ekranda listeye dönebilen veri tablosu.")]),
      Kart("Takım", [Metin("Bildirimsel görünüm ağacı, tek yönlü veri akışı.")])
    ], d().kaydirak, |i| {
      let g = d()
      g.kaydirak = i
      guncelle(g)
    }),
    "Kaydirak([Kart(\"Takvim\", [...]), Kart(\"Tablo\", [...])],\n         durum.simdi, |i| { durum.simdi = i })")
])

// --- 4. geri bildirim -----------------------------------------------------

fn bildirimBolumu() -> Gorunum = Sutun([
  bolum("Uyarı", "Dört ton. Simgeyle birlikte kullanmak mesajı hızlı okutur.",
    Sutun([
      Uyari(TON_BILGI, "Kaydedilmemiş değişiklikler var."),
      Uyari(TON_BASARI, "Dosya kaydedildi."),
      Uyari(TON_UYARI, "Disk alanı azalıyor."),
      Uyari(TON_HATA, "Sunucuya ulaşılamadı.")
    ]),
    "Uyari(TON_BILGI, \"Kaydedilmemiş değişiklikler var.\")\nUyari(TON_HATA, \"Sunucuya ulaşılamadı.\")"),

  bolum("Boş durum", "Hiçbir şey yokken ne yapılacağını söyler. Boş bir liste bırakmak kullanıcıyı yolda bırakır.",
    BosDurum("klasor", "Henüz proje yok",
             "İlk projeni oluştur; şablonlardan biriyle başlayabilirsin.",
             Dugme("Yeni proje", || { })),
    "BosDurum(\"klasor\", \"Henüz proje yok\",\n         \"İlk projeni oluştur...\",\n         Dugme(\"Yeni proje\", || { yeni() }))"),

  bolum("Akordeon", "Uzun içeriği katlar. Açık bölüme tekrar tıklamak kapatır.",
    Akordeon(
      ["Nar nedir?", "Nasıl kurulur?", "Hangi hedefler var?"],
      [
        Paragraf("Türkçe hata mesajları olan, kendi derleyicisiyle gelen küçük bir dil."),
        Paragraf("Depoyu indir, `python -m narc run dosya.nar` yaz. Başka bir şey gerekmez."),
        Paragraf("js, web, masaüstü, mobil, ghb, exe ve narb.")
      ],
      d().akordeon,
      |i| {
      let g = d()
      g.akordeon = i
      guncelle(g)
    }),
  "Akordeon([\"Soru 1\", \"Soru 2\"], [Paragraf(\"...\"), Paragraf(\"...\")],\n         durum.acik, |i| { durum.acik = i })"),

bolum("Menü ve ipucu", "Açılır menü odak dışına çıkınca kapanır. İpucu üstüne gelince görünür.",
  Satir([
    Menu("İşlemler", ["Yeniden adlandır", "Çoğalt", "Dışa aktar", "Sil"], |s| {
      let g = d()
      g.menuSecimi = s
      guncelle(g)
    }),
    Ipucu("Değişiklikleri kaydeder", Dugme("Kaydet", || { })),
    Metin(if d().menuSecimi == "" { "menüden seç" } else { "seçilen: ${d().menuSecimi}" })
  ]),
  "Menu(\"İşlemler\", [\"Çoğalt\", \"Sil\"], |s| { uygula(s) })\nIpucu(\"Değişiklikleri kaydeder\", Dugme(\"Kaydet\", || { kaydet() }))"),

bolum("İletişim kutusu", "Sayfanın üstünde, ortada. Perdeye tıklamak ya da çarpı kapatır.",
  Sutun([
    Dugme("Kutuyu aç", || {
      let g = d()
      g.iletisim = true
      guncelle(g)
    }),
    if d().iletisim {
    Iletisim("Projeyi sil", [
      Paragraf("Bu işlem geri alınamaz. Proje ve içindeki 24 dosya silinir."),
      Satir([
        TehlikeDugmesi("Evet, sil", || {
          let g = d()
          g.iletisim = false
          guncelle(g)
        }),
        IkincilDugme("Vazgeç", || {
          let g = d()
          g.iletisim = false
          guncelle(g)
        })
      ])
    ], || {
      let g = d()
      g.iletisim = false
      guncelle(g)
    })
  } else {
    Bos
  }
]),
"if durum.acik {\n  Iletisim(\"Projeyi sil\", [Paragraf(\"...\")], || { durum.acik = false })\n} else {\n  Bos\n}"),

bolum("Sekmeler", "Aynı yerde birden çok görünüm.",
Sutun([
  Sekmeler(["Genel", "Güvenlik", "Bildirim"], d().icSekme, |i| {
    let g = d()
    g.icSekme = i
    guncelle(g)
  }),
  Kutu([Metin(["Genel ayarlar burada.", "Parola ve oturumlar.",
               "E-posta tercihleri."][d().icSekme])])
]),
"Sekmeler([\"Genel\", \"Güvenlik\"], durum.sekme, |i| { durum.sekme = i })"),

bolum("Yükleniyor", "İskelet içerik gelmeden yerini tutar; halka kısa işler için.",
Sutun([
  Iskelet(3),
  Donuyor("derleniyor…")
]),
"Iskelet(3)\nDonuyor(\"derleniyor…\")"),

  bolum("Katla", "Tek başlıklı açılır bölüm. Akordeon birkaç bölümü birbirine bağlar, bu tek başına durur.",
    Katla("Gelişmiş ayarlar", Sutun([
      Onay("Kaynak haritası üret", true, |v| { }),
      Onay("Uyarıları hata say", false, |v| { })
    ]), d().katla, || {
      let g = d()
      g.katla = !g.katla
      guncelle(g)
    }),
    "Katla(\"Gelişmiş ayarlar\", Sutun([...]), durum.acik,\n      || { durum.acik = !durum.acik })"),

  bolum("Bildirim", "Sayfanın akışında değil, köşesinde durur. İşin bittiğini söyler ve kendini kapattırır.",
    Sutun([
      Dugme("Bildirimi göster", || {
        let g = d()
        g.bildirim = true
        guncelle(g)
      }),
      if d().bildirim {
      Bildirim(TON_BASARI, "Proje yayına alındı.", || {
        let g = d()
        g.bildirim = false
        guncelle(g)
      })
    } else { Bos }
  ]),
  "Bildirim(TON_BASARI, \"Proje yayına alındı.\",\n         || { durum.bildirim = false })"),

bolum("Yan panel", "Kenardan giren pencere. İletişim kutusu ortada durur ve odağı tek bir karara toplar; yan panel yan yardımcı içindir.",
  Sutun([
    Dugme("Paneli aç", || {
      let g = d()
      g.yanPanel = true
      guncelle(g)
    }),
    YanPanel("Filtreler", [
      Onay("Yalnız açık kayıtlar", true, |v| { }),
      Secim(["Tümü", "Bana atanan", "Bana bildirilen"], "Tümü", |v| { }),
      Dugme("Uygula", || {
        let g = d()
        g.yanPanel = false
        guncelle(g)
      })
    ], d().yanPanel, || {
      let g = d()
      g.yanPanel = false
      guncelle(g)
    })
  ]),
  "YanPanel(\"Filtreler\", [Onay(...), Secim(...)], durum.acik,\n         || { durum.acik = false })")
])

// --- 5. kalıplar ----------------------------------------------------------

fn kalipBolumu() -> Gorunum = Sutun([
  Uyari(TON_BILGI, "Kalıplar hazır ekranlardır: bileşenlerden kurulmuş, tek satırla çağrılan tasarımlar. Hepsi `araclar/kaliplar.nar` içinde."),

  bolum("Giriş ekranı", "Ortalanmış kart, alanlar, birincil eylem ve alternatif yol.",
    girisEkrani("Nar'a hoş geldin", "Devam etmek için giriş yap",
                |e, p| { }, || { }),
    "girisEkrani(\"Nar'a hoş geldin\", \"Devam etmek için giriş yap\",\n            |eposta, parola| { girisYap(eposta, parola) },\n            || { kaydolSayfasi() })"),

  bolum("Gösterge paneli", "Dört ölçüm, bir grafik ve son hareketler.",
    gostergePaneli("Bu hafta",
      [olcum("Ziyaret", "8.412", "+12%"), olcum("Yeni üye", "312", "+4%"),
       olcum("Hata", "9", "-22%"), olcum("Süre", "1.2 sn", "0%")],
      [18, 24, 16, 30, 27, 34, 29],
      ["Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz"],
      [hareket("Ayşe Yılmaz", "yeni sürüm yayınladı", "2 dk"),
       hareket("Mehmet Kaya", "bir hata kapattı", "18 dk"),
       hareket("Zeynep Ak", "belgeyi güncelledi", "1 sa")]),
    "gostergePaneli(\"Bu hafta\", olcumler, degerler, etiketler, hareketler)"),

  bolum("Fiyat kartları", "Üç seçenek; ortadaki öne çıkar.",
    fiyatKartlari([
      paket("Açık kaynak", "0₺", "her zaman", ["Sınırsız proje", "Topluluk desteği"], false, "Başla"),
      paket("Takım", "240₺", "aylık", ["Sınırsız proje", "Öncelikli destek", "Özel paketler"], true, "Takımı kur"),
      paket("Kurumsal", "Görüşelim", "", ["Kurulum desteği", "Eğitim", "SLA"], false, "İletişime geç")
    ], |ad| { }),
    "fiyatKartlari([\n  paket(\"Takım\", \"240₺\", \"aylık\", [\"...\"], true, \"Takımı kur\")\n], |ad| { sec(ad) })"),

  bolum("Özellik ızgarası", "Simge, başlık, bir cümle. Tanıtım sayfalarının omurgası.",
    ozellikIzgarasi([
      ozellik("kod", "Türkçe hatalar", "Derleyici ne olduğunu Türkçe söyler, satırı gösterir."),
      ozellik("paket", "Tek dosya", "Programın tek bir .exe olarak çıkar; kurulum istemez."),
      ozellik("grafik", "Ölçülü tasarım", "Renkler ve kontrastlar hesaplanır, tahmin edilmez."),
      ozellik("yenile", "Hızlı döngü", "Kaydet, sayfa kendini yeniler.")
    ]),
    "ozellikIzgarasi([\n  ozellik(\"kod\", \"Türkçe hatalar\", \"Derleyici ne olduğunu Türkçe söyler.\")\n])"),

  bolum("Ayarlar listesi", "Her satırda bir ayar: adı, açıklaması ve anahtarı.",
    ayarListesi("Bildirimler", [
      ayar("E-posta", "Haftalık özet gönderilsin.", true),
      ayar("Masaüstü", "Derleme bitince haber ver.", false),
      ayar("Ses", "Hata olduğunda kısa bir ses çal.", false)
    ], |ad, acik| { }),
    "ayarListesi(\"Bildirimler\", [\n  ayar(\"E-posta\", \"Haftalık özet gönderilsin.\", true)\n], |ad, acik| { degistir(ad, acik) })"),

  bolum("Profil kartı", "Avatar, ad, rol ve iki eylem.",
    Esnek([
      profilKarti("Ayşe Yılmaz", "Derleyici ekibi", "",
                  ["142 katkı", "8 paket"], || { }, || { }),
      profilKarti("Mehmet Kaya", "Arayüz", "",
                  ["63 katkı", "2 paket"], || { }, || { })
    ]),
    "profilKarti(\"Ayşe Yılmaz\", \"Derleyici ekibi\", \"\",\n            [\"142 katkı\", \"8 paket\"], || { mesaj() }, || { takip() })"),

  bolum("Sık sorulanlar", "Katlanır soru listesi; açık olan bir tane.",
    sikSorulanlar([
      soru("Nar hangi platformlarda çalışır?",
           "Windows, macOS ve Linux. Tarayıcı için ayrı bir hedef var."),
      soru("Başka bir dile bağımlı mı?",
           "Derleyici Python ile yazıldı; ürettiği program bağımsız çalışır."),
      soru("Paket yöneticisi var mı?",
           "Henüz yok, yol haritasında.")
    ], d().akordeon, |i| {
      let g = d()
      g.akordeon = i
      guncelle(g)
    }),
    "sikSorulanlar([soru(\"Soru?\", \"Cevap.\")], durum.acik, |i| { durum.acik = i })"),

  bolum("Tanıtım sayfası", "Dört iskelet parçası tek çağrıda. Değişen yalnız içerik; üst şerit, açılış, bölümler ve dip yerli yerinde durur. Dipteki bağlar üst şeritteki bağların aynısı — iki liste ayrışamaz.",
    tanitimSayfasi("Nar", ["Ürün", "Belgeler", "Fiyat"], d().gezinti, |i| {
      let g = d()
      g.gezinti = i
      guncelle(g)
    },
    Kahraman("Açık kaynak", "Arayüzü dille yaz, CSS ile değil",
      "Yetmiş altı bileşen, tek bir görünüm ağacı, iki hedef.",
      [Dugme("Başla", || { })]),
    [Bolum("Neden Nar?", "Üç sebep, üç kutu.",
       ozellikIzgarasi([
         ozellik("kod", "Az kod", "Aynı ekran, üçte bir satır."),
         ozellik("paket", "Tek dil", "Arayüz, sunucu ve araçlar bir arada."),
         ozellik("grafik", "Ölçülü", "Kontrastlar ölçüldü, tahmin edilmedi.")
       ]))],
    "© 2026 Nar · MIT"),
    "tanitimSayfasi(\"Nar\", [\"Ürün\", \"Belgeler\"], durum.sayfa,\n               |i| { durum.sayfa = i },\n               Kahraman(\"Açık kaynak\", \"Arayüzü dille yaz\", \"...\", [...]),\n               [Bolum(\"Neden Nar?\", \"\", ozellikIzgarasi(ozellikler))],\n               \"© 2026 Nar · MIT\")")
])

// --- çatı -----------------------------------------------------------------

let SEKMELER = ["Temel", "Sayfa", "Girdi", "Yerleşim", "Veri",
                "Geri bildirim", "Kalıplar"]

fn govdeBolumu() -> Gorunum = match d().sekme {
  1 -> sayfaBolumu()
  2 -> girdiBolumu()
  3 -> yerlesimBolumu()
  4 -> veriBolumu()
  5 -> bildirimBolumu()
  6 -> kalipBolumu()
  _ -> temelBolumu()
}

fn ciz(durum: Durum) -> Gorunum {
  SON_DURUM = durum
  return Sutun([
  Satir([
    Sutun([
      Satir([Baslik("Nar arayüz kitaplığı"), Rozet("v0.1", "notr")]),
      Paragraf("Yetmiş altı bileşen, yedi hazır kalıp. Hepsi Nar ile " +
        "yazıldı; her örneğin altında hem onu yazan Nar kodu, hem o " +
        "kodun ürettiği HTML duruyor.")
    ]),
    Sutun([
      Anahtar("Koyu", durum.koyu, |v| {
        let g = d()
        g.koyu = v
        guncelle(g)
        temaSec(if v { "koyu" } else { "acik" })
      }),
      Anahtar("Yumuşak", durum.yumusak, |v| {
        let g = d()
        g.yumusak = v
        guncelle(g)
        deriSec(if v { "yumusak" } else { "" })
      })
    ]).mobildeGizle()
  ]).mobildeSutun(),
  Bosluk(4),
  Sekmeler(SEKMELER, durum.sekme, |i| {
    let g = d()
    g.sekme = i
    guncelle(g)
  }),
  Bosluk(4),
  govdeBolumu(),
  Bosluk(16),
  Cizgi,
  Satir([
    Metin("Nar arayüz kitaplığı"),
    Bag("kaynak", "https://github.com/ridocs/nar-dili")
  ])
  ])
}

fn main() {
  // Bu bir sayfa programı; Node ile çalıştırılırsa çizecek bir yer yok.
  if bul("#uygulama") == none {
    print("Bu program tarayıcıda çalıştırılmalı.")
    print("Derle:  nar build ornekler/arayuz_galerisi.nar --target web")
    return
  }

  let baslangic = Durum {
    sekme: 0,
    ad: "",
    not: "",
    yas: 28,
    abone: true,
    sehir: "Mardin",
    ilerleme: 62,
    anahtar: false,
    radyo: "Haftalık",
    kaydirici: 40,
    akordeon: 0,
    sayfa: 1,
    iletisim: false,
    menuSecimi: "",
    adim: 1,
    icSekme: 0,
    gezinti: 1,
    dugmeGrubu: 1,
    yildiz: 4,
    kaydirak: 0,
    katla: true,
    bildirim: false,
    yanPanel: false,
    koyu: false,
    yumusak: true,
    takvim: takvimDurumu()
  }
  deriSec("yumusak")
  // Vitrin geniş: yan yana üç kart 820px'e sığmıyor.
  uygulama = uygulamaBaslat("#uygulama", baslangic, ciz)
  genislikKur(1080)
}
