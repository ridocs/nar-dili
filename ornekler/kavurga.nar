// Kavurga — küçük bir kahve kavurma atölyesinin sitesi.
//
// Tek dosyada çalışan bir dükkân: ürünler, sepet, abonelik planı,
// ilk teslimat günü ve iletişim formu. Hepsi Nar ile.
//
//     nar build ornekler/kavurga.nar --target web -o cikti/kavurga.html
//     nar build ornekler/kavurga.nar --target ghb

import "../araclar/arayuz.nar"
import "../araclar/kaliplar.nar"

// --- veri ------------------------------------------------------------------

struct Cekirdek {
  var ad: String
  var yore: String
  var not: String
  var fiyat: Int          // 250 gram, kuruş değil tam lira
  var yogunluk: Int       // 1–5
  var rozet: String = ""
}

let CEKIRDEKLER = [
  Cekirdek { ad: "Sabah Harmanı", yore: "Brezilya · Kolombiya",
  not: "Fındık, kakao, yumuşak asit", fiyat: 240, yogunluk: 3,
  rozet: "en çok satan" },
Cekirdek { ad: "Gün Batımı", yore: "Etiyopya Yirgacheffe",
  not: "Bergamot, şeftali, çiçeksi", fiyat: 320, yogunluk: 2 },
Cekirdek { ad: "Demirci", yore: "Sumatra Mandheling",
  not: "Tütün, kara erik, toprak", fiyat: 290, yogunluk: 5,
  rozet: "koyu kavrum" },
Cekirdek { ad: "Mardin Usulü", yore: "Yemen · Harrazi",
  not: "Kakule ile öğütülmüş, baharatlı", fiyat: 360, yogunluk: 4 }
]

// Sepetteki bir satır: hangi çekirdek, kaç paket.
struct SepetSatiri {
  var cekirdek: Int       // CEKIRDEKLER içindeki sıra
  var adet: Int = 1
}

struct Durum {
  var sepet: [SepetSatiri] = []
  var plan: String = ""
  var ogutum: String = "Demlik"
  var teslimat: TakvimDurumu
  var sss: Int = -1
  var eposta: String = ""
  var gonderildi: Bool = false
  var sepetAcik: Bool = false
}

var uygulama: Uygulama<Durum>? = none
var SON: Durum? = none

fn d() -> Durum = SON!

fn guncelle(yeni: Durum) {
  if uygulama != none {
    uygulama!.degistir(yeni)
  }
}

// --- para ------------------------------------------------------------------

// 1240 -> "1.240". Binlik ayracı sondan üçer üçer konur.
fn binlik(n: Int) -> String {
  let s = str(n)
  var sonuc = ""
  for (i, h) in s.split("") {
    if i > 0 && (s.len() - i) % 3 == 0 {
      sonuc += "."
    }
    sonuc += h
  }
  return sonuc
}

fn para(n: Int) -> String = binlik(n) + " ₺"

// --- sepet hesabı ----------------------------------------------------------

fn sepetAdedi() -> Int {
  var toplam = 0
  for s in d().sepet {
    toplam += s.adet
  }
  return toplam
}

fn araToplam() -> Int {
  var toplam = 0
  for s in d().sepet {
    toplam += CEKIRDEKLER[s.cekirdek].fiyat * s.adet
  }
  return toplam
}

fn planIndirimi() -> Int = match d().plan {
  "Haftalık" -> araToplam() * 15 / 100
  "İki haftada bir" -> araToplam() * 10 / 100
  _ -> 0
}

fn kargo() -> Int = if araToplam() >= 500 || araToplam() == 0 { 0 } else { 60 }

fn toplam() -> Int = araToplam() - planIndirimi() + kargo()

fn sepeteEkle(sira: Int) {
  let g = d()
  var bulundu = false
  for s in g.sepet {
    if s.cekirdek == sira {
      s.adet += 1
      bulundu = true
    }
  }
  if !bulundu {
    g.sepet.push(SepetSatiri { cekirdek: sira })
  }
  g.sepetAcik = true
  guncelle(g)
}

fn adetDegistir(sira: Int, yon: Int) {
  let g = d()
  var yeni: [SepetSatiri] = []
  for s in g.sepet {
    if s.cekirdek == sira {
      s.adet += yon
    }
    if s.adet > 0 {
      yeni.push(s)
    }
  }
  g.sepet = yeni
  guncelle(g)
}

// --- parçalar --------------------------------------------------------------

fn yogunlukCizgisi(n: Int) -> Gorunum {
  var kutular: [Gorunum] = []
  for i in 1..=5 {
    kutular.push(Rozet(if i <= n { "●" } else { "○" }, "notr"))
  }
  return Satir(kutular)
}

fn urunKarti(sira: Int, c: Cekirdek) -> Gorunum {
  var ic: [Gorunum] = []
  if c.rozet != "" {
    ic.push(Rozet(c.rozet, TON_BILGI))
  }
  ic.push(AltBaslik(c.ad))
  ic.push(Soluk(c.yore))
  ic.push(Paragraf(c.not))
  ic.push(SatirYay([
    Soluk("kavrum"),
    yogunlukCizgisi(c.yogunluk)
  ]))
  // Kartların içeriği farklı uzunlukta; fiyat satırı hep altta dursun.
  ic.push(Doldur)
  ic.push(Cizgi)
  ic.push(SatirYay([
    Sutun([
      Metin(para(c.fiyat)),
      Soluk("250 g")
    ]),
    Dugme("Sepete at", || { sepeteEkle(sira) })
  ]))
  return Kutu(ic)
}

fn urunler() -> Gorunum {
  var kartlar: [Gorunum] = []
  for (i, c) in CEKIRDEKLER {
    kartlar.push(urunKarti(i, c))
  }
  return Izgara(2, kartlar)
}

fn sepetSatiri(s: SepetSatiri) -> Gorunum {
  let c = CEKIRDEKLER[s.cekirdek]
  return SatirYay([
    Sutun([
      Metin(c.ad),
      Soluk(str(s.adet) + " × " + para(c.fiyat))
    ]),
    Satir([
      IkonDugme("carpi", "bir azalt", || { adetDegistir(s.cekirdek, -1) }),
      Metin(str(s.adet)),
      IkonDugme("arti", "bir artır", || { adetDegistir(s.cekirdek, 1) })
    ])
  ])
}

fn sepetKutusu() -> Gorunum {
  if d().sepet.len() == 0 {
    return BosDurum("paket", "Sepet boş",
                    "Yukarıdan bir çekirdek seç; hepsi siparişten sonra kavruluyor.",
                    Bos)
  }
  var ic: [Gorunum] = []
  for s in d().sepet {
    ic.push(sepetSatiri(s))
  }
  ic.push(Cizgi)
  ic.push(SatirYay([Soluk("Ara toplam"), Metin(para(araToplam()))]))
  if planIndirimi() > 0 {
    ic.push(SatirYay([
      Soluk("Abonelik indirimi · " + d().plan),
      Metin("-" + para(planIndirimi()))
    ]))
  }
  ic.push(SatirYay([
    Soluk(if kargo() == 0 { "Kargo (500 ₺ üzeri bedava)" } else { "Kargo" }),
    Metin(if kargo() == 0 { "bedava" } else { para(kargo()) })
  ]))
  ic.push(Cizgi)
  ic.push(SatirYay([Metin("Toplam"), Baslik(para(toplam()))]))
  ic.push(Alan("Öğütüm", "Değirmenin varsa çekirdek olarak gönderiyoruz.",
               Secim(["Çekirdek", "Demlik", "French press", "Espresso", "Türk kahvesi"],
                     d().ogutum, |v| {
                let g = d()
                g.ogutum = v
                guncelle(g)
              })))
  ic.push(Dugme("Siparişi tamamla", || {
    let g = d()
    g.gonderildi = true
    guncelle(g)
  }))
  if d().gonderildi {
    ic.push(Uyari(TON_BASARI,
      "Sipariş alındı. " + str(sepetAdedi()) + " paket, " +
      tarihMetni(d().teslimat.giris) + " günü kavrulup yola çıkıyor."))
  }
  return Kart("Sepet", ic)
}

fn abonelik() -> Gorunum = fiyatKartlari([
  paket("Tek seferlik", "0₺", "indirim yok",
        ["İstediğin zaman sipariş", "Kargo 500 ₺ üzeri bedava"],
        false, "Seç"),
  paket("İki haftada bir", "%10", "indirim",
        ["Her siparişte %10", "Kavrum günü sabit", "İstediğinde durdur"],
        false, "Seç"),
  paket("Haftalık", "%15", "indirim",
        ["Her siparişte %15", "Öncelikli kavrum", "Kargo hep bedava"],
        true, "Seç")
], |ad| {
  let g = d()
  g.plan = ad
  guncelle(g)
})

fn sorular() -> Gorunum = sikSorulanlar([
  soru("Kahve ne zaman kavruluyor?",
       "Siparişten sonra. Teslimat günü olarak seçtiğin tarihin sabahı kavurup aynı gün yola çıkarıyoruz."),
  soru("Ne kadar tazeyken içmeliyim?",
       "Kavrumdan sonraki 3. gün ile 3. hafta arası en iyi aralık. Paketin üstünde kavrum tarihi yazıyor."),
  soru("Öğütülmüş isteyebilir miyim?",
       "Evet, sepette demleme yöntemini seçiyorsun. Değirmenin varsa çekirdek olarak almanı öneririz."),
  soru("Aboneliği nasıl durdururum?",
       "Tek tıkla. Sonraki kavrumdan 24 saat öncesine kadar durdurabilir ya da erteleyebilirsin.")
], d().sss, |i| {
  let g = d()
  g.sss = i
  guncelle(g)
})

fn iletisim() -> Gorunum = Kart("Kavrum günü haber listesi", [
  Paragraf("Haftanın çekirdeklerini perşembe sabahı yazıyoruz. Başka bir şey göndermiyoruz."),
  Alan("E-posta", "Tek tıkla çıkabilirsin.",
       Giris("ornek@site.com", d().eposta, |v| {
        let g = d()
        g.eposta = v
        guncelle(g)
      })),
      Satir([
        Dugme("Listeye katıl", || {
          let g = d()
          g.gonderildi = true
          guncelle(g)
        }),
        Soluk(if d().eposta.contains("@") { "adres geçerli görünüyor" } else { "" })
      ])
    ])

// --- sayfa -----------------------------------------------------------------

fn baslik() -> Gorunum = SatirYay([
  Sutun([
    Satir([Baslik("Kavurga"), Rozet("Mardin", "notr")]),
    Soluk("küçük parti kahve kavurma atölyesi")
  ]),
  Satir([
    IkonDugme("paket", "sepet", || {
      let g = d()
      g.sepetAcik = !g.sepetAcik
      guncelle(g)
    }),
    Rozet(str(sepetAdedi()) + " paket", if sepetAdedi() > 0 { TON_BILGI } else { "notr" })
  ])
])

fn tanitim() -> Gorunum = Kutu([
  Baslik("Kavrulduğu gün yola çıkar"),
  Paragraf("Haftada iki gün, 12 kiloluk küçük partiler hâlinde kavuruyoruz. " +
    "Siparişini aldığımız gün değil, senin seçtiğin teslimat günü kavuruyoruz; " +
    "paket eve vardığında kahve üç günlük oluyor."),
  Satir([
    Dugme("Haftalık abone ol", || {
      let g = d()
      g.plan = "Haftalık"
      guncelle(g)
    }),
    IkincilDugme("Nasıl çalışır?", || {
      let g = d()
      g.sss = 0
      guncelle(g)
    })
  ]),
  Bosluk(4),
  Esnek([
    Istatistik("Haftalık kavrum", "48 kg", "+6%"),
    Istatistik("Abone", "310", "+12"),
    Istatistik("Ortalama tazelik", "3 gün", "0")
  ])
])

fn ciz(durum: Durum) -> Gorunum {
  SON = durum
  var bolumler: [Gorunum] = [
    baslik(),
    Cizgi,
    tanitim(),
    Bosluk(8),
    Ayrac("çekirdekler"),
    urunler()
  ]

  if durum.sepetAcik || durum.sepet.len() > 0 {
    bolumler = [...bolumler, Bosluk(8), Ayrac("sepet"), sepetKutusu()]
  }

  return Sutun([...bolumler,
    Bosluk(8),
    Ayrac("abonelik"),
    abonelik(),
    Bosluk(8),
    Ayrac("ilk teslimat"),
    Paragraf("Kavrum günü sensin: seçtiğin tarihin sabahı kavurup yola çıkarıyoruz."),
    Takvim(durum.teslimat, |yeni| {
      let g = d()
      g.teslimat = yeni
      g.gonderildi = false
      guncelle(g)
    }),
    Bosluk(8),
    Ayrac("sık sorulanlar"),
    sorular(),
    Bosluk(8),
    iletisim(),
    Bosluk(8),
    Cizgi,
    SatirYay([
      Soluk("Kavurga · Mardin · Nar ile yazıldı"),
      Bag("kaynak", "https://github.com/ridocs/nar-dili")
    ])
  ])
}

fn main() {
  if bul("#uygulama") == none {
    print("Bu program tarayıcıda çalıştırılmalı.")
    print("Derle:  nar build ornekler/kavurga.nar --target web")
    return
  }
  deriSec("yumusak")
  uygulama = uygulamaBaslat("#uygulama", Durum {
    teslimat: takvimDurumu(aySayisi: 1, tekTarih: true)
  }, ciz)
  genislikKur(980)
}
