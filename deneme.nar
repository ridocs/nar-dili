// Burası senin oyun alanın. İstediğin gibi değiştir, sonra çalıştır:
//
//     .\nar.cmd run deneme.nar
//
// Her program bir `main` fonksiyonuyla başlar.

fn main() {
  print("Merhaba Nar!")

  // --- değişkenler ---
  let ad = "Mustafa"           // let = değişmez
  var sayi = 7                 // var = değiştirilebilir
  sayi += 3
  print("${ad}, sayı ${sayi}")

  // --- listeler: lambda yazmadan ---
  let sayilar = [5, 3, 8, 1]

  print("sıralı:", sayilar.sort())
  print("iki katları:", sayilar.kat(2))
  print("büyükler:", sayilar.buyukler(3))
  print("küçükler:", sayilar.kucukler(3))
  print("toplam:", sayilar.toplam())
  print("ortalama:", sayilar.ortalama())
  print("en büyük:", sayilar.enBuyuk() ?? 0)
  print("çiftler:", sayilar.ciftler())
  print("tekler:", sayilar.tekler())

  let kelimeler = ["nar", "elma", "kiraz"]
  print("büyük harf:", kelimeler.buyukHarf())
  print("küçük harf:", ["NAR", "ELMA"].kucukHarf())

  // --- koşul: değer üretebilir ---
  let durum = if sayi >= 18 { "yetişkin" } else { "genç" }
  print("durum:", durum)

  // --- döngü ---
  for i in 1..=5 {
    let tip = if i % 2 == 0 { "çift" } else { "tek" }
    print("${i} ${tip}")
  }

  // --- kendi fonksiyonun (tek satırlık yazılabilir) ---
  print("faktöriyel(6) =", faktoriyel(6))
  print("kare(9) =", kare(9))

  // --- kendi tipin ---
  let k = Kisi { ad: "Ayşe", yas: 30 }
  print(k.selam())

  // --- seçenekler ve match ---
  print(tavsiye(Hava.Yagmurlu))

  // --- olmayabilen değer ---
  let takma: String? = none
  print("takma ad:", takma ?? "yok")
}

// Tek satırlık fonksiyon: gövde yerine `= ifade`
fn kare(x: Int) -> Int = x * x

fn faktoriyel(n: Int) -> Int {
  if n <= 1 {
    return 1
  }
  return n * faktoriyel(n - 1)
}

struct Kisi {
  ad: String
  yas: Int

  fn selam() -> String = "Ben ${self.ad}, ${self.yas} yaşındayım."
}

enum Hava {
  Gunesli
  Yagmurlu
  Karli
}

fn tavsiye(h: Hava) -> String = match h {
  Hava.Gunesli -> "Şapka al."
  Hava.Yagmurlu -> "Şemsiye al."
  Hava.Karli -> "Mont al."
}
