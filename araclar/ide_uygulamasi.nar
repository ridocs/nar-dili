// Nar IDE'nin davranışı — Nar diliyle yazılmıştır.
//
// HTML dosyasında yalnızca iskelet ve stiller var; düzenleyicinin nasıl
// çalıştığı burada tanımlı: dosya ağacı, renklendirme, satır numaraları,
// hata altı çizgileri, sorun listesi, klavye kısayolları, tip denetimi,
// çalıştırma, dosya açma, yeni dosya ve kaydetme.
//
// Tarayıcı `Nar.baslat()` çağırarak her şeyi başlatır.
//
//     nar build araclar/ide_uygulamasi.nar --kutuphane -o cikti/nar-ide.js

import "ide_araclari.nar"
import "json.nar"

// --- durum ----------------------------------------------------------------

var acikYol = "deneme.nar"
var kaydedilmis = ""
var denetimSayaci = 0
var calisiyor = false
var dosyaYollari: [String] = []

// Son denetimin bulduğu sorunlar. Oluk işaretleri, hata altı çizgileri ve
// Sorunlar paneli hep bu listeden beslenir; tek kaynak.
struct Sorun {
  satir: Int
  sutun: Int
  uzunluk: Int
  mesaj: String
  ipucu: String
  seviye: String        // "hata" | "uyari"
}

var sorunlar: [Sorun] = []

// --- öğe kısayolları ------------------------------------------------------
// Her erişimde aranır; IDE'de öğe sayısı az, bu maliyet önemsizdir.

fn kodAlani() -> Element? = bul("#kod")
fn boyaAlani() -> Element? = bul("#boya code")
fn altcizgiAlani() -> Element? = bul("#altcizgi code")
fn satirAlani() -> Element? = bul("#satirlar")
fn denetimRozeti() -> Element? = bul("#denetim")
fn durumYazisi() -> Element? = bul("#durum")
fn durumNoktasi() -> Element? = bul("#nokta")
fn imlecYazisi() -> Element? = bul("#imlec")
fn dosyaAdiYazisi() -> Element? = bul("#dosya-adi")
fn degistiIsareti() -> Element? = bul("#degisti")
fn sureYazisi() -> Element? = bul("#sure")
fn surumYazisi() -> Element? = bul("#surum")
fn motorYazisi() -> Element? = bul("#motor")
fn agacAlani() -> Element? = bul("#agac")

fn kaynakMetni() -> String {
  if let k = kodAlani() {
    return k.deger()
  }
  return ""
}

// --- çizim ----------------------------------------------------------------

fn ciz() {
  anahatGuncelle()
  let kaynak = kaynakMetni()

  if let boya = boyaAlani() {
    boya.htmlYaz(renklendir(kaynak) + "\n")
  }
  if let alt = altcizgiAlani() {
    alt.htmlYaz(altcizgiHtml(kaynak) + "\n")
  }
  if let satirlar = satirAlani() {
    satirlar.htmlYaz(satirNumaralari(kaynak))
  }
  if let isaret = degistiIsareti() {
    if kaynak == kaydedilmis {
      isaret.stil("display", "none")
    } else {
      isaret.stil("display", "inline")
    }
  }
}

// Satırdaki en ağır seviye: "hata", "uyari" ya da "".
fn satirSeviyesi(satir: Int) -> String {
  var seviye = ""
  for s in sorunlar {
    if s.satir == satir {
      if s.seviye == "hata" {
        return "hata"
      }
      seviye = s.seviye
    }
  }
  return seviye
}

fn hataSayisi() -> Int {
  var n = 0
  for s in sorunlar {
    if s.seviye == "hata" {
      n += 1
    }
  }
  return n
}

fn satirNumaralari(kaynak: String) -> String {
  let adet = satirSayisi(kaynak)
  var parcalar: [String] = []
  for i in 1..=adet {
    let seviye = satirSeviyesi(i)
    if seviye == "hata" {
      parcalar.push("<b>${i}</b>")
    } else if seviye == "uyari" {
      parcalar.push("<i>${i}</i>")
    } else {
      parcalar.push(str(i))
    }
  }
  return parcalar.join("\n")
}

// Hata altı çizgisi katmanı: kaynağın her karakteri yerine boşluk, hata
// aralıkları bir `span` içinde. Boyalı metnin ortasına sütun hesabıyla
// etiket sokmak yerine aynı ölçülerde saydam bir katman.
fn altcizgiHtml(kaynak: String) -> String {
  let satirlar = kaynak.split("\n")
  var cikti: [String] = []
  for (i, satir) in satirlar {
    let no = i + 1
    var parca = ""
    var konum = 0                 // 0 tabanlı, işlenen sütun
    for s in sorunlar {
      if s.satir != no {
        continue
      }
      let bas = s.sutun - 1
      if bas < konum || bas > satir.len() {
        continue
      }
      var uzunluk = s.uzunluk
      if uzunluk < 1 {
        uzunluk = 1
      }
      if bas + uzunluk > satir.len() {
        uzunluk = max(1, satir.len() - bas)
      }
      parca += " ".repeat(bas - konum)
      parca += "<span class=\"dalgali " + s.seviye + "\">" + " ".repeat(uzunluk) + "</span>"
      konum = bas + uzunluk
    }
    cikti.push(parca)
  }
  return cikti.join("\n")
}

fn esitle() {
  if let k = kodAlani() {
    let ust = k.kaydirmaUst()
    let sol = k.kaydirmaSol()
    if let boya = bul("#boya") {
      boya.kaydirmaUstYaz(ust)
      boya.stil("margin-left", "-${sol}px")
    }
    if let alt = bul("#altcizgi") {
      alt.kaydirmaUstYaz(ust)
      alt.stil("margin-left", "-${sol}px")
    }
    if let satirlar = satirAlani() {
      satirlar.kaydirmaUstYaz(ust)
    }
  }
}

fn imlecBildir() {
  if let k = kodAlani() {
    if let yazi = imlecYazisi() {
      let yer = satirSutun(k.deger(), k.secimBasi())
      yazi.metinYaz("satır ${yer[0]}, sütun ${yer[1]}")
    }
  }
}

fn satirGit(satir: Int) {
  if satir <= 0 {
    return
  }
  if let k = kodAlani() {
    let metin = k.deger()
    let satirlar = metin.split("\n")
    var konum = 0
    var i = 0
    while i < satir - 1 && i < satirlar.len() {
      konum += satirlar[i].len() + 1
      i += 1
    }
    var uzunluk = 0
    if satir - 1 < satirlar.len() {
      uzunluk = satirlar[satir - 1].len()
    }
    k.odaklan()
    k.secimYap(konum, konum + uzunluk)
    k.kaydirmaUstYaz(max(0, (satir - 4) * 21))
    esitle()
    imlecBildir()
  }
}

// --- durum çubuğu ---------------------------------------------------------

fn durumYaz(mesaj: String, hataMi: Bool) {
  if let yazi = durumYazisi() {
    yazi.metinYaz(mesaj)
    if hataMi {
      yazi.sinifEkle("tiklanir")
    } else {
      yazi.sinifSil("tiklanir")
    }
  }
  if let nokta = durumNoktasi() {
    if hataMi {
      nokta.sinifEkle("kotu")
    } else {
      nokta.sinifSil("kotu")
    }
  }
}

fn rozetYaz(metin: String, sinif: String) {
  if let rozet = denetimRozeti() {
    rozet.metinYaz(metin)
    rozet.ozellikYaz("class", "rozet " + sinif)
  }
}

// --- sağ panel sekmeleri --------------------------------------------------

let PANOLAR = ["pano-cikti", "pano-sorunlar", "pano-js", "pano-ekran"]

fn sekmeSec(ad: String) {
  for p in PANOLAR {
    if let pano = bul("#" + p) {
      if p == ad {
        pano.stil("display", "block")
      } else {
        pano.stil("display", "none")
      }
    }
  }
  for d in bulHepsi(".sekme") {
    if (d.ozellik("data-pano") ?? "") == ad {
      d.ozellikYaz("aria-selected", "true")
    } else {
      d.ozellikYaz("aria-selected", "false")
    }
  }
}

fn panoYaz(ad: String, html: String) {
  if let pano = bul("#" + ad) {
    pano.htmlYaz(html)
  }
}

fn ciktiYaz(html: String) {
  panoYaz("pano-cikti", html)
}

// --- sorunlar paneli ------------------------------------------------------

fn sorunlariGoster() {
  if let sayi = bul("#sorun-sayisi") {
    if sorunlar.len() == 0 {
      sayi.metinYaz("")
    } else {
      sayi.metinYaz(str(sorunlar.len()))
    }
    // Yalnız uyarı varsa rozet sarı; hata varsa kırmızı.
    if hataSayisi() == 0 {
      sayi.sinifEkle("uyari")
    } else {
      sayi.sinifSil("uyari")
    }
  }

  if sorunlar.len() == 0 {
    panoYaz("pano-sorunlar", "<span class=\"bos\">Sorun yok.</span>")
    return
  }

  let satirlar = kaynakMetni().split("\n")
  var html = ""
  for (i, s) in sorunlar {
    var kaynakHtml = ""
    if s.satir >= 1 && s.satir <= satirlar.len() {
      let satir = satirlar[s.satir - 1]
      let bas = min(max(0, s.sutun - 1), satir.len())
      let son = min(bas + max(1, s.uzunluk), satir.len())
      kaynakHtml = "<div class=\"kaynak\">" + kacir(satir.slice(0, bas)) +
        "<mark>" + kacir(satir.slice(bas, son)) + "</mark>" +
        kacir(satir.slice(son, satir.len())) + "</div>"
    }
    var ipucuHtml = ""
    if s.ipucu != "" {
      ipucuHtml = "<div class=\"ipucu\"><b>ipucu:</b> " + kacir(s.ipucu) + "</div>"
    }
    html += "<div class=\"sorun " + s.seviye + "\" data-satir=\"${s.satir}\" data-sira=\"${i}\">" +
      "<span class=\"yer\">${s.satir}:${s.sutun}</span>" +
      "<div class=\"mesaj\">" + kacir(s.mesaj) + "</div>" +
      ipucuHtml + kaynakHtml + duzeltmeDugmeleri(i, "kart") + "</div>"
  }
  panoYaz("pano-sorunlar", html)

  for kart in bulHepsi(".sorun") {
    let hedef = int(kart.ozellik("data-satir") ?? "0") ?? 0
    kart.dinle("click", || { satirGit(hedef) })
  }
  duzeltDugmeleriniBagla(".sorun .duzelt", "kart")
}

// Sunucunun hata sözlüğünden Sorun üretir.
fn sorunOku(h: Json?, seviye: String) -> Sorun = Sorun {
  satir: tamSayiAl(alan(h, "satir")) ?? 0,
  sutun: tamSayiAl(alan(h, "sutun")) ?? 1,
  uzunluk: tamSayiAl(alan(h, "uzunluk")) ?? 1,
  mesaj: metinAl(alan(h, "mesaj")) ?? "bilinmeyen hata",
  ipucu: metinAl(alan(h, "ipucu")) ?? "",
  seviye: seviye
}

// Hatalar önce, uyarılar sonra: liste ağırdan hafife okunur.
fn sorunlariAyikla(hata: Json?, uyarilar: [Json]) {
  sorunlar = []
  if hata != none {
    let hepsi = diziAl(alan(hata, "hepsi"))
    if hepsi.len() == 0 {
      sorunlar.push(sorunOku(hata, "hata"))
    }
    for h in hepsi {
      sorunlar.push(sorunOku(h, "hata"))
    }
  }
  for u in uyarilar {
    sorunlar.push(sorunOku(u, "uyari"))
  }
}

// --- tip denetimi ---------------------------------------------------------

fn denetimPlanla() {
  rozetYaz("denetleniyor…", "")
  denetimSayaci += 1
  let benimSiram = denetimSayaci
  // Yazmayı bitirmesini bekle; arada yeni tuş gelirse bu deneme iptal olur.
  zamanla(450, || {
    if benimSiram == denetimSayaci {
      denetle()
    }
  })
}

fn denetle() {
  let govde = jsonYaz(Json.Nesne({"kaynak": Json.Metin(kaynakMetni())}))
  istek("POST", "/api/denetle", govde, |cevap: String| {
    denetimSonucu(cevap)
  })
}

fn denetimSonucu(cevap: String) {
  let veri = jsonOku(cevap)
  if veri == none {
    rozetYaz("sunucuya ulaşılamadı", "kotu")
    return
  }

  let uyarilar = diziAl(alan(veri, "uyarilar"))
  if mantikAl(alan(veri, "tamam")) ?? false {
    sorunlariAyikla(none, uyarilar)
    if uyarilar.len() == 0 {
      rozetYaz("hata yok", "iyi")
    } else {
      rozetYaz("${uyarilar.len()} uyarı", "uyari")
    }
    durumYaz("hazır", false)
    sorunlariGoster()
    ciz()
    return
  }

  sorunlariAyikla(alan(veri, "hata"), uyarilar)
  let hatalar = hataSayisi()
  if uyarilar.len() > 0 {
    rozetYaz("${hatalar} hata, ${uyarilar.len()} uyarı", "kotu")
  } else {
    rozetYaz("${hatalar} hata", "kotu")
  }
  if sorunlar.len() > 0 {
    let ilk = sorunlar[0]
    if ilk.satir > 0 {
      durumYaz("satır ${ilk.satir}: ${ilk.mesaj}", true)
    } else {
      durumYaz(ilk.mesaj, true)
    }
  }
  sorunlariGoster()
  ciz()
}

// --- çalıştırma -----------------------------------------------------------

fn calistir() {
  if calisiyor {
    return
  }
  calisiyor = true

  if let sure = sureYazisi() {
    sure.metinYaz("")
  }
  sekmeSec("pano-cikti")
  ciktiYaz("<span class=\"bos\">çalışıyor…</span>")

  let govde = jsonYaz(Json.Nesne({"kaynak": Json.Metin(kaynakMetni())}))
  istek("POST", "/api/calistir", govde, |cevap: String| {
    calisiyor = false
    calismaSonucu(cevap)
  })
}

fn calismaSonucu(cevap: String) {
  let veri = jsonOku(cevap)
  if veri == none {
    ciktiYaz("sunucuya ulaşılamadı")
    return
  }

  let durum = metinAl(alan(veri, "durum")) ?? ""

  if durum == "derleme-hatasi" || durum == "ortam-hatasi" {
    sorunlariAyikla(alan(veri, "hata"), diziAl(alan(veri, "uyarilar")))
    sorunlariGoster()
    ciz()
    let gosterim = metinAl(alan(alan(veri, "hata"), "gosterim")) ?? "hata"
    ciktiYaz("<div class=\"hata-blok\" id=\"hata-blok\">" + kacir(gosterim) + "</div>")
    if let blok = bul("#hata-blok") {
      blok.dinle("click", || { sekmeSec("pano-sorunlar") })
    }
    // Derleme hatası varsa asıl bilgi Sorunlar panelinde.
    sekmeSec("pano-sorunlar")
    return
  }

  if durum == "zaman-asimi" {
    let m = metinAl(alan(veri, "cikti")) ?? ""
    ciktiYaz("<div class=\"uyari-blok\">" + kacir(m) + "</div>")
    return
  }

  let cikti = metinAl(alan(veri, "cikti")) ?? ""
  let stderr = metinAl(alan(veri, "stderr")) ?? ""
  // Ev sahibi programı bir sayfada çalıştırdıysa ve program ekrana bir
  // şey çizdiyse, asıl sonuç Ekran sekmesinde.
  let cizdi = mantikAl(alan(veri, "cizdi")) ?? false

  if cikti.len() == 0 && stderr.len() == 0 {
    if cizdi {
      ciktiYaz("<span class=\"bos\">program ekrana çizdi; Ekran sekmesine bak</span>")
      sekmeSec("pano-ekran")
    } else {
      ciktiYaz("<span class=\"bos\">program çalıştı, hiçbir şey yazdırmadı</span>")
    }
    return
  }

  var html = kacir(cikti)
  if stderr.len() > 0 {
    html += "<div class=\"hata-blok\">" + kacir(stderr.trim()) + "</div>"
  }
  ciktiYaz(html)
  if cizdi && stderr.len() == 0 {
    sekmeSec("pano-ekran")
  }
}

// --- üretilen JavaScript --------------------------------------------------

fn javascriptGoster() {
  sekmeSec("pano-js")
  panoYaz("pano-js", "<span class=\"bos\">üretiliyor…</span>")
  let govde = jsonYaz(Json.Nesne({"kaynak": Json.Metin(kaynakMetni())}))
  istek("POST", "/api/uretilen", govde, |cevap: String| {
    let veri = jsonOku(cevap)
    if let hata = alan(veri, "hata") {
      panoYaz("pano-js", "<div class=\"hata-blok\">" +
               kacir(metinAl(alan(hata, "gosterim")) ?? "hata") + "</div>")
      return
    }
    let kod = metinAl(alan(veri, "kod")) ?? ""
    // Çalışma zamanı önde; kullanıcının yazdığı kısmı göster.
    let isaret = "// Nar kaynağından üretildi"
    let yer = kod.indexOf(isaret)
    if yer >= 0 {
      panoYaz("pano-js", kacir(kod.slice(yer, kod.len())))
    } else {
      panoYaz("pano-js", kacir(kod))
    }
  })
}

// --- biçimlendirme --------------------------------------------------------

fn kodDuzenle() {
  if let k = kodAlani() {
    let oncesi = k.deger()
    let sonrasi = bicimlendir(oncesi)

    if sonrasi == oncesi {
      durumYaz("kod zaten düzenli", false)
      return
    }

    let yer = satirSutun(oncesi, k.secimBasi())
    k.degerYaz(sonrasi)
    ciz()
    esitle()
    satirGit(min(yer[0], satirSayisi(sonrasi)))
    durumYaz("kod düzenlendi", false)
    denetimPlanla()
  }
}

// --- dosya ağacı ----------------------------------------------------------

fn dosyalariYukle() {
  istek("GET", "/api/dosyalar", "", |cevap: String| {
    let veri = jsonOku(cevap)
    if veri == none {
      durumYaz("dosya listesi alınamadı", true)
      return
    }
    if let surum = surumYazisi() {
      surum.metinYaz("v" + (metinAl(alan(veri, "surum")) ?? "?"))
    }
    agaciDoldur(diziAl(alan(veri, "dosyalar")))
    dosyaAc(acikYol)
  })
}

fn agaciDoldur(dosyalar: [Json]) {
  dosyaYollari = []
  for d in dosyalar {
    dosyaYollari.push(metinAl(alan(d, "yol")) ?? "")
  }
  if let sayi = bul("#dosya-sayisi") {
    sayi.metinYaz("${dosyalar.len()} dosya")
  }

  if let agac = agacAlani() {
    agac.temizle()

    var gruplar: [String] = []
    for d in dosyalar {
      let grup = metinAl(alan(d, "grup")) ?? "Dosyalar"
      if !gruplar.contains(grup) {
        gruplar.push(grup)
      }
    }

    for grup in gruplar {
      let kume = olustur("details")
      kume.ozellikYaz("open", "")
      let baslik = olustur("summary")
      var adet = 0
      let liste = olustur("ul")

      for d in dosyalar {
        if (metinAl(alan(d, "grup")) ?? "") != grup {
          continue
        }
        adet += 1
        let yol = metinAl(alan(d, "yol")) ?? ""
        let oge = olustur("li")
        let dugme = olustur("button")
        dugme.ozellikYaz("type", "button")
        dugme.sinifEkle("dosya")
        dugme.ozellikYaz("data-yol", yol)
        dugme.htmlYaz(DOSYA_IKONU + "<span>" + kacir(metinAl(alan(d, "ad")) ?? "") + "</span>")
        if yol == acikYol {
          dugme.sinifEkle("secili")
        }
        dugme.dinle("click", || { dosyaAc(yol) })
        oge.ekle(dugme)
        liste.ekle(oge)
      }

      baslik.htmlYaz("<span class=\"ok\">›</span>" + kacir(grup) +
        "<span class=\"adet\">${adet}</span>")
      kume.ekle(baslik)
      kume.ekle(liste)
      agac.ekle(kume)
    }
  }
}

let DOSYA_IKONU = "<svg class=\"ikon\" viewBox=\"0 0 24 24\" fill=\"none\" " +
  "stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\">" +
  "<path d=\"M6 3h8l4 4v14H6z\"/><path d=\"M14 3v4h4\"/></svg>"

fn seciliyiIsaretle() {
  for d in bulHepsi(".dosya") {
    if (d.ozellik("data-yol") ?? "") == acikYol {
      d.sinifEkle("secili")
    } else {
      d.sinifSil("secili")
    }
  }
}

fn dosyaAc(yol: String) {
  istek("GET", "/api/dosya?yol=" + yol, "", |cevap: String| {
    let veri = jsonOku(cevap)
    if veri == none || alan(veri, "hata") != none {
      durumYaz("dosya açılamadı: " + yol, true)
      return
    }
    let kaynak = metinAl(alan(veri, "kaynak")) ?? ""
    acikYol = metinAl(alan(veri, "yol")) ?? yol
    kaydedilmis = kaynak

    if let k = kodAlani() {
      k.degerYaz(kaynak)
      k.kaydirmaUstYaz(0)
    }
    if let adYazisi = dosyaAdiYazisi() {
      adYazisi.metinYaz(acikYol)
    }
    sorunlar = []
    sorunlariGoster()
    seciliyiIsaretle()
    ciz()
    esitle()
    denetimPlanla()
  })
}

fn kaydet() {
  let govde = jsonYaz(Json.Nesne({
    "yol": Json.Metin(acikYol),
    "kaynak": Json.Metin(kaynakMetni())
  }))
  istek("POST", "/api/kaydet", govde, |cevap: String| {
    let veri = jsonOku(cevap)
    if mantikAl(alan(veri, "tamam")) ?? false {
      kaydedilmis = kaynakMetni()
      ciz()
      durumYaz("kaydedildi: " + acikYol, false)
      denetimPlanla()
    } else {
      durumYaz(metinAl(alan(veri, "hata")) ?? "kaydedilemedi", true)
    }
  })
}

// Çalışmalarım altında boş olmayan bir ad bulup yeni dosya açar.
fn yeniDosya() {
  var n = 1
  var yol = "calismalar/yeni-${n}.nar"
  while dosyaYollari.contains(yol) {
    n += 1
    yol = "calismalar/yeni-${n}.nar"
  }
  let sablon = "// Yeni Nar dosyası\n\nfn main() {\n  print(\"Merhaba\")\n}\n"
  let govde = jsonYaz(Json.Nesne({
    "yol": Json.Metin(yol),
    "kaynak": Json.Metin(sablon)
  }))
  let hedef = yol
  istek("POST", "/api/kaydet", govde, |cevap: String| {
    let veri = jsonOku(cevap)
    if mantikAl(alan(veri, "tamam")) ?? false {
      acikYol = hedef
      dosyalariYukle()
      durumYaz("oluşturuldu: " + hedef, false)
    } else {
      durumYaz(metinAl(alan(veri, "hata")) ?? "oluşturulamadı", true)
    }
  })
}

fn agaciAcKapa() {
  let g = govde()
  if g.sinifVarMi("agac-kapali") {
    g.sinifSil("agac-kapali")
  } else {
    g.sinifEkle("agac-kapali")
  }
}

// --- kod önerileri --------------------------------------------------------
//
// Yazarken imlecin solundaki parçaya göre öneri listelenir; Tab ya da Enter
// seçileni uygular, ok tuşları gezer, Esc kapatır. Kaynaklar sırayla:
// şablonlar, belgede geçen adlar, anahtar kelimeler, yerleşikler. Noktadan
// sonra yalnız metotlar önerilir.
//
// Sözlük sunucudan bir kez alınır: anahtar kelimeler ve yerleşikler
// derleyicinin kendi listesinden, metotlar üreteç tablolarından gelir.
// Ayrı bir liste tutulsaydı dille ayrışırdı.

struct Oneri {
  ad: String            // listede görünen
  metin: String         // eklenecek metin; `|` imlecin gideceği yer
  tur: String           // sablon | belge | anahtar | yerlesik | metot
}

var sozluk: [Oneri] = []
var oneriler: [Oneri] = []
var oneriSecili = 0
var oneriAcik = false
var oneriBas = 0          // değiştirilecek parçanın başı
var oneriSon = 0          // ve sonu (imleç)

let SABLONLAR: [Oneri] = [
  Oneri { ad: "fn …", metin: "fn |() {\n  \n}", tur: "sablon" },
  Oneri { ad: "main", metin: "fn main() {\n  |\n}", tur: "sablon" },
  Oneri { ad: "if …", metin: "if | {\n  \n}", tur: "sablon" },
  Oneri { ad: "if let …", metin: "if let | = {\n  \n}", tur: "sablon" },
  Oneri { ad: "else", metin: "else {\n  |\n}", tur: "sablon" },
  Oneri { ad: "for …", metin: "for | in {\n  \n}", tur: "sablon" },
  Oneri { ad: "while …", metin: "while | {\n  \n}", tur: "sablon" },
  Oneri { ad: "match …", metin: "match | {\n  \n}", tur: "sablon" },
  Oneri { ad: "struct …", metin: "struct | {\n  \n}", tur: "sablon" },
  Oneri { ad: "enum …", metin: "enum | {\n  \n}", tur: "sablon" },
  Oneri { ad: "let", metin: "let | = ", tur: "sablon" },
  Oneri { ad: "var", metin: "var | = ", tur: "sablon" },
  Oneri { ad: "print", metin: "print(|)", tur: "sablon" },
  Oneri { ad: "import", metin: "import \"|\"", tur: "sablon" }
]

fn oneriKutusu() -> Element? = bul("#oneri")

fn sozlugYukle() {
  istek("GET", "/api/kelimeler", "", |cevap: String| {
    let veri = jsonOku(cevap)
    if veri == none {
      return
    }
    sozluk = []
    for k in diziAl(alan(veri, "kelimeler")) {
      let ad = metinAl(alan(k, "ad")) ?? ""
      let tur = metinAl(alan(k, "tur")) ?? "yerlesik"
      let arg = tamSayiAl(alan(k, "arg")) ?? 0
      var metin = ad
      if tur != "anahtar" {
        if arg > 0 {
          metin = ad + "(|)"
        } else {
          metin = ad + "()"
        }
      }
      sozluk.push(Oneri { ad: ad, metin: metin, tur: tur })
    }
  })
}

// Belgede geçen adlar: iki karakterden uzun tanımlayıcılar, tekrarsız.
fn belgedekiAdlar(metin: String, haric: String) -> [String] {
  var adlar: [String] = []
  var i = 0
  let n = metin.len()
  while i < n {
    if adKarakteriMi(karakter(metin, i)) && !rakamMi(karakter(metin, i)) {
      let son = kelimeSonu(metin, i)
      let kelime = metin.slice(i, son)
      if kelime.len() >= 2 && kelime != haric && !adlar.contains(kelime) {
        adlar.push(kelime)
      }
      i = son
    } else {
      i += 1
    }
  }
  return adlar
}

// Eşleşenleri sıralar: baştan eşleşenler önce, sonra içerenler.
fn suz(adaylar: [Oneri], parca: String, sinir: Int) -> [Oneri] {
  var basta: [Oneri] = []
  var icinde: [Oneri] = []
  let kucuk = parca.lowerTr()
  for o in adaylar {
    let ad = o.ad.lowerTr()
    if parca == "" || ad.startsWith(kucuk) {
      basta.push(o)
    } else if ad.contains(kucuk) {
      icinde.push(o)
    }
  }
  var sonuc: [Oneri] = []
  for o in basta {
    if sonuc.len() < sinir {
      sonuc.push(o)
    }
  }
  for o in icinde {
    if sonuc.len() < sinir {
      sonuc.push(o)
    }
  }
  return sonuc
}

fn oneriGuncelle() {
  if let k = kodAlani() {
    let metin = k.deger()
    let konum = k.secimBasi()
    if konum != k.secimSonu() {
      oneriKapat()
      return
    }

    // İmlecin solundaki tanımlayıcı parçası.
    var bas = konum
    while bas > 0 && adKarakteriMi(karakter(metin, bas - 1)) {
      bas -= 1
    }
    let parca = metin.slice(bas, konum)
    let noktadanSonra = bas > 0 && karakter(metin, bas - 1) == "."

    if parca == "" && !noktadanSonra {
      oneriKapat()
      return
    }

    var adaylar: [Oneri] = []
    if noktadanSonra {
      for o in sozluk {
        if o.tur == "metot" {
          adaylar.push(o)
        }
      }
    } else {
      for o in SABLONLAR {
        adaylar.push(o)
      }
      for ad in belgedekiAdlar(metin, parca) {
        adaylar.push(Oneri { ad: ad, metin: ad, tur: "belge" })
      }
      for o in sozluk {
        if o.tur != "metot" {
          adaylar.push(o)
        }
      }
    }

    oneriler = suz(adaylar, parca, 8)
    // Tek öneri zaten yazılanın aynısıysa gösterecek bir şey yok.
    if oneriler.len() == 0 || (oneriler.len() == 1 && oneriler[0].metin == parca) {
      oneriKapat()
      return
    }
    oneriBas = bas
    oneriSon = konum
    oneriSecili = 0
    oneriCiz(parca)
  }
}

fn oneriCiz(parca: String) {
  if let kutu = oneriKutusu() {
    var html = ""
    for (i, o) in oneriler {
      var sinif = "oneri-satir"
      if i == oneriSecili {
        sinif = "oneri-satir secili"
      }
      html += "<div class=\"" + sinif + "\" data-sira=\"${i}\"><span class=\"ad\">" +
        vurgula(o.ad, parca) + "</span><span class=\"tur\">" + o.tur + "</span></div>"
    }
    html += "<div class=\"oneri-ipucu\"><kbd>Tab</kbd> uygula · <kbd>↑↓</kbd> gez · <kbd>Esc</kbd> kapat</div>"
    kutu.htmlYaz(html)

    for satir in bulHepsi(".oneri-satir") {
      let sira = int(satir.ozellik("data-sira") ?? "0") ?? 0
      satir.dinle("mousedown", |o: Olay| {
        o.engelle()          // odak düzenleyicide kalsın
        oneriSecili = sira
        oneriUygula()
      })
    }

    // Kutu imlecin altına gelir. Karakter genişliği JetBrains Mono 13.5px
    // için yaklaşık 8.1px; tam ölçüm gerekmiyor, kutu yalnızca yakın olsun.
    if let k = kodAlani() {
      let yer = satirSutun(k.deger(), oneriBas)
      let ust = 12 + yer[0] * 21 - k.kaydirmaUst()
      let sol = 16 + ((yer[1] - 1) * 81) / 10 - k.kaydirmaSol()
      kutu.stil("top", "${ust}px")
      kutu.stil("left", "${max(0, sol)}px")
    }
    kutu.sinifEkle("acik")
    oneriAcik = true
  }
}

// Eşleşen ön eki kalın gösterir.
fn vurgula(ad: String, parca: String) -> String {
  if parca == "" {
    return kacir(ad)
  }
  let yer = ad.lowerTr().indexOf(parca.lowerTr())
  if yer < 0 {
    return kacir(ad)
  }
  return kacir(ad.slice(0, yer)) + "<b>" + kacir(ad.slice(yer, yer + parca.len())) +
    "</b>" + kacir(ad.slice(yer + parca.len(), ad.len()))
}

fn oneriKapat() {
  if !oneriAcik {
    return
  }
  oneriAcik = false
  if let kutu = oneriKutusu() {
    kutu.sinifSil("acik")
  }
}

fn oneriGez(adim: Int) {
  if oneriler.len() == 0 {
    return
  }
  oneriSecili = (oneriSecili + adim + oneriler.len()) % oneriler.len()
  if let k = kodAlani() {
    oneriCiz(k.deger().slice(oneriBas, oneriSon))
  }
}

// Satırın baştaki boşluğu; şablonun satırları aynı hizada açılsın.
fn satirGirintisi(metin: String, konum: Int) -> String {
  var bas = konum
  while bas > 0 && karakter(metin, bas - 1) != "\n" {
    bas -= 1
  }
  var son = bas
  while son < metin.len() && (karakter(metin, son) == " " || karakter(metin, son) == "\t") {
    son += 1
  }
  return metin.slice(bas, son)
}

fn oneriUygula() {
  if !oneriAcik || oneriler.len() == 0 {
    return
  }
  let o = oneriler[oneriSecili]
  if let k = kodAlani() {
    let metin = k.deger()
    let girinti = satirGirintisi(metin, oneriBas)
    var ekle = o.metin.replace("\n", "\n" + girinti)
    var imlec = ekle.indexOf("|")
    if imlec >= 0 {
      ekle = ekle.slice(0, imlec) + ekle.slice(imlec + 1, ekle.len())
    } else {
      imlec = ekle.len()
    }
    k.degerYaz(metin.slice(0, oneriBas) + ekle + metin.slice(oneriSon, metin.len()))
    let hedef = oneriBas + imlec
    k.secimYap(hedef, hedef)
    oneriKapat()
    ciz()
    esitle()
    imlecBildir()
    denetimPlanla()
  }
}

// --- hata baloncuğu ve düzeltmeler ----------------------------------------
//
// Fare hatalı aralığın üstünde kısa süre durunca mesaj, ipucu ve varsa
// düzeltme düğmeleri çıkar. Düzeltmeler sorunun metninden türetilir;
// derleyici ne dediyse ona göre bir eylem önerilir.

struct Duzeltme {
  etiket: String
  uygula: () -> Void
}

var ipucuSirasi = -1          // baloncuğu açık olan sorun, yoksa -1
var ipucuSayaci = 0           // bekleyen açılışı iptal etmek için
var ipucuUzerinde = false     // fare baloncuğun kendisinde mi

fn ipucuKutusu() -> Element? = bul("#ipucu")

// Fare konumundan satır ve sütun (1 tabanlı). Katmanlar aynı ölçülerle
// yazılır: 21px satır, 8.1px karakter, 12px/16px kenar boşluğu.
fn fareKonumu(o: Olay) -> [Int] {
  if let k = kodAlani() {
    let satir = (o.y() + k.kaydirmaUst() - 12) / 21 + 1
    let sutun = ((o.x() + k.kaydirmaSol() - 16) * 10) / 81 + 1
    return [satir, sutun]
  }
  return [0, 0]
}

fn sorunBul(satir: Int, sutun: Int) -> Int {
  for (i, s) in sorunlar {
    if s.satir == satir && sutun >= s.sutun && sutun <= s.sutun + max(1, s.uzunluk) {
      return i
    }
  }
  return -1
}

// Mesajdaki ilk tırnaklı parça: 'toplam' → toplam.
fn tirnakIci(metin: String) -> String {
  let bas = metin.indexOf("'")
  if bas < 0 {
    return ""
  }
  let kalan = metin.slice(bas + 1, metin.len())
  let son = kalan.indexOf("'")
  if son < 0 {
    return ""
  }
  return kalan.slice(0, son)
}

// İki ad arasındaki düzenleme uzaklığı (Levenshtein).
fn uzaklik(a: String, b: String) -> Int {
  let n = a.len()
  let m = b.len()
  var onceki: [Int] = []
  for j in 0..=m {
    onceki.push(j)
  }
  for i in 1..=n {
    var simdiki: [Int] = [i]
    for j in 1..=m {
      var maliyet = 1
      if karakter(a, i - 1) == karakter(b, j - 1) {
        maliyet = 0
      }
      simdiki.push(min(min(onceki[j] + 1, simdiki[j - 1] + 1), onceki[j - 1] + maliyet))
    }
    onceki = simdiki
  }
  return onceki[m]
}

// Belgede ve sözlükte, verilene en çok benzeyen ad. Yoksa "".
fn enYakinAd(ad: String) -> String {
  var adaylar = belgedekiAdlar(kaynakMetni(), ad)
  for o in sozluk {
    if o.tur != "metot" && !adaylar.contains(o.ad) {
      adaylar.push(o.ad)
    }
  }
  var enIyi = ""
  var enKucuk = 3          // en çok iki düzenleme uzakta olsun
  for aday in adaylar {
    let u = uzaklik(ad.lowerTr(), aday.lowerTr())
    if u < enKucuk && u * 2 <= max(ad.len(), 2) + 1 {
      enKucuk = u
      enIyi = aday
    }
  }
  return enIyi
}

// Satırdaki bir aralığı değiştirir; sütun 1 tabanlı.
fn aralikDegistir(satir: Int, sutun: Int, uzunluk: Int, yeni: String) {
  if let k = kodAlani() {
    let satirlar = k.deger().split("\n")
    if satir < 1 || satir > satirlar.len() {
      return
    }
    let s = satirlar[satir - 1]
    let bas = min(max(0, sutun - 1), s.len())
    let son = min(bas + uzunluk, s.len())
    satirlar[satir - 1] = s.slice(0, bas) + yeni + s.slice(son, s.len())
    k.degerYaz(satirlar.join("\n"))
    duzeltmeSonrasi()
  }
}

fn satiriSil(satir: Int) {
  if let k = kodAlani() {
    let satirlar = k.deger().split("\n")
    var kalan: [String] = []
    for (i, s) in satirlar {
      if i + 1 != satir {
        kalan.push(s)
      }
    }
    k.degerYaz(kalan.join("\n"))
    duzeltmeSonrasi()
  }
}

// Satırda `ad` kelimesinin sütununu bulur (1 tabanlı), yoksa 0.
fn satirdaAdBul(satir: Int, ad: String) -> Int {
  let satirlar = kaynakMetni().split("\n")
  if satir < 1 || satir > satirlar.len() {
    return 0
  }
  let s = satirlar[satir - 1]
  var bas = 0
  while bas <= s.len() {
    let yer = s.slice(bas, s.len()).indexOf(ad)
    if yer < 0 {
      return 0
    }
    let mutlak = bas + yer
    let oncesi = mutlak == 0 || !adKarakteriMi(karakter(s, mutlak - 1))
    let sonrasi = mutlak + ad.len() >= s.len() || !adKarakteriMi(karakter(s, mutlak + ad.len()))
    if oncesi && sonrasi {
      return mutlak + 1
    }
    bas = mutlak + 1
  }
  return 0
}

// `let ad` bildirimini `var ad` yapar.
fn letiVarYap(ad: String) {
  let satirlar = kaynakMetni().split("\n")
  for (i, s) in satirlar {
    let yer = s.indexOf("let ")
    if yer >= 0 && satirdaAdBul(i + 1, ad) == yer + 5 {
      aralikDegistir(i + 1, yer + 1, 3, "var")
      return
    }
  }
}

fn duzeltmeSonrasi() {
  ipucuKapat()
  ciz()
  esitle()
  imlecBildir()
  denetimPlanla()
}

fn duzeltmeler(sira: Int) -> [Duzeltme] {
  var liste: [Duzeltme] = []
  if sira < 0 || sira >= sorunlar.len() {
    return liste
  }
  let s = sorunlar[sira]
  let ad = tirnakIci(s.mesaj)
  let satir = s.satir

  if s.mesaj.contains("hiç kullanılmamış") && ad != "" {
    let sutun = satirdaAdBul(satir, ad)
    if sutun > 0 {
      liste.push(Duzeltme {
        etiket: "_${ad} yap",
        uygula: || { aralikDegistir(satir, sutun, ad.len(), "_" + ad) }
      })
    }
    liste.push(Duzeltme { etiket: "satırı sil", uygula: || { satiriSil(satir) } })
  }

  if s.mesaj.contains("değişmez, değeri değiştirilemez") && ad != "" {
    liste.push(Duzeltme { etiket: "let → var", uygula: || { letiVarYap(ad) } })
  }

  if (s.mesaj.startsWith("tanımsız isim") || s.mesaj.startsWith("tanımsız değişken")) && ad != "" {
    let aday = enYakinAd(ad)
    let sutun = satirdaAdBul(satir, ad)
    if aday != "" && sutun > 0 {
      liste.push(Duzeltme {
        etiket: "${aday} olarak değiştir",
        uygula: || { aralikDegistir(satir, sutun, ad.len(), aday) }
      })
    }
  }
  return liste
}

let DUZELT_IKONU = "<svg class=\"ikon\" viewBox=\"0 0 24 24\" fill=\"none\" " +
  "stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\">" +
  "<path d=\"m5 12.5 4.5 4.5L19 7.5\"/></svg>"

fn duzeltmeDugmeleri(sira: Int, onEk: String) -> String {
  let d = duzeltmeler(sira)
  if d.len() == 0 {
    return ""
  }
  var html = "<div class=\"eylemler\">"
  for (i, x) in d {
    html += "<button type=\"button\" class=\"duzelt\" data-" + onEk + "=\"${sira}\" data-secim=\"${i}\">" +
      DUZELT_IKONU + kacir(x.etiket) + "</button>"
  }
  return html + "</div>"
}

fn duzeltDugmeleriniBagla(secici: String, onEk: String) {
  for b in bulHepsi(secici) {
    let sira = int(b.ozellik("data-" + onEk) ?? "-1") ?? -1
    let secim = int(b.ozellik("data-secim") ?? "0") ?? 0
    b.dinle("mousedown", |o: Olay| {
      o.engelle()
      o.durdur()
      let d = duzeltmeler(sira)
      if secim < d.len() {
        d[secim].uygula()
      }
    })
    b.dinle("click", |o: Olay| { o.durdur() })
  }
}

fn ipucuGoster(sira: Int) {
  if sira < 0 || sira >= sorunlar.len() {
    return
  }
  if let kutu = ipucuKutusu() {
    let s = sorunlar[sira]
    var seviyeAdi = "hata"
    if s.seviye == "uyari" {
      seviyeAdi = "uyarı"
    }
    var html = "<div class=\"ipucu-baslik\">" + seviyeAdi + " · satır ${s.satir}</div>" +
      "<div class=\"ipucu-mesaj\">" + kacir(s.mesaj) + "</div>"
    if s.ipucu != "" {
      html += "<div class=\"ipucu-oneri\"><b>ipucu:</b> " + kacir(s.ipucu) + "</div>"
    }
    html += duzeltmeDugmeleri(sira, "baloncuk")
    kutu.htmlYaz(html)
    kutu.ozellikYaz("class", "ipucu acik " + s.seviye)

    if let k = kodAlani() {
      let ust = 12 + s.satir * 21 - k.kaydirmaUst() + 2
      let sol = 16 + ((s.sutun - 1) * 81) / 10 - k.kaydirmaSol()
      kutu.stil("top", "${ust}px")
      kutu.stil("left", "${max(0, sol)}px")
    }
    ipucuSirasi = sira
    duzeltDugmeleriniBagla("#ipucu .duzelt", "baloncuk")
  }
}

fn ipucuKapat() {
  ipucuSayaci += 1
  if ipucuSirasi < 0 {
    return
  }
  ipucuSirasi = -1
  ipucuUzerinde = false
  if let kutu = ipucuKutusu() {
    kutu.ozellikYaz("class", "ipucu")
  }
}

fn fareHareket(o: Olay) {
  let yer = fareKonumu(o)
  let sira = sorunBul(yer[0], yer[1])
  if sira >= 0 && sira == ipucuSirasi {
    return
  }
  if sira < 0 {
    // Baloncuk açıkken fare dışarı kaydıysa küçük bir pay bırak: kullanıcı
    // düğmeye gidiyor olabilir.
    if ipucuSirasi >= 0 {
      ipucuSayaci += 1
      let benim = ipucuSayaci
      zamanla(350, || {
        if benim == ipucuSayaci && !ipucuUzerinde {
          ipucuKapat()
        }
      })
    }
    return
  }
  ipucuSayaci += 1
  let benim = ipucuSayaci
  zamanla(250, || {
    if benim == ipucuSayaci {
      ipucuGoster(sira)
    }
  })
}

// --- anahat ---------------------------------------------------------------
//
// Dosyadaki üst düzey tanımlar: `fn`, `struct`, `enum` ve modül
// değişkenleri. Girintili satırlara bakılmaz — iç fonksiyon ya da
// blok içindeki `let` anahat değildir.

struct Sembol {
  var tur: String
  var ad: String
  var satir: Int
}

let SEMBOL_ANAHTARLARI = ["fn", "struct", "enum", "let", "var", "import"]

// Anahtar kelimeden sonraki adı okur: "fn topla(a: Int)" -> "topla".
fn tanimAdi(satir: String, anahtar: String) -> String {
  let kalan = satir.slice(anahtar.len() + 1, satir.len()).trim()
  var ad = ""
  for h in kalan.split("") {
    // Ad harf, rakam, alt çizgi ve Türkçe harflerden oluşur; ilk
    // ayraçta (boşluk, parantez, iki nokta) biter.
    if h == " " || h == "(" || h == ":" || h == "=" || h == "<" || h == "{" {
      return ad
    }
    ad += h
  }
  return ad
}

fn anahatCikar(kaynak: String) -> [Sembol] {
  var sonuc: [Sembol] = []
  for (i, satir) in kaynak.split("\n") {
    // Girintili satır üst düzey tanım değildir.
    if satir.startsWith(" ") || satir.startsWith("\t") {
      continue
    }
    for anahtar in SEMBOL_ANAHTARLARI {
      if satir.startsWith(anahtar + " ") {
        let ad = tanimAdi(satir, anahtar)
        if ad != "" {
          sonuc.push(Sembol { tur: anahtar, ad: ad, satir: i + 1 })
        }
      }
    }
  }
  return sonuc
}

var anahatKaynagi = "@yok"
var anahat: [Sembol] = []

fn anahatGuncelle() {
  let kaynak = kaynakMetni()
  // Her tuş vuruşunda listeyi yeniden kurmak israf; kaynak değişmediyse
  // eldeki durur.
  if kaynak == anahatKaynagi {
    return
  }
  anahatKaynagi = kaynak
  anahat = anahatCikar(kaynak)
  anahatCiz()
}

fn anahatCiz() {
  if let alan = bul("#anahat") {
    if anahat.len() == 0 {
      alan.htmlYaz("<div class=\"anahat-bos\">tanım yok</div>")
    } else {
      var html = ""
      for (i, s) in anahat {
        html += "<div class=\"anahat-satir\" data-sira=\"" + str(i) +
          "\" title=\"satır " + str(s.satir) + "\">" +
          "<span class=\"tur\">" + kacir(s.tur) + "</span>" +
          "<span class=\"ad\">" + kacir(s.ad) + "</span>" +
          "<span class=\"no\">" + str(s.satir) + "</span></div>"
      }
      alan.htmlYaz(html)
      for oge in alan.bulHepsi(".anahat-satir") {
        oge.dinle("click", || {
          let sira = int(oge.ozellik("data-sira") ?? "0") ?? 0
          if sira < anahat.len() {
            satirGit(anahat[sira].satir)
          }
        })
      }
    }
  }
  if let rozet = bul("#anahat-sayisi") {
    rozet.metinYaz(str(anahat.len()))
  }
}

// --- ara ve değiştir ------------------------------------------------------

var bulAcik = false
var bulKonumlari: [Int] = []
var bulSirasi = 0

fn bulSeridi() -> Element? = bul("#bul")
fn bulGirisi() -> Element? = bul("#bul-giris")
fn degistirGirisi() -> Element? = bul("#degistir-giris")

// Bir metindeki bütün eşleşmelerin başlangıç konumları. Arama büyük-küçük
// harfe bakmaz; Türkçe'de "İ" ile "i" aynı sayılsın diye `lowerTr`.
fn tumKonumlar(metin: String, aranan: String) -> [Int] {
  var sonuc: [Int] = []
  if aranan == "" {
    return sonuc
  }
  let alt = metin.lowerTr()
  let ara = aranan.lowerTr()
  var bas = 0
  var devam = true
  while devam {
    let kalan = alt.slice(bas, alt.len())
    let i = kalan.indexOf(ara)
    if i < 0 {
      devam = false
    } else {
      sonuc.push(bas + i)
      bas = bas + i + ara.len()
      if bas >= alt.len() {
        devam = false
      }
    }
  }
  return sonuc
}

fn bulSayacYaz() {
  if let sayac = bul("#bul-sayac") {
    if bulKonumlari.len() == 0 {
      sayac.metinYaz("eşleşme yok")
    } else {
      sayac.metinYaz(str(bulSirasi + 1) + " / " + str(bulKonumlari.len()))
    }
  }
}

fn bulGuncelle() {
  var aranan = ""
  if let g = bulGirisi() {
    aranan = g.deger()
  }
  bulKonumlari = tumKonumlar(kaynakMetni(), aranan)
  if bulSirasi >= bulKonumlari.len() {
    bulSirasi = 0
  }
  bulSayacYaz()
}

// Bulunan eşleşmeyi seçer ve görünür hâle getirir.
fn bulGoster() {
  if bulKonumlari.len() == 0 {
    return
  }
  var aranan = ""
  if let g = bulGirisi() {
    aranan = g.deger()
  }
  if let k = kodAlani() {
    let bas = bulKonumlari[bulSirasi]
    k.odaklan()
    k.secimYap(bas, bas + aranan.len())
    let yer = satirSutun(kaynakMetni(), bas)
    k.kaydirmaUstYaz(max(0, (yer[0] - 6) * 21))
    esitle()
    imlecBildir()
  }
  bulSayacYaz()
}

fn bulGez(yon: Int) {
  bulGuncelle()
  if bulKonumlari.len() == 0 {
    return
  }
  bulSirasi = (bulSirasi + yon + bulKonumlari.len()) % bulKonumlari.len()
  bulGoster()
}

fn bulAc(degistirmeliMi: Bool) {
  bulAcik = true
  if let s = bulSeridi() {
    s.sinifEkle("acik")
  }
  if let g = bulGirisi() {
    // Seçili metin varsa arama kutusuna onu koy: en sık istenen şey bu.
    if let k = kodAlani() {
      let bas = k.secimBasi()
      let son = k.secimSonu()
      if son > bas {
        g.degerYaz(kaynakMetni().slice(bas, son))
      }
    }
    g.odaklan()
  }
  if degistirmeliMi {
    if let d = degistirGirisi() {
      d.odaklan()
    }
  }
  bulGuncelle()
}

fn bulKapat() {
  bulAcik = false
  if let s = bulSeridi() {
    s.sinifSil("acik")
  }
  if let k = kodAlani() {
    k.odaklan()
  }
}

fn degistirBir() {
  bulGuncelle()
  if bulKonumlari.len() == 0 {
    return
  }
  var aranan = ""
  var yenisi = ""
  if let g = bulGirisi() {
    aranan = g.deger()
  }
  if let d = degistirGirisi() {
    yenisi = d.deger()
  }
  if let k = kodAlani() {
    let metin = k.deger()
    let bas = bulKonumlari[bulSirasi]
    k.degerYaz(metin.slice(0, bas) + yenisi +
               metin.slice(bas + aranan.len(), metin.len()))
    k.secimYap(bas + yenisi.len(), bas + yenisi.len())
    ciz()
    esitle()
    denetimPlanla()
  }
  bulGuncelle()
  bulGoster()
  durumYaz("bir eşleşme değiştirildi", false)
}

fn degistirHepsi() {
  var aranan = ""
  var yenisi = ""
  if let g = bulGirisi() {
    aranan = g.deger()
  }
  if let d = degistirGirisi() {
    yenisi = d.deger()
  }
  if aranan == "" {
    return
  }
  if let k = kodAlani() {
    let metin = k.deger()
    let konumlar = tumKonumlar(metin, aranan)
    if konumlar.len() == 0 {
      durumYaz("eşleşme yok", false)
      return
    }
    // Sondan başa gidilir; baştan değiştirmek sonraki konumları kaydırır.
    var sonuc = metin
    var i = konumlar.len() - 1
    while i >= 0 {
      let bas = konumlar[i]
      sonuc = sonuc.slice(0, bas) + yenisi +
        sonuc.slice(bas + aranan.len(), sonuc.len())
      i -= 1
    }
    k.degerYaz(sonuc)
    ciz()
    esitle()
    denetimPlanla()
    durumYaz(str(konumlar.len()) + " eşleşme değiştirildi", false)
  }
  bulGuncelle()
}

// --- komut paleti ---------------------------------------------------------
//
// Tek giriş noktası: dosya aç, tanıma git, satıra atla ya da komut çalıştır.
// Baştaki işaret ne arandığını söyler:
//     >ara   komutlar
//     @ad    dosyadaki tanımlar
//     :42    satır
//     ad     dosyalar ve komutlar birlikte

struct PaletOgesi {
  var tur: String
  var ad: String
  var yan: String
  var calistir: () -> Void
}

var paletAcik = false
var paletSecili = 0
var paletListesi: [PaletOgesi] = []

fn paletPerdesi() -> Element? = bul("#palet-perde")
fn paletGirisi() -> Element? = bul("#palet-giris")

fn komutlar() -> [PaletOgesi] = [
  PaletOgesi { tur: "komut", ad: "Çalıştır", yan: "Ctrl+Enter",
  calistir: || { calistir() } },
PaletOgesi { tur: "komut", ad: "Kaydet", yan: "Ctrl+S",
  calistir: || { kaydet() } },
PaletOgesi { tur: "komut", ad: "Kodu düzenle", yan: "Ctrl+Shift+D",
  calistir: || { kodDuzenle() } },
PaletOgesi { tur: "komut", ad: "Tip denetimi", yan: "",
  calistir: || { denetle() } },
PaletOgesi { tur: "komut", ad: "Üretilen JavaScript", yan: "",
  calistir: || { javascriptGoster() } },
PaletOgesi { tur: "komut", ad: "Yeni dosya", yan: "",
  calistir: || { yeniDosya() } },
PaletOgesi { tur: "komut", ad: "Ara ve değiştir", yan: "Ctrl+F",
  calistir: || { bulAc(false) } },
PaletOgesi { tur: "komut", ad: "Dosya ağacını göster/gizle", yan: "Ctrl+B",
  calistir: || { agaciAcKapa() } },
PaletOgesi { tur: "komut", ad: "Sorunlar paneli", yan: "",
  calistir: || { sekmeSec("pano-sorunlar") } },
PaletOgesi { tur: "komut", ad: "Çıktı paneli", yan: "",
  calistir: || { sekmeSec("pano-cikti") } },
PaletOgesi { tur: "komut", ad: "Ekran paneli", yan: "",
  calistir: || { sekmeSec("pano-ekran") } },
PaletOgesi { tur: "komut", ad: "Temayı değiştir", yan: "",
  calistir: || { temayiDegistir() } }
]

fn dosyaOgeleri() -> [PaletOgesi] {
  var sonuc: [PaletOgesi] = []
  for yol in dosyaYollari {
    let parcalar = yol.split("/")
    let ad = parcalar[parcalar.len() - 1]
    sonuc.push(PaletOgesi { tur: "dosya", ad: ad, yan: yol,
      calistir: || { dosyaAc(yol) } })
  }
  return sonuc
}

fn tanimOgeleri() -> [PaletOgesi] {
  anahatGuncelle()
  var sonuc: [PaletOgesi] = []
  for s in anahat {
    let satir = s.satir
    sonuc.push(PaletOgesi { tur: s.tur, ad: s.ad, yan: "satır " + str(satir),
      calistir: || { satirGit(satir) } })
  }
  return sonuc
}

// Aramada "cal" yazan "Çalıştır"ı bulabilmeli: Türkçe harfler ASCII
// karşılıklarına indirgenir. Yalnız palet araması için — ara/değiştir
// yazılanı olduğu gibi arar.
fn sadelestir(metin: String) -> String {
  var s = metin.lowerTr()
  s = s.replace("ç", "c")
  s = s.replace("ğ", "g")
  s = s.replace("ı", "i")
  s = s.replace("ö", "o")
  s = s.replace("ş", "s")
  s = s.replace("ü", "u")
  s = s.replace("â", "a")
  s = s.replace("î", "i")
  s = s.replace("û", "u")
  return s
}

// Aranan harflerin hepsi sırayla geçiyorsa eşleşir: "gspn" -> "gostergePaneli".
fn harfleriIceriyorMu(ad: String, aranan: String) -> Bool {
  if aranan == "" {
    return true
  }
  let a = sadelestir(ad)
  let b = sadelestir(aranan)
  var i = 0
  for h in b.split("") {
    let kalan = a.slice(i, a.len())
    let yer = kalan.indexOf(h)
    if yer < 0 {
      return false
    }
    i = i + yer + 1
  }
  return true
}

fn paletSuz(sorgu: String) -> [PaletOgesi] {
  var havuz: [PaletOgesi] = []
  var ara = sorgu
  if sorgu.startsWith(">") {
    havuz = komutlar()
    ara = sorgu.slice(1, sorgu.len()).trim()
  } else {
    if sorgu.startsWith("@") {
      havuz = tanimOgeleri()
      ara = sorgu.slice(1, sorgu.len()).trim()
    } else {
      if sorgu.startsWith(":") {
        let no = int(sorgu.slice(1, sorgu.len()).trim()) ?? 0
        if no > 0 {
          return [PaletOgesi { tur: "satır", ad: "Satır " + str(no) + "'e git",
            yan: "", calistir: || { satirGit(no) } }]
        }
        return []
      }
      // İşaretsiz arama: önce dosyalar, sonra tanımlar, sonra komutlar.
      for o in dosyaOgeleri() {
        havuz.push(o)
      }
      for o in tanimOgeleri() {
        havuz.push(o)
      }
      for o in komutlar() {
        havuz.push(o)
      }
    }
  }

  var sonuc: [PaletOgesi] = []
  for o in havuz {
    if harfleriIceriyorMu(o.ad, ara) {
      sonuc.push(o)
    }
  }
  return sonuc
}

fn paletCiz() {
  if let liste = bul("#palet-liste") {
    if paletListesi.len() == 0 {
      liste.htmlYaz("<div class=\"palet-bos\">eşleşen bir şey yok</div>")
      return
    }
    var html = ""
    for (i, o) in paletListesi {
      var sinif = "palet-satir"
      if i == paletSecili {
        sinif += " secili"
      }
      html += "<div class=\"" + sinif + "\" data-sira=\"" + str(i) + "\">" +
        "<span class=\"tur\">" + kacir(o.tur) + "</span>" +
        "<span class=\"ad\">" + kacir(o.ad) + "</span>" +
        "<span class=\"yan\">" + kacir(o.yan) + "</span></div>"
    }
    liste.htmlYaz(html)
    for oge in liste.bulHepsi(".palet-satir") {
      // `mousedown`: tıklama giriş kutusundan odağı almadan işlensin.
      oge.dinle("mousedown", |o: Olay| {
        o.engelle()
        let sira = int(oge.ozellik("data-sira") ?? "0") ?? 0
        paletUygula(sira)
      })
    }
  }
}

fn paletGuncelle() {
  var sorgu = ""
  if let g = paletGirisi() {
    sorgu = g.deger()
  }
  paletListesi = paletSuz(sorgu)
  if paletSecili >= paletListesi.len() {
    paletSecili = 0
  }
  paletCiz()
}

fn paletUygula(sira: Int) {
  if sira < 0 || sira >= paletListesi.len() {
    return
  }
  let oge = paletListesi[sira]
  paletKapat()
  oge.calistir()
}

fn paletAc(onEk: String) {
  paletAcik = true
  paletSecili = 0
  if let p = paletPerdesi() {
    p.sinifEkle("acik")
  }
  if let g = paletGirisi() {
    g.degerYaz(onEk)
    g.odaklan()
  }
  paletGuncelle()
}

fn paletKapat() {
  paletAcik = false
  if let p = paletPerdesi() {
    p.sinifSil("acik")
  }
  if let k = kodAlani() {
    k.odaklan()
  }
}

fn paletGez(yon: Int) {
  if paletListesi.len() == 0 {
    return
  }
  paletSecili = (paletSecili + yon + paletListesi.len()) % paletListesi.len()
  paletCiz()
  // Seçili satır listenin dışına çıkmışsa göster.
  if let liste = bul("#palet-liste") {
    liste.kaydirmaUstYaz(max(0, (paletSecili - 6) * 32))
  }
}

// Tema kökteki `data-tema` ile seçilir; sayfadaki küçük betik değişimi
// görüp tercihi saklar.
fn temayiDegistir() {
  if let kok = bul("html") {
    let simdi = kok.ozellik("data-tema") ?? ""
    kok.ozellikYaz("data-tema", if simdi == "koyu" { "acik" } else { "koyu" })
  }
}

// --- klavye ---------------------------------------------------------------

fn tusaBasildi(o: Olay) {
  let tus = o.tus()

  if oneriAcik {
    if tus == "Tab" || tus == "Enter" {
      o.engelle()
      oneriUygula()
      return
    }
    if tus == "ArrowDown" {
      o.engelle()
      oneriGez(1)
      return
    }
    if tus == "ArrowUp" {
      o.engelle()
      oneriGez(-1)
      return
    }
    if tus == "Escape" {
      o.engelle()
      oneriKapat()
      return
    }
  }

  if o.ctrl() && tus == "Enter" {
    o.engelle()
    calistir()
    return
  }
  if o.ctrl() && (tus == "k" || tus == "K") {
    o.engelle()
    paletAc("")
    return
  }
  if o.ctrl() && o.shift() && (tus == "p" || tus == "P") {
    o.engelle()
    paletAc(">")
    return
  }
  if o.ctrl() && !o.shift() && (tus == "f" || tus == "F") {
    o.engelle()
    bulAc(false)
    return
  }
  if o.ctrl() && !o.shift() && (tus == "h" || tus == "H") {
    o.engelle()
    bulAc(true)
    return
  }
  if o.ctrl() && !o.shift() && (tus == "g" || tus == "G") {
    o.engelle()
    paletAc(":")
    return
  }
  if tus == "Escape" && bulAcik {
    o.engelle()
    bulKapat()
    return
  }
  if o.ctrl() && !o.shift() && (tus == "s" || tus == "S") {
    o.engelle()
    kaydet()
    return
  }
  if o.ctrl() && !o.shift() && (tus == "b" || tus == "B") {
    o.engelle()
    agaciAcKapa()
    return
  }
  if o.ctrl() && o.shift() && (tus == "d" || tus == "D") {
    o.engelle()
    kodDuzenle()
    return
  }
  if tus == "Tab" {
    o.engelle()
    if let k = kodAlani() {
      k.yaziEkle("  ")
      ciz()
    }
    return
  }
  if tus == "Enter" {
    if let k = kodAlani() {
      let metin = k.deger()
      let konum = k.secimBasi()
      let oncesi = metin.slice(0, konum)
      let girinti = sonrakiGirinti(sonSatir(oncesi))
      if girinti.len() > 0 {
        o.engelle()
        k.yaziEkle("\n" + girinti)
        ciz()
        esitle()
        imlecBildir()
      }
    }
  }
}

// Bir metnin son satırını verir (imlecin bulunduğu satır).
fn sonSatir(metin: String) -> String {
  let parcalar = metin.split("\n")
  if parcalar.len() == 0 {
    return ""
  }
  return parcalar[parcalar.len() - 1]
}

// --- başlatma -------------------------------------------------------------

fn baslat() {
  let kodOgesi = kodAlani()
  if kodOgesi == none {
    print("IDE: #kod alanı bulunamadı")
    return
  }
  let kod = kodOgesi!

  kod.dinle("input", || {
    ciz()
    esitle()
    oneriGuncelle()
    ipucuKapat()
    denetimPlanla()
  })
  kod.dinle("scroll", || {
    esitle()
    oneriKapat()
    ipucuKapat()
  })
  kod.dinle("click", || {
    imlecBildir()
    oneriKapat()
  })
  kod.dinle("blur", || { oneriKapat() })
  kod.dinle("mousemove", |o: Olay| { fareHareket(o) })
  kod.dinle("mouseleave", || {
    ipucuSayaci += 1
    let benim = ipucuSayaci
    zamanla(350, || {
      if benim == ipucuSayaci && !ipucuUzerinde {
        ipucuKapat()
      }
    })
  })
  if let kutu = ipucuKutusu() {
    kutu.dinle("mouseenter", || { ipucuUzerinde = true })
    kutu.dinle("mouseleave", || {
      ipucuUzerinde = false
      ipucuKapat()
    })
  }
  kod.dinle("keyup", || { imlecBildir() })
  kod.dinle("keydown", |o: Olay| { tusaBasildi(o) })

  dugmeyeBagla("#btn-calistir", || { calistir() })
  dugmeyeBagla("#btn-kaydet", || { kaydet() })
  dugmeyeBagla("#btn-bicim", || { kodDuzenle() })
  dugmeyeBagla("#btn-js", || { javascriptGoster() })
  dugmeyeBagla("#btn-denetle", || {
    sekmeSec("pano-sorunlar")
    denetle()
  })
  dugmeyeBagla("#btn-yeni", || { yeniDosya() })
  dugmeyeBagla("#btn-agac", || { agaciAcKapa() })

  for d in bulHepsi(".sekme") {
    let pano = d.ozellik("data-pano") ?? "pano-cikti"
    d.dinle("click", || { sekmeSec(pano) })
  }

  // Sayfa genelinde de kısayollar çalışsın (odak düzenleyicide değilken).
  govde().dinle("keydown", |o: Olay| {
    if o.ctrl() && !o.shift() && (o.tus() == "b" || o.tus() == "B") {
      o.engelle()
      agaciAcKapa()
    }
    // Palet her yerden açılmalı: odak düzenleyicide olmayabilir.
    if o.ctrl() && (o.tus() == "k" || o.tus() == "K") && !paletAcik {
      o.engelle()
      paletAc("")
    }
  })

  if let motor = motorYazisi() {
    motor.metinYaz("araçlar: Nar ile yazıldı")
  }
  if let durumOgesi = durumYazisi() {
    durumOgesi.dinle("click", || {
      if sorunlar.len() > 0 {
        sekmeSec("pano-sorunlar")
        satirGit(sorunlar[0].satir)
      }
    })
  }

  // Komut paleti: kutuda yazıldıkça liste süzülür, oklarla gezilir.
  if let g = paletGirisi() {
    g.dinle("input", || { paletGuncelle() })
    g.dinle("keydown", |o: Olay| {
      let tus = o.tus()
      if tus == "ArrowDown" {
        o.engelle()
        paletGez(1)
      }
      if tus == "ArrowUp" {
        o.engelle()
        paletGez(-1)
      }
      if tus == "Enter" {
        o.engelle()
        paletUygula(paletSecili)
      }
      if tus == "Escape" {
        o.engelle()
        paletKapat()
      }
    })
  }
  if let p = paletPerdesi() {
    // Perdeye tıklamak kapatır; kutunun içine tıklamak kapatmaz.
    p.dinle("mousedown", |o: Olay| {
      if let kaynak = o.kaynak() {
        if kaynak.sinifVarMi("palet-perde") {
          paletKapat()
        }
      }
    })
  }

  // Ara ve değiştir
  if let g = bulGirisi() {
    g.dinle("input", || { bulGuncelle() })
    g.dinle("keydown", |o: Olay| {
      if o.tus() == "Enter" {
        o.engelle()
        bulGez(if o.shift() { -1 } else { 1 })
      }
      if o.tus() == "Escape" {
        o.engelle()
        bulKapat()
      }
    })
  }
  if let d = degistirGirisi() {
    d.dinle("keydown", |o: Olay| {
      if o.tus() == "Enter" {
        o.engelle()
        degistirBir()
      }
      if o.tus() == "Escape" {
        o.engelle()
        bulKapat()
      }
    })
  }
  dugmeyeBagla("#bul-sonraki", || { bulGez(1) })
  dugmeyeBagla("#bul-onceki", || { bulGez(-1) })
  dugmeyeBagla("#btn-degistir", || { degistirBir() })
  dugmeyeBagla("#btn-degistir-hepsi", || { degistirHepsi() })
  dugmeyeBagla("#bul-kapat", || { bulKapat() })

  sekmeSec("pano-cikti")
  sozlugYukle()
  dosyalariYukle()
  anahatGuncelle()
}

// Kaydedilmemiş değişiklik var mı? Sayfa kapanırken sorulması için.
fn degistiMi() -> Bool = kaynakMetni() != kaydedilmis

fn dugmeyeBagla(secici: String, islev: () -> Void) {
  if let d = bul(secici) {
    d.dinle("click", islev)
  }
}
