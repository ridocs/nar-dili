// Simgenin SVG metnini verir; tanınmayan ad boş döner, sayfa yine çizilir.
fn simgeKodu(ad: String) -> String {
  if let ic = SIMGELER.get(ad) {
    return SIMGE_BASI + ic + "</svg>"
  }
  return ""
}

fn simgeOgesi(ad: String) -> Element {
  let e = sinifliOge("span", "nar-simge")
  // Adı öznitelikte durur: yanlış yazılan bir simge boş görünür, ama
  // ayıklarken hangisinin aranmış olduğu bellidir.
  e.ozellikYaz("data-simge", ad)
  e.htmlYaz(simgeKodu(ad))
  return e
}

fn ikonDugmesi(simge: String, etiket: String, islev: () -> Void) -> Element {
  let e = odaklanabilirIsaretle(sinifliOge("button", "nar-ikon-dugme"))
  e.ozellikYaz("type", "button")
  // Görünen yazısı yok; adı ekran okuyucuya ve ipucuna kalıyor.
  e.ozellikYaz("aria-label", etiket)
  e.ozellikYaz("title", etiket)
  e.ekle(simgeOgesi(simge))
  e.dinle("click", islev)
  return e
}

// --- yazı bileşenleri -----------------------------------------------------

fn alintiOgesi(soz: String, kaynak: String) -> Element {
  let e = sinifliOge("blockquote", "nar-alinti")
  e.ekle(yaziOgesi("p", "nar-alinti-metin", soz))
  if kaynak != "" {
    e.ekle(yaziOgesi("footer", "nar-alinti-kaynak", kaynak))
  }
  return e
}

fn kodOgesi(kod: String) -> Element {
  let e = sinifliOge("pre", "nar-kod")
  let ic = olustur("code")
  // Metin olarak yazılır: kod içindeki `<` işareti etiket sanılmasın.
  ic.metinYaz(kod)
  e.ekle(ic)
  return e
}

// --- girdi bileşenleri ----------------------------------------------------

// Radyo düğmeleri aynı `name` ile gruplanır; her grup kendi adını alır.
var RADYO_SAYACI = 0

fn anahtarOgesi(etiket: String, acik: Bool,
                degisince: (Bool) -> Void) -> Element {
  let e = sinifliOge("label", "nar-anahtar")
  let kutu = odaklanabilirIsaretle(olustur("input"))
  kutu.ozellikYaz("type", "checkbox")
  kutu.isaretliYaz(acik)
  // Yuva CSS'te `input:checked + .nar-anahtar-yuva` ile boyanıyor;
  // bu yüzden hemen girdinin ardından gelmeli.
  e.ekle(kutu)
  e.ekle(sinifliOge("span", "nar-anahtar-yuva"))
  if etiket != "" {
    e.ekle(yaziOgesi("span", "", etiket))
  }
  kutu.dinle("change", || {
    degisince(kutu.isaretli())
  })
  return e
}

fn radyoOgesi(secenekler: [String], secili: String,
              degisince: (String) -> Void) -> Element {
  RADYO_SAYACI += 1
  let grup = "nar-radyo-${RADYO_SAYACI}"
  let e = sinifliOge("div", "nar-radyo")
  e.ozellikYaz("role", "radiogroup")
  for s in secenekler {
    let satir = sinifliOge("label", "nar-radyo-oge")
    let d = odaklanabilirIsaretle(olustur("input"))
    d.ozellikYaz("type", "radio")
    d.ozellikYaz("name", grup)
    d.ozellikYaz("value", s)
    d.isaretliYaz(s == secili)
    d.dinle("change", || {
      degisince(s)
    })
    satir.ekle(d)
    satir.ekle(yaziOgesi("span", "", s))
    e.ekle(satir)
  }
  return e
}

fn kaydiriciOgesi(enAz: Int, enCok: Int, deger: Int,
                  degisince: (Int) -> Void) -> Element {
  let e = sinifliOge("div", "nar-kaydirici")
  let d = odaklanabilirIsaretle(olustur("input"))
  d.ozellikYaz("type", "range")
  d.ozellikYaz("min", str(enAz))
  d.ozellikYaz("max", str(enCok))
  d.degerYaz(str(deger))
  let sayi = yaziOgesi("span", "nar-kaydirici-deger", str(deger))
  d.dinle("input", || {
    // Sayı anında güncellenir; durum yenilenmesini beklemek kaydırmayı
    // takılıyor gibi gösteriyordu.
    sayi.metinYaz(d.deger())
    degisince(int(d.deger()) ?? deger)
  })
  e.ekle(d)
  e.ekle(sayi)
  return e
}

fn alanOgesi(etiket: String, ipucu: String, ic: Gorunum,
             hatali: Bool) -> Element {
  let e = sinifliOge("div", "nar-alan")
  if hatali {
    e.sinifEkle("nar-alan-hatali")
  }
  if etiket != "" {
    e.ekle(yaziOgesi("label", "nar-alan-etiket", etiket))
  }
  e.ekle(ogeYap(ic))
  if ipucu != "" {
    e.ekle(yaziOgesi("p", "nar-alan-ipucu", ipucu))
  }
  return e
}

// --- yerleşim bileşenleri -------------------------------------------------

fn izgaraOgesi(sutun: Int, cocuklar: [Gorunum]) -> Element {
  let e = sinifliOge("div", "nar-izgara")
  // En az bir sütun: 0 verilirse tarayıcı hiçbir şey çizmezdi.
  let n = if sutun < 1 { 1 } else { sutun }
  e.stil("--nar-sutun", str(n))
  for c in cocuklar {
    e.ekle(ogeYap(c))
  }
  return e
}

fn genislikOgesi(px: Int, ic: Gorunum) -> Element {
  let e = sinifliOge("div", "nar-en")
  e.stil("--nar-en", "${px}px")
  e.ekle(ogeYap(ic))
  return e
}

fn ayracOgesi(etiket: String) -> Element {
  let e = sinifliOge("div", "nar-ayrac")
  if etiket != "" {
    e.ekle(yaziOgesi("span", "", etiket))
  }
  return e
}

// --- gösterim bileşenleri -------------------------------------------------

// Resim yoksa addan baş harfler çıkarılır: "Ayşe Yılmaz" -> "AY".
fn basHarfler(ad: String) -> String {
  var sonuc = ""
  for parca in ad.trim().split(" ") {
    if parca != "" && sonuc.len() < 2 {
      sonuc += parca.charAt(0).upperTr()
    }
  }
  if sonuc == "" {
    return "?"
  }
  return sonuc
}

fn avatarOgesi(ad: String, adres: String) -> Element {
  let e = sinifliOge("span", "nar-avatar")
  e.ozellikYaz("title", ad)
  if adres != "" {
    let resim = olustur("img")
    resim.ozellikYaz("src", adres)
    resim.ozellikYaz("alt", ad)
    e.ekle(resim)
  } else {
    e.metinYaz(basHarfler(ad))
    e.ozellikYaz("aria-label", ad)
  }
  return e
}

// Değişim metni kendi yönünü söyler: başında "+" varsa iyi, "-" varsa kötü.
fn degisimSinifi(degisim: String) -> String {
  if degisim.startsWith("+") {
    return "nar-degisim-arti"
  }
  if degisim.startsWith("-") {
    return "nar-degisim-eksi"
  }
  return "nar-degisim-notr"
}

fn istatistikOgesi(baslik: String, deger: String,
                   degisim: String) -> Element {
  let e = sinifliOge("div", "nar-istatistik")
  e.ekle(yaziOgesi("p", "nar-istatistik-baslik", baslik))
  e.ekle(yaziOgesi("p", "nar-istatistik-deger", deger))
  if degisim != "" {
    let alt = sinifliOge("p", "nar-istatistik-degisim " + degisimSinifi(degisim))
    if degisim.startsWith("+") {
      alt.ekle(simgeOgesi("ok-yukari"))
    }
    if degisim.startsWith("-") {
      alt.ekle(simgeOgesi("ok-asagi"))
    }
    alt.ekle(yaziOgesi("span", "", degisim))
    e.ekle(alt)
  }
  return e
}

fn cubukOgesi(degerler: [Int], etiketler: [String]) -> Element {
  let e = sinifliOge("div", "nar-cubuklar")
  // Ölçek en büyük değere göre; hepsi sıfırsa çubuklar dipte kalır.
  var enBuyuk = 1
  for d in degerler {
    if d > enBuyuk {
      enBuyuk = d
    }
  }
  for (i, d) in degerler {
    let sutun = sinifliOge("div", "nar-cubuk-sutun")
    let alan = sinifliOge("div", "nar-cubuk-alan")
    let cubuk = sinifliOge("div", "nar-cubuk")
    let yuzde = d * 100 / enBuyuk
    cubuk.stil("height", "${yuzde}%")
    cubuk.ozellikYaz("title", str(d))
    alan.ekle(cubuk)
    sutun.ekle(alan)
    if i < etiketler.len() {
      sutun.ekle(yaziOgesi("span", "nar-cubuk-etiket", etiketler[i]))
    }
    e.ekle(sutun)
  }
  return e
}

fn adimOgesi(adlar: [String], simdi: Int) -> Element {
  let e = sinifliOge("div", "nar-adimlar")
  for (i, ad) in adlar {
    var sinif = "nar-adim"
    if i < simdi {
      sinif += " nar-adim-bitti"
    }
    if i == simdi {
      sinif += " nar-adim-simdi"
    }
    let adim = sinifliOge("div", sinif)
    let yuvarlak = sinifliOge("div", "nar-adim-yuvarlak")
    if i < simdi {
      yuvarlak.ekle(simgeOgesi("onay"))
    } else {
      yuvarlak.metinYaz(str(i + 1))
    }
    adim.ekle(yuvarlak)
    adim.ekle(yaziOgesi("div", "nar-adim-yazi", ad))
    e.ekle(adim)
  }
  return e
}

fn bosDurumOgesi(simge: String, baslik: String, aciklama: String,
                 eylem: Gorunum) -> Element {
  let e = sinifliOge("div", "nar-bos-durum")
  if simge != "" {
    e.ekle(simgeOgesi(simge))
  }
  e.ekle(yaziOgesi("p", "nar-bos-baslik", baslik))
  if aciklama != "" {
    e.ekle(yaziOgesi("p", "nar-bos-aciklama", aciklama))
  }
  e.ekle(ogeYap(eylem))
  return e
}

fn sayfalamaOgesi(simdi: Int, toplam: Int,
                  gidince: (Int) -> Void) -> Element {
  let e = sinifliOge("div", "nar-sayfalama")
  let geri = ikonDugmesi("ok-sol", "önceki sayfa", || {
    if simdi > 1 {
      gidince(simdi - 1)
    }
  })
  if simdi <= 1 {
    geri.ozellikYaz("disabled", "disabled")
  }
  let ileri = ikonDugmesi("ok-sag", "sonraki sayfa", || {
    if simdi < toplam {
      gidince(simdi + 1)
    }
  })
  if simdi >= toplam {
    ileri.ozellikYaz("disabled", "disabled")
  }
  e.ekle(geri)
  e.ekle(yaziOgesi("span", "nar-sayfa-no", "${simdi} / ${toplam}"))
  e.ekle(ileri)
  return e
}

fn akordeonOgesi(basliklar: [String], govdeler: [Gorunum], acik: Int,
                 degisince: (Int) -> Void) -> Element {
  let e = sinifliOge("div", "nar-akordeon")
  for (i, baslik) in basliklar {
    var sinif = "nar-akordeon-bolum"
    if i == acik {
      sinif += " nar-akordeon-acik"
    }
    let bolum = sinifliOge("div", sinif)
    let basi = odaklanabilirIsaretle(sinifliOge("button", "nar-akordeon-basi"))
    basi.ozellikYaz("type", "button")
    // Açıksa tekrar tıklamak kapatır: -1 hiçbir bölümün açık olmadığı hâl.
    basi.ozellikYaz("aria-expanded", if i == acik { "true" } else { "false" })
    basi.ekle(yaziOgesi("span", "", baslik))
    let ok = simgeOgesi("ok-sag")
    ok.sinifEkle("nar-akordeon-ok")
    basi.ekle(ok)
    basi.dinle("click", || {
      degisince(if i == acik { -1 } else { i })
    })
    bolum.ekle(basi)
    if i == acik && i < govdeler.len() {
      let govde = sinifliOge("div", "nar-akordeon-govde")
      govde.ekle(ogeYap(govdeler[i]))
      bolum.ekle(govde)
    }
    e.ekle(bolum)
  }
  return e
}

fn menuOgesi(etiket: String, ogeler: [String],
             secince: (String) -> Void) -> Element {
  let e = sinifliOge("div", "nar-menu")
  let dugme = odaklanabilirIsaretle(sinifliOge("button", "nar-dugme-ikincil"))
  dugme.ozellikYaz("type", "button")
  dugme.ekle(yaziOgesi("span", "", etiket))
  dugme.ekle(simgeOgesi("ok-asagi"))
  let liste = sinifliOge("div", "nar-menu-liste")
  liste.ozellikYaz("role", "menu")
  liste.stil("display", "none")
  dugme.dinle("click", || {
    let acik = liste.ozellik("data-acik") ?? ""
    if acik == "1" {
      liste.ozellikYaz("data-acik", "")
      liste.stil("display", "none")
    } else {
      liste.ozellikYaz("data-acik", "1")
      liste.stil("display", "flex")
    }
  })
  for oge in ogeler {
    let o = sinifliOge("button", "nar-menu-oge")
    o.ozellikYaz("type", "button")
    o.ozellikYaz("role", "menuitem")
    o.metinYaz(oge)
    // `mousedown`: odak listeden çıkmadan seçim tamamlansın.
    o.dinle("mousedown", || {
      liste.ozellikYaz("data-acik", "")
      liste.stil("display", "none")
      secince(oge)
    })
    liste.ekle(o)
  }
  // Odak menüden çıkınca kapanır; dışarı tıklamak da odağı götürür.
  e.dinle("focusout", || {
    liste.ozellikYaz("data-acik", "")
    liste.stil("display", "none")
  })
  e.ekle(dugme)
  e.ekle(liste)
  return e
}

fn ipucuOgesi(notu: String, ic: Gorunum) -> Element {
  let e = sinifliOge("span", "nar-ipucu-sarmal")
  e.ekle(ogeYap(ic))
  let balon = yaziOgesi("span", "nar-ipucu-balon", notu)
  balon.ozellikYaz("role", "tooltip")
  e.ekle(balon)
  return e
}

fn iletisimOgesi(baslik: String, cocuklar: [Gorunum],
                 kapaninca: () -> Void) -> Element {
  let perde = sinifliOge("div", "nar-perde")
  let kutu = sinifliOge("div", "nar-iletisim")
  kutu.ozellikYaz("role", "dialog")
  kutu.ozellikYaz("aria-modal", "true")
  let basi = sinifliOge("div", "nar-iletisim-basi")
  basi.ekle(yaziOgesi("h2", "nar-altbaslik", baslik))
  basi.ekle(ikonDugmesi("carpi", "kapat", kapaninca))
  kutu.ekle(basi)
  for c in cocuklar {
    kutu.ekle(ogeYap(c))
  }
  // Perdeye tıklamak kapatır; kutunun içi tıklamayı yutar, yoksa
  // kutudaki her tıklama pencereyi kapatırdı.
  kutu.dinle("click", |o: Olay| {
    o.durdur()
  })
  perde.dinle("click", kapaninca)
  perde.ekle(kutu)
  return perde
}

// --- görsel ayarlar -------------------------------------------------------

// Sayfaya bir web yazı tipi bağlar ve gövde fontunun başına ekler.
// Yazı tipi yüklenemezse sistem fontuna düşülür; sayfa yine okunur.
fn fontKur(aile: String, adres: String) {
  if bul("#nar-font") == none && adres != "" {
    let bag = olustur("link")
    bag.ozellikYaz("id", "nar-font")
    bag.ozellikYaz("rel", "stylesheet")
    bag.ozellikYaz("href", adres)
    if let bas = bul("head") {
      bas.ekle(bag)
    }
  }
  // Ayrı bir stil öğesi: deri değiştiğinde font seçimi kaybolmasın.
  var e = bul("#nar-font-stil")
  if e == none {
    let yeni = olustur("style")
    yeni.ozellikYaz("id", "nar-font-stil")
    if let bas = bul("head") {
      bas.ekle(yeni)
    }
    e = bul("#nar-font-stil")
  }
  if e != none {
    e!.metinYaz(":root { --nar-govde: '" + aile +
                "', -apple-system, BlinkMacSystemFont, 'Segoe UI', " +
                "Roboto, sans-serif; }")
  }
}

// Kök kapsayıcının en geniş hâli. Geniş ekranlarda okunabilirlik için
// varsayılan 820px; gösterge paneli gibi sayfalarda büyütülür.
fn genislikKur(px: Int) {
  if let kok = bul(".nar-kok") {
    kok.stil("max-width", "${px}px")
  }
}

// --- uygulama -------------------------------------------------------------

// Durumu tutar ve değiştiğinde görünümü yeniden çizer.
//
// `D` uygulamanın durum tipidir: bir sayı, bir struct, bir liste…
struct Uygulama<D> {
  var durum: D
  gorunum: (D) -> Gorunum
  var kokSecici: String

  // Uygulamayı verilen öğenin içine çizer.
  fn baslat(secici: String) {
    self.kokSecici = secici
    stiliKur(STIL)
    // Kırılma noktası değişince ekran yeniden çizilir: `.mobil()` ile
    // verilen görünüm durum gibi ele alınır. Yeni yerleşim gerçekten
    // ilk kez göründüğü için hareket defteri de silinir.
    medyaDinle(DAR_EKRAN, |dar| {
      hareketDefteriniSil()
      self.yenile()
    })
    self.yenile()
  }

  // Durumu değiştirir ve ekranı tazeler.
  fn degistir(yeni: D) {
    self.durum = yeni
    self.yenile()
  }

  fn yenile() {
    let kok = bul(self.kokSecici)
    if kok == none {
      print("arayüz: '${self.kokSecici}' bulunamadı")
      return
    }
    let alan = kok!
    // Ağaç baştan çizildiği için odaktaki öğe yok olur; nerede olduğunu
    // önce kaydedip sonra geri veriyoruz.
    let odak = odagiOku()

    odakSayaciniSifirla()
    hareketSayaciniSifirla()
    alan.temizle()
    alan.sinifEkle("nar-kok")
    alan.ekle(ogeYap(self.gorunum(self.durum)))

    odagiGeriVer(odak)
  }
}

// Kolay kurulum: durumu ve çizim işlevini verip başlatır.
fn uygulamaBaslat<D>(secici: String, baslangic: D,
                     gorunum: (D) -> Gorunum) -> Uygulama<D> {
  let u = Uygulama<D> {
    durum: baslangic,
    gorunum: gorunum,
    kokSecici: secici
  }
  u.baslat(secici)
  return u
}
