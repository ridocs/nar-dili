// Nar sözdizimi renklendiricisi — Nar diliyle yazılmıştır.
//
// Nar kaynağını alır, IDE'nin ve belgeler sitesinin kullandığı
// <span class="...">...</span> biçiminde HTML üretir.
//
// Bu bir "dogfooding" örneğidir: dil kendi aracını yazıyor.
// Ortak tarama işleri `tarayici.nar` içindedir.
//
// Kütüphane olarak derlemek için:
//     nar build araclar/renklendirici.nar --kutuphane -o cikti/renklendirici.js

import "tarayici.nar"

fn sar(sinif: String, metin: String) -> String {
  if sinif.len() == 0 {
    return kacir(metin)
  }
  return "<span class=\"${sinif}\">${kacir(metin)}</span>"
}

fn renklendir(kaynak: String) -> String {
  var sonuc = ""
  var i = 0
  let n = kaynak.len()

  while i < n {
    let c = karakter(kaynak, i)
    let d = karakter(kaynak, i + 1)

    // yorumlar
    if c == "/" && d == "/" {
      let son = satirYorumuSonu(kaynak, i)
      sonuc += sar("n-yorum", kaynak.slice(i, son))
      i = son
      continue
    }
    if c == "/" && d == "*" {
      let son = blokYorumuSonu(kaynak, i)
      sonuc += sar("n-yorum", kaynak.slice(i, son))
      i = son
      continue
    }

    // metin literali
    if c == "\"" {
      let son = metinSonu(kaynak, i)
      sonuc += sar("n-metin", kaynak.slice(i, son))
      i = son
      continue
    }

    // sayı
    if rakamMi(c) {
      let son = sayiSonu(kaynak, i)
      sonuc += sar("n-sayi", kaynak.slice(i, son))
      i = son
      continue
    }

    // tanımlayıcı / anahtar kelime
    if harfMi(c) {
      let son = kelimeSonu(kaynak, i)
      let kelime = kaynak.slice(i, son)
      let bakis = kaynak.slice(son, min(son + 4, n))
      sonuc += sar(kelimeSinifi(kelime, bakis), kelime)
      i = son
      continue
    }

    // boşluk olduğu gibi geçer
    if bosluktanMi(c) {
      sonuc += kacir(c)
      i += 1
      continue
    }

    // geri kalan tek karakterlik simgeler
    sonuc += sar("n-op", c)
    i += 1
  }

  return sonuc
}
