// Nar sözdizimi renklendiricisi — Nar diliyle yazılmıştır.
//
// Nar kaynağını alır, IDE'nin ve belgeler sitesinin kullandığı
// <span class="...">...</span> biçiminde HTML üretir.
//
// Bu dosya bir "dogfooding" örneğidir: dilin kendi aracını yazabildiğini
// gösterir. Nar'da düzenli ifade (regex) yoktur, bu yüzden kaynak karakter
// karakter taranır — yani burada gerçek bir küçük lexer vardır.
//
// Kütüphane olarak derlemek için:
//     nar build araclar/renklendirici.nar --kutuphane -o ide/renklendirici.js

let KUCUK = "abcçdefgğhıijklmnoöprsştuüvwxyz"
let BUYUK = "ABCÇDEFGĞHIİJKLMNOÖPRSŞTUÜVWXYZ"
let RAKAM = "0123456789"
let BOSLUK = " \t\r\n"

let ANAHTAR = [
  "let", "var", "fn", "return", "if", "else", "while", "for", "in",
  "match", "struct", "enum", "import", "true", "false", "none",
  "self", "break", "continue", "type"
]

let TIP_ADI = ["Int", "Float", "Bool", "String", "Void"]

let YERLESIK = [
  "print", "str", "len", "int", "float", "abs", "min", "max", "sqrt",
  "pow", "floor", "ceil", "round", "random", "panic", "assert"
]

// --- karakter sınıfları ---------------------------------------------------

fn harfMi(c: String) -> Bool {
  if c.len() == 0 {
    return false
  }
  return KUCUK.contains(c) || BUYUK.contains(c) || c == "_"
}

fn rakamMi(c: String) -> Bool {
  if c.len() == 0 {
    return false
  }
  return RAKAM.contains(c)
}

fn adKarakteriMi(c: String) -> Bool = harfMi(c) || rakamMi(c)

fn buyukHarfMi(c: String) -> Bool {
  if c.len() == 0 {
    return false
  }
  return BUYUK.contains(c)
}

fn bosluktanMi(c: String) -> Bool {
  if c.len() == 0 {
    return false
  }
  return BOSLUK.contains(c)
}

// --- yardımcılar ----------------------------------------------------------

fn karakter(kaynak: String, i: Int) -> String {
  if i < 0 || i >= kaynak.len() {
    return ""
  }
  return kaynak.charAt(i)
}

fn kacir(s: String) -> String {
  var sonuc = s.replace("&", "&amp;")
  sonuc = sonuc.replace("<", "&lt;")
  sonuc = sonuc.replace(">", "&gt;")
  return sonuc
}

fn sar(sinif: String, metin: String) -> String {
  if sinif.len() == 0 {
    return kacir(metin)
  }
  return "<span class=\"${sinif}\">${kacir(metin)}</span>"
}

// --- kelime sınıflandırma -------------------------------------------------

// Bir kelimenin hangi renge boyanacağını belirler. `sonrasi`, kelimeden
// hemen sonraki metindir; açılış parantezi varsa kelime bir çağrıdır.
fn kelimeSinifi(kelime: String, sonrasi: String) -> String {
  if ANAHTAR.contains(kelime) {
    return "n-kw"
  }
  if TIP_ADI.contains(kelime) {
    return "n-tip"
  }
  if YERLESIK.contains(kelime) {
    return "n-yerlesik"
  }
  if sonrasi.trim().startsWith("(") {
    return "n-fn"
  }
  if buyukHarfMi(kelime.charAt(0)) {
    return "n-tip"
  }
  return ""
}

// --- tarayıcılar ----------------------------------------------------------
// Her biri başlangıç dizinini alır, o parçanın bittiği dizini döndürür.

fn satirYorumuSonu(kaynak: String, bas: Int) -> Int {
  var i = bas
  let n = kaynak.len()
  while i < n && karakter(kaynak, i) != "\n" {
    i += 1
  }
  return i
}

fn blokYorumuSonu(kaynak: String, bas: Int) -> Int {
  let n = kaynak.len()
  var i = bas + 2
  var derinlik = 1
  while i < n && derinlik > 0 {
    let c = karakter(kaynak, i)
    let d = karakter(kaynak, i + 1)
    if c == "/" && d == "*" {
      derinlik += 1
      i += 2
    } else {
      if c == "*" && d == "/" {
        derinlik -= 1
        i += 2
      } else {
        i += 1
      }
    }
  }
  return i
}

fn metinSonu(kaynak: String, bas: Int) -> Int {
  let n = kaynak.len()
  var i = bas + 1
  while i < n {
    let c = karakter(kaynak, i)
    if c == "\\" {
      i += 2
      continue
    }
    if c == "\"" {
      return i + 1
    }
    if c == "\n" {
      return i
    }
    i += 1
  }
  return i
}

fn sayiSonu(kaynak: String, bas: Int) -> Int {
  let n = kaynak.len()
  var i = bas
  var noktaGorüldü = false
  while i < n {
    let c = karakter(kaynak, i)
    if rakamMi(c) || c == "_" {
      i += 1
      continue
    }
    if c == "." && !noktaGorüldü && rakamMi(karakter(kaynak, i + 1)) {
      noktaGorüldü = true
      i += 1
      continue
    }
    if (c == "x" || c == "b" || c == "o") && i == bas + 1 {
      i += 1
      continue
    }
    if harfMi(c) && i > bas {
      // 0xFF gibi taban gösterimlerinin harfleri
      i += 1
      continue
    }
    return i
  }
  return i
}

fn kelimeSonu(kaynak: String, bas: Int) -> Int {
  let n = kaynak.len()
  var i = bas
  while i < n && adKarakteriMi(karakter(kaynak, i)) {
    i += 1
  }
  return i
}

// --- ana işlev ------------------------------------------------------------

fn renklendir(kaynak: String) -> String {
  var sonuc = ""
  var i = 0
  let n = kaynak.len()

  while i < n {
    let c = karakter(kaynak, i)
    let d = karakter(kaynak, i + 1)

    // yorumlar
    if c == "/" && d == "/" {
      let son = satirYorumuSonu(kaynak, i)
      sonuc += sar("n-yorum", kaynak.slice(i, son))
      i = son
      continue
    }
    if c == "/" && d == "*" {
      let son = blokYorumuSonu(kaynak, i)
      sonuc += sar("n-yorum", kaynak.slice(i, son))
      i = son
      continue
    }

    // metin literali
    if c == "\"" {
      let son = metinSonu(kaynak, i)
      sonuc += sar("n-metin", kaynak.slice(i, son))
      i = son
      continue
    }

    // sayı
    if rakamMi(c) {
      let son = sayiSonu(kaynak, i)
      sonuc += sar("n-sayi", kaynak.slice(i, son))
      i = son
      continue
    }

    // tanımlayıcı / anahtar kelime
    if harfMi(c) {
      let son = kelimeSonu(kaynak, i)
      let kelime = kaynak.slice(i, son)
      let bakis = kaynak.slice(son, min(son + 4, n))
      sonuc += sar(kelimeSinifi(kelime, bakis), kelime)
      i = son
      continue
    }

    // boşluk olduğu gibi geçer
    if bosluktanMi(c) {
      sonuc += kacir(c)
      i += 1
      continue
    }

    // geri kalan tek karakterlik simgeler
    sonuc += sar("n-op", c)
    i += 1
  }

  return sonuc
}

// Kendi başına çalıştırıldığında küçük bir gösteri yapar.
fn main() {
  let ornek = "fn selam(ad: String) -> String {\n  // merhaba de\n  return \"Merhaba \" + ad\n}"
  print("--- girdi ---")
  print(ornek)
  print("")
  print("--- renklendirilmiş HTML ---")
  print(renklendir(ornek))
}
