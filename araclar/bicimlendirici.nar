// Nar kod biçimlendiricisi — Nar diliyle yazılmıştır.
//
// Kaynağı yeniden girintiler ve boşlukları düzenler. Kodun *anlamını*
// değiştirmez: yalnızca satır başlarındaki girinti, satır sonlarındaki
// fazlalık boşluk ve arka arkaya gelen boş satırlar düzeltilir.
//
// Nasıl çalışır: kaynak taranırken açık parantezler bir yığında tutulur.
//   - Yığının tepesi "{" ise satır bir blok içindedir → yeniden girintilenir.
//     Blok, açıldığı satırdan bir kademe içeridedir; böylece bir çağrının
//     ortasında açılan lambda gövdesi de doğru yerde durur.
//   - Tepesi "(" ya da "[" ise satır bir **devam satırıdır** (çok satırlı
//     koşul, hizalanmış argüman listesi) → yazarın hizalaması korunur.
// Metin literalleri ve yorumlar taranırken atlanır; içlerindeki parantezler
// sayılmaz. Çok satırlı metnin (""") içi ise hiç dokunulmadan geçer:
// oradaki boşluk biçim değil, içeriktir.
//
//     nar fmt dosya.nar          yerinde düzenler
//     nar fmt dosya.nar --goster ekrana yazar

import "tarayici.nar"

let GIRINTI = "  "

// Yığındaki bir açık parantez. `seviye`, bu parantezin içindeki satırların
// girinti kademesidir: blok için açıldığı satırın bir fazlası.
struct Parantez {
  isaret: String
  seviye: Int
}

// Bir satır tarandıktan sonra ulaşılan durum.
struct TaramaDurumu {
  var yorumDerinligi: Int
  // Satır yarım kalan bir ifadeyle bittiyse (örneğin "=" ya da "+" ile),
  // sonraki satır onun devamıdır ve bir kademe içeri alınır.
  var devamBekleniyor: Bool
  // Taranan satırın yorum ve metin dışında kalan son anlamlı karakteri.
  var sonKarakter: String
  // Ondan bir önceki; `->` gibi iki karakterli bitişleri tanımak için.
  var oncekiKarakter: String
  // Çok satırlı bir metin literalinin ortasında mıyız?
  var cokSatirliMetin: Bool
}

// İfadenin yarım kaldığını gösteren satır sonları.
// Virgül burada yok: virgülle biten satır zaten bir parantez ya da blok
// içindedir ve girintisini oradan alır.
let YARIM_BITIS = "=+*/&|"

fn yarimMi(oncekiKarakter: String, sonKarakter: String) -> Bool {
  if sonKarakter.len() == 0 {
    return false
  }
  // `match` kolunun ya da tek ifadelik gövdenin oku satır sonunda kalabilir;
  // gövde bir alt satırda ve bir kademe içeride devam eder.
  if oncekiKarakter == "-" && sonKarakter == ">" {
    return true
  }
  return YARIM_BITIS.contains(sonKarakter)
}

fn sagdanKirp(s: String) -> String {
  var son = s.len()
  while son > 0 && bosluktanMi(karakter(s, son - 1)) {
    son -= 1
  }
  return s.slice(0, son)
}

fn soldanKirp(s: String) -> String {
  var bas = 0
  let n = s.len()
  while bas < n && bosluktanMi(karakter(s, bas)) {
    bas += 1
  }
  return s.slice(bas, n)
}

fn girintiUret(seviye: Int) -> String {
  if seviye <= 0 {
    return ""
  }
  return GIRINTI.repeat(seviye)
}

// Satırın baştaki boşluk sayısı.
fn bastakiBosluk(satir: String) -> Int {
  var n = 0
  let uzunluk = satir.len()
  while n < uzunluk {
    let c = karakter(satir, n)
    if c != " " && c != "\t" {
      return n
    }
    n += 1
  }
  return uzunluk
}

// Devam satırlarını, açılış satırının kaydığı kadar kaydırır; böylece
// yazarın hizalaması bloğa göre doğru yerde kalır.
fn kaydir(satir: String, miktar: Int) -> String {
  if miktar == 0 {
    return satir
  }
  if miktar > 0 {
    return " ".repeat(miktar) + satir
  }
  let atilacak = min(0 - miktar, bastakiBosluk(satir))
  return satir.slice(atilacak, satir.len())
}

// En içteki bloğun girinti seviyesi. Blok yoksa 0.
//
// Seviye açık süslü parantezleri saymakla bulunmaz: blok bir çağrının
// ortasında da açılabilir (`Giris("ad", "", |v| {`) ve o zaman gövdesi
// çağrının hizasından devam etmelidir, sıfırdan değil.
fn blokSeviyesi(yigin: [Parantez]) -> Int {
  var i = yigin.len() - 1
  while i >= 0 {
    if yigin[i].isaret == "{" {
      return yigin[i].seviye
    }
    i -= 1
  }
  return 0
}

// Yeni açılan bir parantezin içindeki satırların girinti kademesi.
//
// Blok, kendisini çevreleyen en içteki parantezin bir kademe içindedir.
// Açıldığı satırın girintisine bakılmaz: çok satırlı bir imzanın ikinci
// satırı açılış parantezine hizalanmıştır, o hiza gövdeyi bağlamaz.
fn icSeviye(yigin: [Parantez], satirSeviyesi: Int, isaret: String) -> Int {
  if isaret != "{" {
    // Parantez ve köşeli parantez kademe açmaz; içleri devam satırı sayılır
    // ve yazarın hizalaması korunur. Yine de içlerinde bir blok açılabilir,
    // bunun için satırın kendi kademesini taşırlar.
    return satirSeviyesi
  }
  if yigin.len() == 0 {
    return 1
  }
  return yigin[yigin.len() - 1].seviye + 1
}

// Satır bir devam satırı mı? (açık parantez var ve en içteki blok değil)
fn devamMi(yigin: [Parantez]) -> Bool {
  if yigin.len() == 0 {
    return false
  }
  return yigin[yigin.len() - 1].isaret != "{"
}

// Satırı tarar; yığını ve yorum derinliğini yerinde günceller.
// Metin ve yorum içindeki parantezler sayılmaz.
//
// `satirSeviyesi` bu satırın kendi girinti kademesidir; burada açılan bir
// blok gövdesini bir fazlasına yerleştirir.
fn satiriTara(satir: String, yigin: [Parantez], durum: TaramaDurumu,
              satirSeviyesi: Int) {
  let n = satir.len()
  var i = 0
  durum.sonKarakter = ""
  durum.oncekiKarakter = ""

  while i < n {
    let c = karakter(satir, i)
    let d = karakter(satir, i + 1)

    // Çok satırlı metnin içindeysek yalnızca kapanış üç tırnağını arıyoruz;
    // içerideki parantez, tırnak ve yorum işareti sıradan karakterdir.
    if durum.cokSatirliMetin {
      if c == "\"" && d == "\"" && karakter(satir, i + 2) == "\"" {
        durum.cokSatirliMetin = false
        durum.oncekiKarakter = durum.sonKarakter
        durum.sonKarakter = "\""
        i += 3
        continue
      }
      i += 1
      continue
    }

    // Blok yorumunun içindeysek yalnızca kapanışı arıyoruz.
    if durum.yorumDerinligi > 0 {
      if c == "*" && d == "/" {
        durum.yorumDerinligi -= 1
        i += 2
        continue
      }
      if c == "/" && d == "*" {
        durum.yorumDerinligi += 1
        i += 2
        continue
      }
      i += 1
      continue
    }

    if c == "/" && d == "/" {
      return          // satır yorumu: geri kalanı yok say
    }
    if c == "/" && d == "*" {
      durum.yorumDerinligi += 1
      i += 2
      continue
    }
    if c == "\"" {
      // `"""` çok satırlı metni açar; aynı satırda kapanmazsa sonraki
      // satırlar da metnin parçasıdır.
      if d == "\"" && karakter(satir, i + 2) == "\"" {
        durum.cokSatirliMetin = true
        durum.oncekiKarakter = durum.sonKarakter
        durum.sonKarakter = "\""
        i += 3
        continue
      }
      i = metinSonu(satir, i)
      durum.oncekiKarakter = durum.sonKarakter
      durum.sonKarakter = "\""
      continue
    }

    if c == "{" || c == "(" || c == "[" {
      yigin.push(Parantez {
        isaret: c,
        seviye: icSeviye(yigin, satirSeviyesi, c)
      })
    }
    if c == "}" || c == ")" || c == "]" {
      if yigin.len() > 0 {
        yigin.pop()
      }
    }
    if !bosluktanMi(c) {
      durum.oncekiKarakter = durum.sonKarakter
      durum.sonKarakter = c
    }
    i += 1
  }
}

// Satır bir kapanışla mı başlıyor? Öyleyse kendi girintisi bir azalır.
fn kapanislaBasliyorMu(satir: String) -> Bool {
  let c = karakter(satir, 0)
  return c == "}" || c == ")" || c == "]"
}

fn bicimlendir(kaynak: String) -> String {
  let satirlar = kaynak.split("\n")
  var sonuc: [String] = []
  var yigin: [Parantez] = []
  let durum = TaramaDurumu {
    yorumDerinligi: 0,
    devamBekleniyor: false,
    sonKarakter: "",
    oncekiKarakter: "",
    cokSatirliMetin: false
  }
  var ardisikBos = 0
  // Devam satırları, açılış satırıyla aynı miktarda kaydırılır.
  var kayma = 0
  // Son yazılan satırın girinti kademesi; burada açılan blok bunun bir
  // fazlasından devam eder.
  var satirSeviyesi = 0

  for ham in satirlar {
    // Çok satırlı metnin içi hiç dokunulmadan geçer: oradaki boşluk ve boş
    // satırlar biçim değil, metnin kendisidir.
    if durum.cokSatirliMetin {
      sonuc.push(ham)
      satiriTara(ham, yigin, durum, satirSeviyesi)
      durum.devamBekleniyor = false
      ardisikBos = 0
      continue
    }

    // Blok yorumunun ortası ve devam satırları olduğu gibi korunur.
    let korunacak = durum.yorumDerinligi > 0 || devamMi(yigin)
    let satir = sagdanKirp(soldanKirp(ham))

    if satir.len() == 0 && !korunacak {
      ardisikBos += 1
      // Arka arkaya en fazla bir boş satır bırakılır.
      if ardisikBos <= 1 && sonuc.len() > 0 {
        sonuc.push("")
      }
      satiriTara(satir, yigin, durum, satirSeviyesi)
      continue
    }

    ardisikBos = 0

    if korunacak {
      let cikti = sagdanKirp(kaydir(ham, kayma))
      sonuc.push(cikti)
      satirSeviyesi = bastakiBosluk(cikti) / GIRINTI.len()
    } else {
      var seviye = blokSeviyesi(yigin)
      if kapanislaBasliyorMu(satir) {
        seviye -= 1
      }
      // Önceki satır yarım kaldıysa bu satır onun devamıdır.
      if durum.devamBekleniyor {
        seviye += 1
      }
      if seviye < 0 {
        seviye = 0
      }
      kayma = (seviye * GIRINTI.len()) - bastakiBosluk(ham)
      sonuc.push(girintiUret(seviye) + satir)
      satirSeviyesi = seviye
    }

    satiriTara(satir, yigin, durum, satirSeviyesi)
    durum.devamBekleniyor = yarimMi(durum.oncekiKarakter, durum.sonKarakter)
  }

  // Sondaki boş satırları at, tek bir satır sonu bırak.
  while sonuc.len() > 0 && (sonuc.last() ?? "x").len() == 0 {
    sonuc.pop()
  }

  return sonuc.join("\n") + "\n"
}
