// Nar kod biçimlendiricisi — Nar diliyle yazılmıştır.
//
// Kaynağı yeniden girintiler ve boşlukları düzenler. Kodun *anlamını*
// değiştirmez: yalnızca satır başlarındaki girinti, satır sonlarındaki
// fazlalık boşluk ve arka arkaya gelen boş satırlar düzeltilir.
//
// Nasıl çalışır: kaynak taranırken açık parantezler bir yığında tutulur.
//   - Yığının tepesi "{" ise satır bir blok içindedir → yeniden girintilenir.
//   - Tepesi "(" ya da "[" ise satır bir **devam satırıdır** (çok satırlı
//     koşul, hizalanmış argüman listesi) → yazarın hizalaması korunur.
// Metin literalleri ve yorumlar taranırken atlanır; içlerindeki parantezler
// sayılmaz.
//
//     nar fmt dosya.nar          yerinde düzenler
//     nar fmt dosya.nar --goster ekrana yazar

import "tarayici.nar"

let GIRINTI = "  "

// Bir satır tarandıktan sonra ulaşılan durum.
struct TaramaDurumu {
  var yorumDerinligi: Int
  // Satır yarım kalan bir ifadeyle bittiyse (örneğin "=" ya da "+" ile),
  // sonraki satır onun devamıdır ve bir kademe içeri alınır.
  var devamBekleniyor: Bool
  // Taranan satırın yorum ve metin dışında kalan son anlamlı karakteri.
  var sonKarakter: String
}

// İfadenin yarım kaldığını gösteren satır sonları.
// Virgül burada yok: virgülle biten satır zaten bir parantez ya da blok
// içindedir ve girintisini oradan alır.
let YARIM_BITIS = "=+*/&|"

fn yarimMi(sonKarakter: String) -> Bool {
  if sonKarakter.len() == 0 {
    return false
  }
  return YARIM_BITIS.contains(sonKarakter)
}

fn sagdanKirp(s: String) -> String {
  var son = s.len()
  while son > 0 && bosluktanMi(karakter(s, son - 1)) {
    son -= 1
  }
  return s.slice(0, son)
}

fn soldanKirp(s: String) -> String {
  var bas = 0
  let n = s.len()
  while bas < n && bosluktanMi(karakter(s, bas)) {
    bas += 1
  }
  return s.slice(bas, n)
}

fn girintiUret(seviye: Int) -> String {
  if seviye <= 0 {
    return ""
  }
  return GIRINTI.repeat(seviye)
}

// Satırın baştaki boşluk sayısı.
fn bastakiBosluk(satir: String) -> Int {
  var n = 0
  let uzunluk = satir.len()
  while n < uzunluk {
    let c = karakter(satir, n)
    if c != " " && c != "\t" {
      return n
    }
    n += 1
  }
  return uzunluk
}

// Devam satırlarını, açılış satırının kaydığı kadar kaydırır; böylece
// yazarın hizalaması bloğa göre doğru yerde kalır.
fn kaydir(satir: String, miktar: Int) -> String {
  if miktar == 0 {
    return satir
  }
  if miktar > 0 {
    return " ".repeat(miktar) + satir
  }
  let atilacak = min(0 - miktar, bastakiBosluk(satir))
  return satir.slice(atilacak, satir.len())
}

// Yığındaki süslü parantez sayısı — blok girinti seviyesi budur.
fn blokSayisi(yigin: [String]) -> Int {
  var n = 0
  for p in yigin {
    if p == "{" {
      n += 1
    }
  }
  return n
}

// Satır bir devam satırı mı? (açık parantez var ve en içteki blok değil)
fn devamMi(yigin: [String]) -> Bool {
  if yigin.len() == 0 {
    return false
  }
  return (yigin.last() ?? "{") != "{"
}

// Satırı tarar; yığını ve yorum derinliğini yerinde günceller.
// Metin ve yorum içindeki parantezler sayılmaz.
fn satiriTara(satir: String, yigin: [String], durum: TaramaDurumu) {
  let n = satir.len()
  var i = 0
  durum.sonKarakter = ""

  while i < n {
    let c = karakter(satir, i)
    let d = karakter(satir, i + 1)

    // Blok yorumunun içindeysek yalnızca kapanışı arıyoruz.
    if durum.yorumDerinligi > 0 {
      if c == "*" && d == "/" {
        durum.yorumDerinligi -= 1
        i += 2
        continue
      }
      if c == "/" && d == "*" {
        durum.yorumDerinligi += 1
        i += 2
        continue
      }
      i += 1
      continue
    }

    if c == "/" && d == "/" {
      return          // satır yorumu: geri kalanı yok say
    }
    if c == "/" && d == "*" {
      durum.yorumDerinligi += 1
      i += 2
      continue
    }
    if c == "\"" {
      i = metinSonu(satir, i)
      durum.sonKarakter = "\""
      continue
    }

    if c == "{" || c == "(" || c == "[" {
      yigin.push(c)
    }
    if c == "}" || c == ")" || c == "]" {
      if yigin.len() > 0 {
        yigin.pop()
      }
    }
    if !bosluktanMi(c) {
      durum.sonKarakter = c
    }
    i += 1
  }
}

// Satır bir kapanışla mı başlıyor? Öyleyse kendi girintisi bir azalır.
fn kapanislaBasliyorMu(satir: String) -> Bool {
  let c = karakter(satir, 0)
  return c == "}" || c == ")" || c == "]"
}

fn bicimlendir(kaynak: String) -> String {
  let satirlar = kaynak.split("\n")
  var sonuc: [String] = []
  var yigin: [String] = []
  let durum = TaramaDurumu {
    yorumDerinligi: 0,
    devamBekleniyor: false,
    sonKarakter: ""
  }
  var ardisikBos = 0
  // Devam satırları, açılış satırıyla aynı miktarda kaydırılır.
  var kayma = 0

  for ham in satirlar {
    // Blok yorumunun ortası ve devam satırları olduğu gibi korunur.
    let korunacak = durum.yorumDerinligi > 0 || devamMi(yigin)
    let satir = sagdanKirp(soldanKirp(ham))

    if satir.len() == 0 && !korunacak {
      ardisikBos += 1
      // Arka arkaya en fazla bir boş satır bırakılır.
      if ardisikBos <= 1 && sonuc.len() > 0 {
        sonuc.push("")
      }
      satiriTara(satir, yigin, durum)
      continue
    }

    ardisikBos = 0

    if korunacak {
      sonuc.push(sagdanKirp(kaydir(ham, kayma)))
    } else {
      var seviye = blokSayisi(yigin)
      if kapanislaBasliyorMu(satir) {
        seviye -= 1
      }
      // Önceki satır yarım kaldıysa bu satır onun devamıdır.
      if durum.devamBekleniyor {
        seviye += 1
      }
      if seviye < 0 {
        seviye = 0
      }
      kayma = (seviye * GIRINTI.len()) - bastakiBosluk(ham)
      sonuc.push(girintiUret(seviye) + satir)
    }

    satiriTara(satir, yigin, durum)
    durum.devamBekleniyor = yarimMi(durum.sonKarakter)
  }

  // Sondaki boş satırları at, tek bir satır sonu bırak.
  while sonuc.len() > 0 && (sonuc.last() ?? "x").len() == 0 {
    sonuc.pop()
  }

  return sonuc.join("\n") + "\n"
}
