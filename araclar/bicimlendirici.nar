// Nar kod biçimlendiricisi — Nar diliyle yazılmıştır.
//
// Kaynağı yeniden girintiler ve boşlukları düzenler. Kodun *anlamını*
// değiştirmez: yalnızca satır başlarındaki girinti, satır sonlarındaki
// fazlalık boşluk ve arka arkaya gelen boş satırlar düzeltilir.
//
// Metin literalleri ve yorumlar olduğu gibi bırakılır — içlerindeki
// süslü parantezler girinti sayımına katılmaz.
//
//     nar fmt dosya.nar          yerinde düzenler
//     nar fmt dosya.nar --goster ekrana yazar

import "tarayici.nar"

let GIRINTI = "  "

// Bir satırdaki parantez dengesini ve satırın nasıl başladığını anlatır.
struct SatirBilgisi {
  acilan: Int        // satır sonunda kaç seviye artmalı (negatif olabilir)
  bastaKapanan: Int  // satırın kendisi kaç seviye geri çekilmeli
  bosMu: Bool
}

// Satırı tarayıp parantez dengesini çıkarır; metin ve yorum içindekiler
// sayılmaz. Süslü parantez, köşeli parantez ve normal parantez sayılır.
fn satiriIncele(satir: String) -> SatirBilgisi {
  let n = satir.len()
  var i = 0
  var denge = 0
  var enDusuk = 0
  var icerikVar = false

  while i < n {
    let c = karakter(satir, i)
    let d = karakter(satir, i + 1)

    if c == "/" && d == "/" {
      // satır yorumu: geri kalanı yok say
      i = n
      continue
    }
    if c == "/" && d == "*" {
      let son = blokYorumuSonu(satir, i)
      icerikVar = true
      i = son
      continue
    }
    if c == "\"" {
      let son = metinSonu(satir, i)
      icerikVar = true
      i = son
      continue
    }

    if c == "{" || c == "[" || c == "(" {
      denge += 1
      icerikVar = true
    } else {
      if c == "}" || c == "]" || c == ")" {
        denge -= 1
        if denge < enDusuk {
          enDusuk = denge
        }
        icerikVar = true
      } else {
        if !bosluktanMi(c) {
          icerikVar = true
        }
      }
    }
    i += 1
  }

  // Bir satır birden çok parantez açsa bile girinti tek seviye artar.
  // Örnek:  dinle("click", || {      <- hem "(" hem "{" açılır
  // İnsanlar burada iki değil bir seviye içeri girer; kapanışta da
  // simetrik olması için aynı sınır uygulanır.
  var acilan = 0
  if denge > 0 {
    acilan = 1
  }
  if denge < 0 {
    acilan = -1
  }

  // Satır kapanışla başlıyorsa (örneğin "}" ya da "} else {") o satırın
  // kendisi bir seviye geri çekilir.
  var bastaKapanan = 0
  if enDusuk < 0 {
    bastaKapanan = 1
  }

  return SatirBilgisi {
    acilan: acilan,
    bastaKapanan: bastaKapanan,
    bosMu: !icerikVar
  }
}

fn girintiUret(seviye: Int) -> String {
  if seviye <= 0 {
    return ""
  }
  return GIRINTI.repeat(seviye)
}

// Satır sonundaki boşlukları atar. Nar'da sağdan kırpma yok, elle yapılır.
fn sagdanKirp(s: String) -> String {
  var son = s.len()
  while son > 0 && bosluktanMi(karakter(s, son - 1)) {
    son -= 1
  }
  return s.slice(0, son)
}

fn soldanKirp(s: String) -> String {
  var bas = 0
  let n = s.len()
  while bas < n && bosluktanMi(karakter(s, bas)) {
    bas += 1
  }
  return s.slice(bas, n)
}

// Çok satırlı metin literali ya da blok yorumu içinde miyiz?
// Bu durumda satır olduğu gibi bırakılır.
fn blokYorumundaMi(kaynak: String, satirBasi: Int) -> Bool {
  var i = 0
  var derinlik = 0
  while i < satirBasi {
    let c = karakter(kaynak, i)
    let d = karakter(kaynak, i + 1)
    if derinlik == 0 && c == "/" && d == "/" {
      i = satirYorumuSonu(kaynak, i)
      continue
    }
    if derinlik == 0 && c == "\"" {
      i = metinSonu(kaynak, i)
      continue
    }
    if c == "/" && d == "*" {
      derinlik += 1
      i += 2
      continue
    }
    if c == "*" && d == "/" && derinlik > 0 {
      derinlik -= 1
      i += 2
      continue
    }
    i += 1
  }
  return derinlik > 0
}

fn bicimlendir(kaynak: String) -> String {
  let satirlar = kaynak.split("\n")
  var sonuc: [String] = []
  var seviye = 0
  var ardisikBos = 0
  var konum = 0

  for ham in satirlar {
    let satirUzunlugu = ham.len()

    // Blok yorumunun ortasındaki satırlar olduğu gibi korunur.
    if blokYorumundaMi(kaynak, konum) {
      sonuc.push(sagdanKirp(ham))
      konum += satirUzunlugu + 1
      ardisikBos = 0
      continue
    }

    let satir = sagdanKirp(soldanKirp(ham))

    if satir.len() == 0 {
      ardisikBos += 1
      // Arka arkaya en fazla bir boş satır bırakılır.
      if ardisikBos <= 1 && sonuc.len() > 0 {
        sonuc.push("")
      }
      konum += satirUzunlugu + 1
      continue
    }

    ardisikBos = 0
    let bilgi = satiriIncele(satir)

    var buSatirinSeviyesi = seviye - bilgi.bastaKapanan
    if buSatirinSeviyesi < 0 {
      buSatirinSeviyesi = 0
    }

    sonuc.push(girintiUret(buSatirinSeviyesi) + satir)

    seviye = seviye + bilgi.acilan
    if seviye < 0 {
      seviye = 0
    }
    konum += satirUzunlugu + 1
  }

  // Sondaki boş satırları at, tek bir satır sonu bırak.
  while sonuc.len() > 0 && (sonuc.last() ?? "x").len() == 0 {
    sonuc.pop()
  }

  return sonuc.join("\n") + "\n"
}
