// Nar soyut sözdizim ağacı — **Nar diliyle** yazılmıştır.
//
// Python'daki `narc/nar_ast.py` ile aynı ağacı tarif eder. İki tarafın aynı
// ağacı kurup kurmadığı S-ifadesi (parantezli metin) karşılaştırmasıyla
// denetlenir; `yazModul` burada, karşılığı `narc/sifade.py`'de.
//
// KONUM
//
// Her ifade, deyim, desen ve öğe kaynaktaki yerini taşır. Python tarafında
// bu her düğümün `span` alanı; burada düğümü saran bir struct (`IfadeD`,
// `DeyimD`, `DesenD`, `OgeD`). Enum varyantlarına tek tek konum eklemek
// yerine sarmalamak hem bildirimi okunur tutuyor hem de konumu tek bir
// yerden almayı sağlıyor.
//
// `yazModul` konumu **yazmaz**: ağaç yapısının aynı olması ile konum
// hesabının aynı olması iki ayrı sorudur. İkincisi için `yazModulKonumlu`.
//
// Kütüphanedir: `main` içermez.

struct Konum {
  satir: Int
  sutun: Int

  fn goster() -> String = "${self.satir}:${self.sutun}"
}

fn konumsuz() -> Konum = Konum { satir: 0, sutun: 0 }

// --- tip yazımı -----------------------------------------------------------

// Konumuyla birlikte bir tip yazımı.
struct TipD {
  konum: Konum
  ic: TipIfadesi
}

enum TipIfadesi {
  TAd(String, [TipD])                    // Int, Kutu<Int>
  TListe(TipD)                           // [Int]
  TTuple([TipD])                         // (Int, String)
  TEsleme(TipD, TipD)                    // {String: Int}
  TOpsiyonel(TipD)                       // Int?
  TIslev([TipD], TipD?)                  // (Int) -> Bool
}

struct Parametre {
  konum: Konum
  ad: String
  tip: TipD?
  varsayilan: IfadeD? = none      // `a: Int = 5`
}

// --- ifadeler -------------------------------------------------------------

// Konumuyla birlikte bir ifade.
struct IfadeD {
  konum: Konum
  ic: Ifade
}

// Metin literali düz parçalar ve `${...}` gömmelerinden oluşur.
enum MetinParcasi {
  Duz(String)
  Gomme(IfadeD)
}

struct AlanDegeri {
  ad: String
  deger: IfadeD
}

struct IfadeCifti {
  anahtar: IfadeD
  deger: IfadeD
}

enum Ifade {
  ITam(String)                           // ham metin: "42", "0xFF"
  IOndalik(String)
  IMantik(Bool)
  IBos                                   // none
  IMetin([MetinParcasi])
  IAd(String)
  IBen                                   // self
  IListe([IfadeD])
  ITuple([IfadeD])                       // (a, b)
  IEsleme([IfadeCifti])
  IStruct(String, [TipD], [AlanDegeri])
  ITekli(String, IfadeD)                 // -x, !x
  IIkili(String, IfadeD, IfadeD)
  IAralik(IfadeD, IfadeD, Bool)          // son dahil mi
  ICagri(IfadeD, [IfadeD], [String])     // hedef, argümanlar, argüman adları
  IDizin(IfadeD, IfadeD)
  IAlan(IfadeD, String, Bool)            // güvenli mi (?.)
  IAc(IfadeD)                            // x!
  ISoru(IfadeD)                          // x? — none ise işlevden dön
  ILambda([Parametre], TipD?, Govde)
  IEger(IfadeD, IfadeD, IfadeD)          // değer üreten if; else zorunlu
  IBlok(Blok)                            // { deyimler...  son_ifade }
  IMatch(IfadeD, [Kol])
}

// Lambda ve match kolu gövdesi üç biçimde gelebilir.
enum Govde {
  GBlok(Blok)
  GDeyim(DeyimD)
  GIfade(IfadeD)
}

// --- desenler -------------------------------------------------------------

struct DesenD {
  konum: Konum
  ic: Desen
}

enum Desen {
  DJoker                                 // _
  DBaglama(String)                       // ad
  DDeger(IfadeD)                         // 3, "a", none
  DAralik(IfadeD, IfadeD, Bool)          // 1..=9 (son dahil mi)
  DVaryant(String?, String, [DesenD])    // Enum.Varyant(alt...)
}

struct Kol {
  konum: Konum
  desen: DesenD
  govde: Govde
  kosul: IfadeD? = none      // `desen if koşul ->`
}

// --- deyimler -------------------------------------------------------------

struct DeyimD {
  konum: Konum
  ic: Deyim
}

struct Blok {
  konum: Konum
  deyimler: [DeyimD]
}

// `else` dalı: yok, blok, ya da başka bir if (else if zinciri).
enum Yoksa {
  YYok
  YBlok(Blok)
  YEger(DeyimD)
}

enum Deyim {
  SLet(String, TipD?, IfadeD?, Bool, [String])  // ad, tip, değer, değişebilir, açma adları
  SAtama(String, IfadeD, IfadeD)            // işleç, hedef, değer
  SIfade(IfadeD)
  SDonus(IfadeD?)
  SEger(IfadeD, Blok, Yoksa)
  // `if let ad = ifade`: koşul yerine bir opsiyonel açılır.
  SEgerBag(String, IfadeD, Blok, Yoksa)
  SWhile(IfadeD?, Blok, String, IfadeD?)  // koşul, gövde, bağ adı, bağ ifadesi
  SFor([String], IfadeD, Blok)
  SMatch(IfadeD, [Kol])
  SBreak
  SContinue
}

// --- üst düzey öğeler -----------------------------------------------------

struct TipSiniri {
  ad: String
  arayuzler: [String]
}

struct IslevBildirimi {
  konum: Konum
  ad: String
  tipParametreleri: [String]
  tipSinirlari: [TipSiniri]
  parametreler: [Parametre]
  donusTipi: TipD?
  govde: Blok?                           // arayüz metotlarında yok
}

struct AlanBildirimi {
  konum: Konum
  ad: String
  tip: TipD
  degisebilir: Bool
  varsayilan: IfadeD? = none      // `var n: Int = 0`
}

struct VaryantBildirimi {
  konum: Konum
  ad: String
  yuk: [TipD]
}

struct OgeD {
  konum: Konum
  ic: Oge
}

enum Oge {
  OImport(String)
  OTypeAlias(String, TipD)
  OIslev(IslevBildirimi)
  OStruct(String, [String], [String], [AlanBildirimi], [IslevBildirimi])
  OEnum(String, [String], [String], [VaryantBildirimi], [IslevBildirimi])
  OArayuz(String, [IslevBildirimi])
  OLet(DeyimD)                           // üst düzey let/var
}

struct Modul {
  konum: Konum
  ogeler: [OgeD]
}

// ==========================================================================
// S-ifadesi yazıcı
//
// Biçim:
//     (ad alt1 alt2 ...)   düğüm
//     [a b c]              liste
//     "metin"              metin (kaçışlı)
//     true / false         mantıksal
//     -                    yok
//
// Konumlu modda her düğümün ardına `@satır:sütun` eklenir.
// ==========================================================================

// Konumun yazılıp yazılmayacağı. Yazıcı işlevlerinin imzası sade kalsın
// diye üst düzey bir değişken; `yazModul` ve `yazModulKonumlu` ayarlar.
var KONUM_YAZ = false

fn tirnakla(s: String) -> String {
  var sonuc = "\""
  for c in s {
    if c == "\\" {
      sonuc += "\\\\"
    } else {
      if c == "\"" {
        sonuc += "\\\""
      } else {
        if c == "\n" {
          sonuc += "\\n"
        } else {
          if c == "\t" {
            sonuc += "\\t"
          } else {
            if c == "\r" {
              sonuc += "\\r"
            } else {
              sonuc += c
            }
          }
        }
      }
    }
  }
  return sonuc + "\""
}

fn dugum(ad: String, parcalar: [String]) -> String {
  if parcalar.len() == 0 {
    return "(" + ad + ")"
  }
  return "(" + ad + " " + parcalar.join(" ") + ")"
}

// Konumlu modda düğümün sonuna `@satır:sütun` ekler.
fn konumla(metin: String, k: Konum) -> String {
  if !KONUM_YAZ {
    return metin
  }
  return metin + "@" + k.goster()
}

fn dizi(parcalar: [String]) -> String = "[" + parcalar.join(" ") + "]"

fn mantik(b: Bool) -> String {
  if b {
    return "true"
  }
  return "false"
}

// --- sayı yazımı ----------------------------------------------------------

// Python tarafı sayıyı ayrıştırıp yeniden yazar; burada ham metin var.
// Karşılaştırmanın tutması için aynı yazıma indirgenir.
fn tamMetni(ham: String) -> String {
  let temiz = ham.replace("_", "")
  let kucuk = temiz.lower()
  if kucuk.startsWith("0x") {
    return "${tabandanCevir(kucuk.slice(2, kucuk.len()), 16)}"
  }
  if kucuk.startsWith("0b") {
    return "${tabandanCevir(kucuk.slice(2, kucuk.len()), 2)}"
  }
  if kucuk.startsWith("0o") {
    return "${tabandanCevir(kucuk.slice(2, kucuk.len()), 8)}"
  }
  return "${int(temiz) ?? 0}"
}

fn tabandanCevir(basamaklar: String, taban: Int) -> Int {
  let harfler = "0123456789abcdef"
  var sonuc = 0
  for c in basamaklar {
    sonuc = sonuc * taban + harfler.indexOf(c)
  }
  return sonuc
}

// Python `repr(float)` biçimi: tam sayı değerliler ".0" ile biter. Nar'ın
// kendi Float yazımı da aynı kurala uyar, o yüzden gömme yeterli.
fn ondalikMetni(ham: String) -> String {
  let d = float(ham.replace("_", "")) ?? 0.0
  return "${d}"
}

// --- tip yazımı -----------------------------------------------------------

fn yazTip(t: TipD) -> String = konumla(yazTipGovdesi(t.ic), t.konum)

fn yazTipGovdesi(t: TipIfadesi) -> String = match t {
  TAd(ad, args) -> if args.len() == 0 {
    dugum("tad", [tirnakla(ad)])
  } else {
    dugum("tad", [tirnakla(ad), dizi(args.map(|a| yazTip(a)))])
  }
  TListe(e) -> dugum("tliste", [yazTip(e)])
  TTuple(ogeler) -> dugum("ttuple", [dizi(ogeler.map(|o| yazTip(o)))])
  TEsleme(k, v) -> dugum("tesleme", [yazTip(k), yazTip(v)])
  TOpsiyonel(i) -> dugum("topsiyonel", [yazTip(i)])
  TIslev(p, r) -> dugum("tislev", [dizi(p.map(|x| yazTip(x))), yazTipOps(r)])
}

fn yazTipOps(t: TipD?) -> String {
  if t == none {
    return "-"
  }
  return yazTip(t!)
}

fn yazParametre(p: Parametre) -> String =
  konumla(dugum("parametre",
                [tirnakla(p.ad), yazTipOps(p.tip), yazIfadeOps(p.varsayilan)]),
          p.konum)

// --- ifade yazımı ---------------------------------------------------------

fn yazIfadeD(d: IfadeD) -> String = konumla(yazIfade(d.ic), d.konum)

fn yazIfade(e: Ifade) -> String = match e {
  ITam(ham) -> dugum("int", [tamMetni(ham)])
  IOndalik(ham) -> dugum("float", [ondalikMetni(ham)])
  IMantik(b) -> dugum("bool", [mantik(b)])
  IBos -> dugum("none", [])
  IMetin(parcalar) -> dugum("metin", [dizi(parcalar.map(|p| yazParca(p)))])
  IAd(ad) -> dugum("ad", [tirnakla(ad)])
  IBen -> dugum("self", [])
  IListe(ogeler) -> dugum("liste", [dizi(ogeler.map(|o| yazIfadeD(o)))])
  ITuple(ogeler) -> dugum("tuple", [dizi(ogeler.map(|o| yazIfadeD(o)))])
  IEsleme(ciftler) -> dugum("esleme", [dizi(ciftler.map(|c| yazCift(c)))])
  IStruct(ad, targs, alanlar) -> dugum("structlit", [
    tirnakla(ad),
    dizi(targs.map(|t| yazTip(t))),
    dizi(alanlar.map(|a| yazAlanDegeri(a)))
  ])
  ITekli(op, x) -> dugum("tekli", [tirnakla(op), yazIfadeD(x)])
  IIkili(op, sol, sag) -> dugum("ikili", [tirnakla(op), yazIfadeD(sol), yazIfadeD(sag)])
  IAralik(bas, son, dahil) -> dugum("aralik", [yazIfadeD(bas), yazIfadeD(son), mantik(dahil)])
  ICagri(hedef, args, adlar) -> dugum("cagri", [yazIfadeD(hedef), dizi(args.map(|a| yazIfadeD(a))), dizi(adlar.map(|a| if a == "" { "-" } else { tirnakla(a) }))])
  IDizin(nesne, dizin) -> dugum("dizin", [yazIfadeD(nesne), yazIfadeD(dizin)])
  IAlan(nesne, ad, guvenli) -> dugum("alanerisim", [yazIfadeD(nesne), tirnakla(ad), mantik(guvenli)])
  IAc(x) -> dugum("ac", [yazIfadeD(x)])
  ISoru(x) -> dugum("soru", [yazIfadeD(x)])
  ILambda(params, ret, govde) -> dugum("lambda", [
    dizi(params.map(|p| yazParametre(p))),
    yazTipOps(ret),
    yazGovde(govde)
  ])
  IEger(kosul, ise, yoksa) -> dugum("egerifade", [yazIfadeD(kosul), yazIfadeD(ise), yazIfadeD(yoksa)])
  IBlok(b) -> dugum("blokifade", [yazBlok(b)])
  IMatch(konu, kollar) -> dugum("matchifade", [yazIfadeD(konu), dizi(kollar.map(|k| yazKol(k)))])
}

fn yazParca(p: MetinParcasi) -> String = match p {
  Duz(s) -> dugum("duz", [tirnakla(s)])
  Gomme(e) -> dugum("gomme", [yazIfadeD(e)])
}

fn yazCift(c: IfadeCifti) -> String =
  dugum("cift", [yazIfadeD(c.anahtar), yazIfadeD(c.deger)])

fn yazAlanDegeri(a: AlanDegeri) -> String =
  dugum("alan", [tirnakla(a.ad), yazIfadeD(a.deger)])

fn yazGovde(g: Govde) -> String = match g {
  GBlok(b) -> yazBlok(b)
  GDeyim(d) -> yazDeyimD(d)
  GIfade(e) -> yazIfadeD(e)
}

// --- desen yazımı ---------------------------------------------------------

fn yazDesenD(d: DesenD) -> String = konumla(yazDesen(d.ic), d.konum)

fn yazDesen(d: Desen) -> String = match d {
  DJoker -> dugum("joker", [])
  DBaglama(ad) -> dugum("baglama", [tirnakla(ad)])
  DDeger(e) -> dugum("deger", [yazIfadeD(e)])
  DAralik(alt, ust, kapsayan) -> dugum("aralik", [yazIfadeD(alt), yazIfadeD(ust), mantik(kapsayan)])
  DVaryant(enumAdi, varyant, altlar) -> dugum("varyant", [
    if enumAdi == none { "-" } else { tirnakla(enumAdi!) },
    tirnakla(varyant),
    dizi(altlar.map(|a| yazDesenD(a)))
  ])
}

fn yazKol(k: Kol) -> String =
  konumla(dugum("kol", [yazDesenD(k.desen), yazGovde(k.govde), yazIfadeOps(k.kosul)]), k.konum)

// --- deyim yazımı ---------------------------------------------------------

fn yazBlok(b: Blok) -> String =
  konumla(dugum("blok", [dizi(b.deyimler.map(|d| yazDeyimD(d)))]), b.konum)

fn yazIfadeOps(e: IfadeD?) -> String {
  if e == none {
    return "-"
  }
  return yazIfadeD(e!)
}

fn yazDeyimD(d: DeyimD) -> String = konumla(yazDeyim(d.ic), d.konum)

fn yazDeyim(s: Deyim) -> String = match s {
  SLet(ad, tip, deger, degisebilir, adlar) -> dugum("let", [
    tirnakla(ad), yazTipOps(tip), yazIfadeOps(deger), mantik(degisebilir),
    dizi(adlar.map(|a| tirnakla(a)))
  ])
  SAtama(op, hedef, deger) -> dugum("atama", [tirnakla(op), yazIfadeD(hedef), yazIfadeD(deger)])
  SIfade(e) -> dugum("ifadedeyimi", [yazIfadeD(e)])
  SDonus(e) -> dugum("donus", [yazIfadeOps(e)])
  SEger(kosul, ise, yoksa) -> dugum("eger", [yazIfadeD(kosul), yazBlok(ise), yazYoksa(yoksa)])
  SEgerBag(ad, kaynak, ise, yoksa) -> dugum("egerbag", [
    tirnakla(ad), yazIfadeD(kaynak), yazBlok(ise), yazYoksa(yoksa)
  ])
  SWhile(kosul, govde, bagAd, bagIfade) -> dugum("while", [yazIfadeOps(kosul), yazBlok(govde), if bagAd == "" { "-" } else { tirnakla(bagAd) }, yazIfadeOps(bagIfade)])
  SFor(adlar, kaynak, govde) -> dugum("for", [
    dizi(adlar.map(|a| tirnakla(a))), yazIfadeD(kaynak), yazBlok(govde)
  ])
  SMatch(konu, kollar) -> dugum("match", [yazIfadeD(konu), dizi(kollar.map(|k| yazKol(k)))])
  SBreak -> dugum("break", [])
  SContinue -> dugum("continue", [])
}

fn yazYoksa(y: Yoksa) -> String = match y {
  YYok -> "-"
  YBlok(b) -> yazBlok(b)
  YEger(d) -> yazDeyimD(d)
}

// --- üst düzey yazım ------------------------------------------------------

fn yazSinir(s: TipSiniri) -> String =
  dugum("sinir", [tirnakla(s.ad), dizi(s.arayuzler.sort().map(|a| tirnakla(a)))])

fn yazIslev(f: IslevBildirimi) -> String = konumla(yazIslevGovdesi(f), f.konum)

fn yazIslevGovdesi(f: IslevBildirimi) -> String = dugum("fn", [
  tirnakla(f.ad),
  dizi(f.tipParametreleri.map(|t| tirnakla(t))),
  dizi(f.tipSinirlari.map(|s| yazSinir(s))),
  dizi(f.parametreler.map(|p| yazParametre(p))),
  yazTipOps(f.donusTipi),
  if f.govde == none { "-" } else { yazBlok(f.govde!) }
])

fn yazAlanBildirimi(a: AlanBildirimi) -> String =
  konumla(dugum("alandecl",
                [tirnakla(a.ad), yazTip(a.tip), mantik(a.degisebilir),
                 yazIfadeOps(a.varsayilan)]),
          a.konum)

fn yazVaryantBildirimi(v: VaryantBildirimi) -> String =
  konumla(dugum("varyantdecl", [tirnakla(v.ad), dizi(v.yuk.map(|t| yazTip(t)))]), v.konum)

fn yazOgeD(o: OgeD) -> String = konumla(yazOge(o.ic), o.konum)

fn yazOge(o: Oge) -> String = match o {
  OImport(yol) -> dugum("import", [tirnakla(yol)])
  OTypeAlias(ad, hedef) -> dugum("typealias", [tirnakla(ad), yazTip(hedef)])
  // Konumu dıştaki `yazOgeD` ekler; burada ikinci kez sarmalanmaz.
  OIslev(f) -> yazIslevGovdesi(f)
  OStruct(ad, tparams, arayuzler, alanlar, metotlar) -> dugum("struct", [
    tirnakla(ad),
    dizi(tparams.map(|t| tirnakla(t))),
    dizi(arayuzler.map(|i| tirnakla(i))),
    dizi(alanlar.map(|a| yazAlanBildirimi(a))),
    dizi(metotlar.map(|m| yazIslev(m)))
  ])
  OEnum(ad, tparams, arayuzler, varyantlar, metotlar) -> dugum("enum", [
    tirnakla(ad),
    dizi(tparams.map(|t| tirnakla(t))),
    dizi(arayuzler.map(|i| tirnakla(i))),
    dizi(varyantlar.map(|v| yazVaryantBildirimi(v))),
    dizi(metotlar.map(|m| yazIslev(m)))
  ])
  OArayuz(ad, metotlar) -> dugum("interface", [
    tirnakla(ad), dizi(metotlar.map(|m| yazIslev(m)))
  ])
  OLet(d) -> yazDeyim(d.ic)
}

// Konumsuz S-ifadesi: iki çözümleyicinin ağaç *yapısını* karşılaştırır.
fn yazModul(m: Modul) -> String {
  KONUM_YAZ = false
  return dugum("modul", [dizi(m.ogeler.map(|o| yazOgeD(o)))])
}

// Konumlu S-ifadesi: satır/sütun hesabını da karşılaştırır.
fn yazModulKonumlu(m: Modul) -> String {
  KONUM_YAZ = true
  let sonuc = dugum("modul", [dizi(m.ogeler.map(|o| yazOgeD(o)))])
  KONUM_YAZ = false
  return sonuc
}
