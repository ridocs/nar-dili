// Nar sözdizim çözümleyici (parser) — **Nar diliyle** yazılmıştır.
//
// Python'daki `narc/parser.py` ile aynı ağacı kurar. Doğruluğunun ölçüsü
// şu: aynı kaynak için birebir aynı S-ifadesini üretmek
// (`testler/test_nar_parser.py` bunu projedeki bütün .nar dosyalarında
// karşılaştırır).
//
// Yöntem: özyinelemeli iniş; ikili işleçler için öncelik tırmanma.
//
// Hata yönetimi: Nar'da istisna yoktur. Çözümleyici ilk hatayı `hata`
// alanına yazar ve durur; bundan sonraki bütün döngüler hemen çıkar, çünkü
// hatalı durumda ilerlemek sonsuz döngü demektir. Sonuç `Cozum` enum'uyla
// bildirilir.
//
// Kütüphane olarak derlenir:
//     nar build derleyici/parser.nar --kutuphane -o cikti/nar-parser.js

import "lexer.nar"
import "ast.nar"

struct CozumHatasi {
  mesaj: String
  satir: Int
  sutun: Int

  fn goster() -> String = "${self.satir}:${self.sutun} — ${self.mesaj}"
}

enum Cozum {
  CTamam(Modul)
  CHata(CozumHatasi)
}

// --- öncelikler -----------------------------------------------------------

// Büyük sayı daha sıkı bağlar. 0 = ikili işleç değil.
fn oncelik(tur: String) -> Int {
  if tur == "??" {
    return 1
  }
  if tur == "||" {
    return 2
  }
  if tur == "&&" {
    return 3
  }
  if tur == "==" || tur == "!=" {
    return 4
  }
  if tur == "<" || tur == "<=" || tur == ">" || tur == ">=" {
    return 5
  }
  if tur == ".." || tur == "..=" {
    return 6
  }
  if tur == "+" || tur == "-" {
    return 7
  }
  if tur == "*" || tur == "/" || tur == "%" {
    return 8
  }
  return 0
}

let ATAMA_ISLECLERI = ["=", "+=", "-=", "*=", "/=", "%="]

// Boş yer tutucular: hata sonrası döndürülür, kimse okumaz.
let BOS_TIP = TAd("", [])

fn bosBlok(k: Konum) -> Blok = Blok { konum: k, deyimler: [] }

// ==========================================================================

struct Cozumleyici {
  tokenlar: [Token]
  var i: Int

  // `if`/`while`/`for` başlığında `{` blok açar; orada struct ve eşleme
  // literali yazılamaz. Bu bayrak onu engeller.
  var structLitYok: Bool

  var hata: CozumHatasi?

  // --- token erişimi ------------------------------------------------------

  fn simdiki() -> Token = self.bakIleri(0)

  fn bakIleri(k: Int) -> Token {
    var j = self.i + k
    if j >= self.tokenlar.len() {
      j = self.tokenlar.len() - 1
    }
    if j < 0 {
      return Token { tur: "eof", metin: "", satir: 0, sutun: 0 }
    }
    return self.tokenlar[j]
  }

  fn tur() -> String = self.simdiki().tur

  // --- konum --------------------------------------------------------------

  fn konum() -> Konum {
    let t = self.simdiki()
    return Konum { satir: t.satir, sutun: t.sutun }
  }

  fn tokenKonumu(t: Token) -> Konum = Konum { satir: t.satir, sutun: t.sutun }

  // İfadeyi konumuyla sarar.
  fn ifadeD(k: Konum, e: Ifade) -> IfadeD = IfadeD { konum: k, ic: e }

  fn deyimD(k: Konum, d: Deyim) -> DeyimD = DeyimD { konum: k, ic: d }

  fn desenD(k: Konum, d: Desen) -> DesenD = DesenD { konum: k, ic: d }

  fn suradaMi(t: String) -> Bool = self.tur() == t

  fn suradaMi2(a: String, b: String) -> Bool {
    let t = self.tur()
    return t == a || t == b
  }

  fn ilerle() -> Token {
    let t = self.simdiki()
    if t.tur != "eof" {
      self.i += 1
    }
    return t
  }

  // Tür uyuyorsa ilerler ve true döner.
  fn al(t: String) -> Bool {
    if self.tur() == t {
      self.ilerle()
      return true
    }
    return false
  }

  // --- hata ---------------------------------------------------------------

  fn hataVer(mesaj: String) {
    if self.hata != none {
      return
    }
    let t = self.simdiki()
    self.hata = CozumHatasi { mesaj: mesaj, satir: t.satir, sutun: t.sutun }
    // Hata sonrası ilerleme durur; döngüler `iyiMi()` ile çıkar.
    self.i = self.tokenlar.len() - 1
  }

  fn iyiMi() -> Bool = self.hata == none

  // Token'ı okunabilir biçimde anlatır (hata mesajları için).
  fn anlat() -> String {
    let t = self.simdiki()
    if t.tur == "eof" {
      return "dosya sonu"
    }
    if t.tur == "newline" {
      return "satır sonu"
    }
    if t.tur == "ident" {
      return "tanımlayıcı '${t.metin}'"
    }
    if t.tur == "int" || t.tur == "float" {
      return "sayı ${t.metin}"
    }
    if t.tur == "string" {
      return "metin literali"
    }
    return "'${t.metin}'"
  }

  // Tür uymazsa hata kaydeder; her durumda token'ı döndürür.
  fn bekle(t: String, ne: String) -> Token {
    if self.tur() == t {
      return self.ilerle()
    }
    self.hataVer("${ne} bekleniyordu, ${self.anlat()} bulundu")
    return self.simdiki()
  }

  fn beklenenAd(ne: String) -> String = self.bekle("ident", ne).metin

  // --- satır sonları ------------------------------------------------------

  fn satirSonlariniAtla() {
    while self.tur() == "newline" {
      self.ilerle()
    }
  }

  fn deyimSonu() {
    if self.tur() == "newline" || self.tur() == ";" {
      self.ilerle()
      self.satirSonlariniAtla()
      return
    }
    if self.tur() == "}" || self.tur() == "eof" {
      return
    }
    self.hataVer("deyim sonu bekleniyordu, ${self.anlat()} bulundu")
  }

  // --- modül --------------------------------------------------------------

  fn modulCozumle() -> Modul {
    let bas = self.konum()
    var ogeler: [OgeD] = []
    self.satirSonlariniAtla()
    while self.iyiMi() && !self.suradaMi("eof") {
      ogeler.push(self.ogeCozumle())
      self.satirSonlariniAtla()
    }
    return Modul { konum: bas, ogeler: ogeler }
  }

  fn ogeCozumle() -> OgeD {
    let k = self.konum()
    return OgeD { konum: k, ic: self.ogeGovdesiCozumle() }
  }

  fn ogeGovdesiCozumle() -> Oge {
    let t = self.tur()
    if t == "import" {
      return self.importCozumle()
    }
    if t == "fn" {
      return OIslev(self.islevCozumle())
    }
    if t == "struct" {
      return self.structCozumle()
    }
    if t == "enum" {
      return self.enumCozumle()
    }
    if t == "interface" {
      return self.arayuzCozumle()
    }
    if t == "type" {
      return self.tipTakmaAdiCozumle()
    }
    if t == "let" || t == "var" {
      let d = self.letCozumle()
      self.deyimSonu()
      return OLet(d)
    }
    self.hataVer("üst düzeyde bildirim bekleniyordu (${self.anlat()} bulundu)")
    return OImport("")
  }

  fn importCozumle() -> Oge {
    self.bekle("import", "'import'")
    let t = self.bekle("string", "içe aktarılacak dosya yolu")
    let parcalar = hamParcalar(t.metin)
    if parcalar.len() != 1 {
      self.hataVer("import yolu düz bir metin olmalı")
      return OImport("")
    }
    var yol = ""
    match parcalar[0] {
      HDuz(s) -> yol = s
      HGomme(_, _) -> self.hataVer("import yolu düz bir metin olmalı")
    }
    self.deyimSonu()
    return OImport(yol)
  }

  fn tipTakmaAdiCozumle() -> Oge {
    self.bekle("type", "'type'")
    let ad = self.beklenenAd("tip adı")
    self.bekle("=", "'='")
    let hedef = self.tipCozumle()
    self.deyimSonu()
    return OTypeAlias(ad, hedef)
  }

  // --- tipler -------------------------------------------------------------

  fn tipCozumle() -> TipD {
    var t = self.temelTipCozumle()
    while self.iyiMi() && self.suradaMi("?") {
      // Opsiyonel işaretinin konumu `?` token'ıdır (Python tarafı da böyle).
      let k = self.konum()
      self.ilerle()
      t = TipD { konum: k, ic: TOpsiyonel(t) }
    }
    return t
  }

  fn temelTipCozumle() -> TipD {
    let t = self.simdiki()
    let k = self.tokenKonumu(t)

    if t.tur == "ident" {
      self.ilerle()
      return TipD { konum: k, ic: TAd(t.metin, self.tipArgumanlariCozumle()) }
    }

    if t.tur == "[" {
      self.ilerle()
      let e = self.tipCozumle()
      self.bekle("]", "']'")
      return TipD { konum: k, ic: TListe(e) }
    }

    if t.tur == "{" {
      self.ilerle()
      let anahtar = self.tipCozumle()
      self.bekle(":", "':'")
      let deger = self.tipCozumle()
      self.bekle("}", "'}'")
      return TipD { konum: k, ic: TEsleme(anahtar, deger) }
    }

    if t.tur == "(" {
      self.ilerle()
      var params: [TipD] = []
      if !self.suradaMi(")") {
        params.push(self.tipCozumle())
        while self.iyiMi() && self.al(",") {
          params.push(self.tipCozumle())
        }
      }
      self.bekle(")", "')'")
      self.bekle("->", "'->' (fonksiyon tipinin dönüş oku)")
      let donus = self.tipCozumle()
      return TipD { konum: k, ic: TIslev(params, donus) }
    }

    self.hataVer("tip bekleniyordu, ${self.anlat()} bulundu")
    return TipD { konum: k, ic: BOS_TIP }
  }

  // Kullanımdaki tip argümanları: `Kutu<Int>` → [Int]
  fn tipArgumanlariCozumle() -> [TipD] {
    if !self.suradaMi("<") {
      return []
    }
    self.ilerle()
    var args: [TipD] = []
    args.push(self.tipCozumle())
    while self.iyiMi() && self.al(",") {
      args.push(self.tipCozumle())
    }
    self.bekle(">", "tip argümanlarını kapatan '>'")
    return args
  }

  // Bildirimdeki tip parametreleri ve arayüz sınırlamaları.
  fn tipParametreleriCozumle() -> TipParametreleri {
    if !self.suradaMi("<") {
      return TipParametreleri { adlar: [], sinirlar: [] }
    }
    self.ilerle()
    var adlar: [String] = []
    var sinirlar: [TipSiniri] = []
    var devam = true
    while self.iyiMi() && devam {
      let ad = self.beklenenAd("tip parametresi adı")
      adlar.push(ad)
      if self.al(":") {
        var bagli = [self.beklenenAd("arayüz adı")]
        while self.iyiMi() && self.al("+") {
          bagli.push(self.beklenenAd("arayüz adı"))
        }
        sinirlar.push(TipSiniri { ad: ad, arayuzler: bagli })
      }
      devam = self.al(",")
    }
    self.bekle(">", "tip parametrelerini kapatan '>'")
    if adlar.len() == 0 {
      self.hataVer("tip parametre listesi boş olamaz")
    }
    return TipParametreleri { adlar: adlar, sinirlar: sinirlar }
  }

  // `struct Nokta: Yazdirilabilir, Karsilastirilabilir {`
  fn arayuzListesiCozumle() -> [String] {
    if !self.al(":") {
      return []
    }
    var adlar = [self.beklenenAd("arayüz adı")]
    while self.iyiMi() && self.al(",") {
      adlar.push(self.beklenenAd("arayüz adı"))
    }
    return adlar
  }

  // --- bildirimler --------------------------------------------------------

  fn islevCozumle() -> IslevBildirimi {
    let bas = self.konum()
    self.bekle("fn", "'fn'")
    let ad = self.beklenenAd("fonksiyon adı")
    let tp = self.tipParametreleriCozumle()
    self.bekle("(", "'('")
    let params = self.parametrelerCozumle()
    self.bekle(")", "')'")

    var donus: TipD? = none
    if self.al("->") {
      donus = self.tipCozumle()
    }

    // Kısa gövde:  fn kare(x: Int) -> Int = x * x
    var govde = bosBlok(bas)
    if self.al("=") {
      self.satirSonlariniAtla()
      let deger = self.ifadeCozumle()
      govde = Blok {
        konum: bas,
        deyimler: [DeyimD { konum: deger.konum, ic: SDonus(deger) }]
      }
    } else {
      govde = self.blokCozumle()
    }

    return IslevBildirimi {
      konum: bas,
      ad: ad,
      tipParametreleri: tp.adlar,
      tipSinirlari: tp.sinirlar,
      parametreler: params,
      donusTipi: donus,
      govde: govde
    }
  }

  fn parametrelerCozumle() -> [Parametre] {
    var params: [Parametre] = []
    self.satirSonlariniAtla()
    var devam = true
    while self.iyiMi() && devam && !self.suradaMi(")") {
      let k = self.konum()
      let ad = self.beklenenAd("parametre adı")
      self.bekle(":", "parametre tipinden önce ':'")
      let tip = self.tipCozumle()
      params.push(Parametre { konum: k, ad: ad, tip: tip })
      self.satirSonlariniAtla()
      devam = self.al(",")
      self.satirSonlariniAtla()
    }
    self.satirSonlariniAtla()
    return params
  }

  fn structCozumle() -> Oge {
    self.bekle("struct", "'struct'")
    let ad = self.beklenenAd("struct adı")
    let tp = self.tipParametreleriCozumle()
    let arayuzler = self.arayuzListesiCozumle()
    self.bekle("{", "'{'")
    self.satirSonlariniAtla()

    var alanlar: [AlanBildirimi] = []
    var metotlar: [IslevBildirimi] = []
    while self.iyiMi() && !self.suradaMi("}") && !self.suradaMi("eof") {
      if self.suradaMi("fn") {
        metotlar.push(self.islevCozumle())
      } else {
        let degisebilir = self.al("var")
        if !degisebilir {
          self.al("let")
        }
        let alanKonumu = self.konum()
        let alanAdi = self.beklenenAd("alan adı")
        self.bekle(":", "alan tipinden önce ':'")
        let tip = self.tipCozumle()
        alanlar.push(AlanBildirimi {
          konum: alanKonumu, ad: alanAdi, tip: tip, degisebilir: degisebilir
        })
      }
      self.satirSonlariniAtla()
    }
    self.bekle("}", "'}'")
    return OStruct(ad, tp.adlar, arayuzler, alanlar, metotlar)
  }

  fn enumCozumle() -> Oge {
    self.bekle("enum", "'enum'")
    let ad = self.beklenenAd("enum adı")
    let tp = self.tipParametreleriCozumle()
    let arayuzler = self.arayuzListesiCozumle()
    self.bekle("{", "'{'")
    self.satirSonlariniAtla()

    var varyantlar: [VaryantBildirimi] = []
    var metotlar: [IslevBildirimi] = []
    while self.iyiMi() && !self.suradaMi("}") && !self.suradaMi("eof") {
      if self.suradaMi("fn") {
        metotlar.push(self.islevCozumle())
      } else {
        let vKonum = self.konum()
        let vAd = self.beklenenAd("varyant adı")
        var yuk: [TipD] = []
        if self.al("(") {
          yuk.push(self.tipCozumle())
          while self.iyiMi() && self.al(",") {
            yuk.push(self.tipCozumle())
          }
          self.bekle(")", "')'")
        }
        varyantlar.push(VaryantBildirimi { konum: vKonum, ad: vAd, yuk: yuk })
      }
      self.satirSonlariniAtla()
    }
    self.bekle("}", "'}'")
    return OEnum(ad, tp.adlar, arayuzler, varyantlar, metotlar)
  }

  fn arayuzCozumle() -> Oge {
    self.bekle("interface", "'interface'")
    let ad = self.beklenenAd("arayüz adı")
    self.bekle("{", "'{'")
    self.satirSonlariniAtla()

    var metotlar: [IslevBildirimi] = []
    while self.iyiMi() && !self.suradaMi("}") && !self.suradaMi("eof") {
      metotlar.push(self.arayuzMetoduCozumle(ad))
      self.satirSonlariniAtla()
    }
    self.bekle("}", "'}'")
    if self.iyiMi() && metotlar.len() == 0 {
      self.hataVer("'${ad}' arayüzü en az bir metot içermeli")
    }
    return OArayuz(ad, metotlar)
  }

  // Arayüzdeki metot yalnızca imzadır; gövdesi yoktur.
  fn arayuzMetoduCozumle(sahip: String) -> IslevBildirimi {
    let bas = self.konum()
    self.bekle("fn", "arayüz içinde 'fn'")
    let ad = self.beklenenAd("metot adı")
    self.bekle("(", "'('")
    let params = self.parametrelerCozumle()
    self.bekle(")", "')'")
    var donus: TipD? = none
    if self.al("->") {
      donus = self.tipCozumle()
    }
    if self.suradaMi("{") {
      self.hataVer("'${sahip}.${ad}' arayüzde gövde alamaz")
    }
    return IslevBildirimi {
      konum: bas,
      ad: ad,
      tipParametreleri: [],
      tipSinirlari: [],
      parametreler: params,
      donusTipi: donus,
      govde: bosBlok(bas)
    }
  }

  // --- deyimler -----------------------------------------------------------

  fn blokCozumle() -> Blok {
    let bas = self.konum()
    self.bekle("{", "'{'")
    self.satirSonlariniAtla()
    var deyimler: [DeyimD] = []
    while self.iyiMi() && !self.suradaMi("}") {
      if self.suradaMi("eof") {
        self.hataVer("kapatılmamış blok: '}' bekleniyor")
        return Blok { konum: bas, deyimler: deyimler }
      }
      deyimler.push(self.deyimCozumle())
      self.satirSonlariniAtla()
    }
    self.bekle("}", "'}'")
    return Blok { konum: bas, deyimler: deyimler }
  }

  fn deyimCozumle() -> DeyimD {
    let t = self.tur()
    let k = self.konum()

    if t == "let" || t == "var" {
      let d = self.letCozumle()
      self.deyimSonu()
      return d
    }

    if t == "return" {
      self.ilerle()
      var deger: IfadeD? = none
      if !self.satirSonuMu() {
        deger = self.ifadeCozumle()
      }
      self.deyimSonu()
      return self.deyimD(k, SDonus(deger))
    }

    if t == "if" {
      return self.egerCozumle()
    }
    if t == "while" {
      return self.whileCozumle()
    }
    if t == "for" {
      return self.forCozumle()
    }
    if t == "match" {
      return self.matchDeyimiCozumle()
    }

    if t == "break" {
      self.ilerle()
      self.deyimSonu()
      return self.deyimD(k, SBreak)
    }
    if t == "continue" {
      self.ilerle()
      self.deyimSonu()
      return self.deyimD(k, SContinue)
    }

    let e = self.ifadeCozumle()
    if ATAMA_ISLECLERI.contains(self.tur()) {
      let opKonumu = self.konum()
      let op = self.ilerle().metin
      let deger = self.ifadeCozumle()
      if !atanabilirMi(e.ic) {
        self.hataVer("bu ifadeye atama yapılamaz")
      }
      self.deyimSonu()
      return self.deyimD(opKonumu, SAtama(op, e, deger))
    }
    self.deyimSonu()
    // İfade deyiminin konumu ifadenin kendi konumudur.
    return self.deyimD(e.konum, SIfade(e))
  }

  fn satirSonuMu() -> Bool {
    let t = self.tur()
    return t == "newline" || t == "}" || t == ";" || t == "eof"
  }

  fn letCozumle() -> DeyimD {
    let k = self.konum()
    let anahtar = self.ilerle()          // let | var
    let degisebilir = anahtar.tur == "var"
    let ad = self.beklenenAd("değişken adı")

    var tip: TipD? = none
    if self.al(":") {
      tip = self.tipCozumle()
    }
    var deger: IfadeD? = none
    if self.al("=") {
      deger = self.ifadeCozumle()
    }

    if deger == none && tip == none {
      self.hataVer("'${ad}' için tip ya da başlangıç değeri gerekli")
    }
    if deger == none && !degisebilir {
      self.hataVer("değişmez '${ad}' bildiriminde başlangıç değeri zorunlu")
    }
    return self.deyimD(k, SLet(ad, tip, deger, degisebilir))
  }

  // Koşul ifadesi: `{` blok başlangıcı sayıldığı için literal kapalıdır.
  fn kosulCozumle() -> IfadeD {
    let onceki = self.structLitYok
    self.structLitYok = true
    let e = self.ifadeCozumle()
    self.structLitYok = onceki
    return e
  }

  fn egerCozumle() -> DeyimD {
    let k = self.konum()
    self.bekle("if", "'if'")
    let kosul = self.kosulCozumle()
    let ise = self.blokCozumle()

    // `}` ile `else` arasındaki satır sonunu hoş gör.
    let kayit = self.i
    self.satirSonlariniAtla()
    if self.suradaMi("else") {
      self.ilerle()
      if self.suradaMi("if") {
        return self.deyimD(k, SEger(kosul, ise, YEger(self.egerCozumle())))
      }
      return self.deyimD(k, SEger(kosul, ise, YBlok(self.blokCozumle())))
    }
    self.i = kayit
    return self.deyimD(k, SEger(kosul, ise, YYok))
  }

  fn whileCozumle() -> DeyimD {
    let k = self.konum()
    self.bekle("while", "'while'")
    let kosul = self.kosulCozumle()
    return self.deyimD(k, SWhile(kosul, self.blokCozumle()))
  }

  fn forCozumle() -> DeyimD {
    let k = self.konum()
    self.bekle("for", "'for'")
    var adlar: [String] = []
    if self.al("(") {
      adlar.push(self.beklenenAd("döngü değişkeni"))
      while self.iyiMi() && self.al(",") {
        adlar.push(self.beklenenAd("döngü değişkeni"))
      }
      self.bekle(")", "')'")
    } else {
      adlar.push(self.beklenenAd("döngü değişkeni"))
    }
    self.bekle("in", "'in'")
    let kaynak = self.kosulCozumle()
    return self.deyimD(k, SFor(adlar, kaynak, self.blokCozumle()))
  }

  fn matchDeyimiCozumle() -> DeyimD {
    let k = self.konum()
    self.bekle("match", "'match'")
    let konu = self.kosulCozumle()
    self.bekle("{", "'{'")
    self.satirSonlariniAtla()

    var kollar: [Kol] = []
    while self.iyiMi() && !self.suradaMi("}") {
      if self.suradaMi("eof") {
        self.hataVer("kapatılmamış match: '}' bekleniyor")
        return self.deyimD(k, SMatch(konu, kollar))
      }
      let desen = self.desenCozumle()
      let okKonumu = self.konum()
      self.bekle("->", "desenden sonra '->'")
      var govde = GIfade(self.ifadeD(okKonumu, IBos))
      if self.suradaMi("{") {
        govde = GBlok(self.blokCozumle())
      } else {
        govde = GDeyim(self.deyimCozumle())
      }
      kollar.push(Kol { konum: okKonumu, desen: desen, govde: govde })
      self.satirSonlariniAtla()
    }
    self.bekle("}", "'}'")
    if self.iyiMi() && kollar.len() == 0 {
      self.hataVer("match en az bir dal içermeli")
    }
    return self.deyimD(k, SMatch(konu, kollar))
  }

  // --- desenler -----------------------------------------------------------

  fn desenCozumle() -> DesenD {
    let t = self.simdiki()
    let k = self.tokenKonumu(t)

    // `_` lexer'da tanımlayıcı olarak gelir (ident başlangıcı sayılır),
    // ama desende her zaman jokerdir: bir değere bağlanmaz.
    if t.tur == "ident" && t.metin == "_" {
      self.ilerle()
      return self.desenD(k, DJoker)
    }

    if t.tur == "int" || t.tur == "float" || t.tur == "string" ||
      t.tur == "true" || t.tur == "false" || t.tur == "none" {
      return self.desenD(k, DDeger(self.temelIfadeCozumle()))
    }

    if t.tur == "-" && (self.bakIleri(1).tur == "int" || self.bakIleri(1).tur == "float") {
      return self.desenD(k, DDeger(self.tekliCozumle()))
    }

    // `.Varyant` — enum adı bağlamdan çıkarılır
    if t.tur == "." {
      self.ilerle()
      let varyant = self.beklenenAd("varyant adı")
      return self.desenD(k, DVaryant(none, varyant, self.altDesenlerCozumle()))
    }

    if t.tur == "ident" {
      self.ilerle()
      if self.al(".") {
        let varyant = self.beklenenAd("varyant adı")
        return self.desenD(k, DVaryant(t.metin, varyant, self.altDesenlerCozumle()))
      }
      if self.suradaMi("(") {
        return self.desenD(k, DVaryant(none, t.metin, self.altDesenlerCozumle()))
      }
      return self.desenD(k, DBaglama(t.metin))
    }

    self.hataVer("desen bekleniyordu, ${self.anlat()} bulundu")
    return self.desenD(k, DJoker)
  }

  fn altDesenlerCozumle() -> [DesenD] {
    if !self.al("(") {
      return []
    }
    var altlar: [DesenD] = []
    if !self.suradaMi(")") {
      altlar.push(self.desenCozumle())
      while self.iyiMi() && self.al(",") {
        altlar.push(self.desenCozumle())
      }
    }
    self.bekle(")", "')'")
    return altlar
  }

  // --- ifadeler -----------------------------------------------------------

  fn ifadeCozumle() -> IfadeD = self.ifadeCozumleP(0)

  fn ifadeCozumleP(enAzOncelik: Int) -> IfadeD {
    var sol = self.tekliCozumle()

    while self.iyiMi() {
      let tur = self.tur()
      let p = oncelik(tur)
      if p == 0 || p < enAzOncelik {
        return sol
      }
      // İkili düğümün konumu işlecin konumudur (Python tarafı da böyle).
      let opKonumu = self.konum()
      self.ilerle()
      self.satirSonlariniAtla()    // işleçten sonra satır bölünebilir

      let sag = self.ifadeCozumleP(p + 1)
      if tur == ".." || tur == "..=" {
        sol = self.ifadeD(opKonumu, IAralik(sol, sag, tur == "..="))
      } else {
        sol = self.ifadeD(opKonumu, IIkili(tur, sol, sag))
      }
    }
    return sol
  }

  fn tekliCozumle() -> IfadeD {
    if self.suradaMi2("-", "!") {
      let k = self.konum()
      let op = self.ilerle().tur
      return self.ifadeD(k, ITekli(op, self.tekliCozumle()))
    }
    return self.sonEkCozumle()
  }

  fn sonEkCozumle() -> IfadeD {
    var e = self.temelIfadeCozumle()

    while self.iyiMi() {
      let tur = self.tur()
      let k = self.konum()

      if tur == "." {
        self.ilerle()
        e = self.ifadeD(k, IAlan(e, self.beklenenAd("alan ya da metot adı"), false))
        continue
      }
      if tur == "?." {
        self.ilerle()
        e = self.ifadeD(k, IAlan(e, self.beklenenAd("alan ya da metot adı"), true))
        continue
      }
      if tur == "(" {
        self.ilerle()
        e = self.ifadeD(k, ICagri(e, self.argumanlarCozumle()))
        continue
      }
      if tur == "[" {
        self.ilerle()
        self.satirSonlariniAtla()
        let dizin = self.ifadeCozumle()
        self.satirSonlariniAtla()
        self.bekle("]", "']'")
        e = self.ifadeD(k, IDizin(e, dizin))
        continue
      }
      if tur == "!" {
        self.ilerle()
        e = self.ifadeD(k, IAc(e))
        continue
      }
      if tur == "{" && self.structLitVarMi(e.ic) {
        e = self.structLitCozumle(e.ic, [])
        continue
      }
      if tur == "<" && self.genericStructLitVarMi(e.ic) {
        let targs = self.tipArgumanlariCozumle()
        e = self.structLitCozumle(e.ic, targs)
        continue
      }
      return e
    }
    return e
  }

  // `Nokta { x: 1 }` mi, yoksa `{` bir blok mu?
  fn structLitVarMi(e: Ifade) -> Bool {
    if self.structLitYok {
      return false
    }
    if !buyukHarfliAdMi(e) {
      return false
    }
    var j = 1
    while self.bakIleri(j).tur == "newline" {
      j += 1
    }
    if self.bakIleri(j).tur == "}" {
      return true
    }
    return self.bakIleri(j).tur == "ident" && self.bakIleri(j + 1).tur == ":"
  }

  // `Kutu<Int> {` mi, yoksa `a < b` mi? Tip listesini deneme okur, geri sarar.
  fn genericStructLitVarMi(e: Ifade) -> Bool {
    if self.structLitYok {
      return false
    }
    if !buyukHarfliAdMi(e) {
      return false
    }

    let kayit = self.i
    let hataKaydi = self.hata
    self.tipArgumanlariCozumle()
    if self.hata != none {
      self.i = kayit
      self.hata = hataKaydi
      return false
    }

    var j = 0
    while self.bakIleri(j).tur == "newline" {
      j += 1
    }
    let uygun = self.bakIleri(j).tur == "{"
    self.i = kayit
    return uygun
  }

  fn structLitCozumle(tipIfadesi: Ifade, targs: [TipD]) -> IfadeD {
    self.satirSonlariniAtla()
    let k = self.konum()
    self.bekle("{", "'{'")
    self.satirSonlariniAtla()

    var alanlar: [AlanDegeri] = []
    let onceki = self.structLitYok
    self.structLitYok = false
    var devam = true
    while self.iyiMi() && devam && !self.suradaMi("}") {
      let ad = self.beklenenAd("alan adı")
      self.bekle(":", "alan değerinden önce ':'")
      self.satirSonlariniAtla()
      alanlar.push(AlanDegeri { ad: ad, deger: self.ifadeCozumle() })
      self.satirSonlariniAtla()
      devam = self.al(",")
      self.satirSonlariniAtla()
    }
    self.structLitYok = onceki

    self.satirSonlariniAtla()
    self.bekle("}", "'}'")
    return self.ifadeD(k, IStruct(adiniAl(tipIfadesi), targs, alanlar))
  }

  fn argumanlarCozumle() -> [IfadeD] {
    var args: [IfadeD] = []
    let onceki = self.structLitYok
    self.structLitYok = false

    self.satirSonlariniAtla()
    var devam = true
    while self.iyiMi() && devam && !self.suradaMi(")") {
      args.push(self.ifadeCozumle())
      self.satirSonlariniAtla()
      devam = self.al(",")
      self.satirSonlariniAtla()
    }
    self.satirSonlariniAtla()

    self.structLitYok = onceki
    self.bekle(")", "')'")
    return args
  }

  fn temelIfadeCozumle() -> IfadeD {
    let t = self.simdiki()
    let k = self.tokenKonumu(t)

    if t.tur == "int" {
      self.ilerle()
      return self.ifadeD(k, ITam(t.metin))
    }
    if t.tur == "float" {
      self.ilerle()
      return self.ifadeD(k, IOndalik(t.metin))
    }
    if t.tur == "true" || t.tur == "false" {
      self.ilerle()
      return self.ifadeD(k, IMantik(t.tur == "true"))
    }
    if t.tur == "none" {
      self.ilerle()
      return self.ifadeD(k, IBos)
    }
    if t.tur == "string" {
      self.ilerle()
      return self.ifadeD(k, self.metinCozumle(t.metin, k))
    }
    if t.tur == "self" {
      self.ilerle()
      return self.ifadeD(k, IBen)
    }
    if t.tur == "ident" {
      self.ilerle()
      return self.ifadeD(k, IAd(t.metin))
    }

    if t.tur == "(" {
      self.ilerle()
      let onceki = self.structLitYok
      self.structLitYok = false
      self.satirSonlariniAtla()
      let ic = self.ifadeCozumle()
      self.satirSonlariniAtla()
      self.structLitYok = onceki
      self.bekle(")", "')'")
      // Parantez yeni bir düğüm kurmaz; içerideki ifadenin konumu korunur.
      return ic
    }

    if t.tur == "[" {
      return self.listeLitCozumle()
    }

    if t.tur == "{" && !self.structLitYok {
      return self.eslemeLitCozumle()
    }

    if t.tur == "if" {
      return self.egerIfadesiCozumle()
    }
    if t.tur == "match" {
      return self.matchIfadesiCozumle()
    }
    if t.tur == "|" || t.tur == "||" {
      return self.lambdaCozumle()
    }
    if t.tur == "fn" {
      let d = self.islevCozumle()
      return self.ifadeD(k, ILambda(
        d.parametreler, d.donusTipi, GBlok(d.govde ?? bosBlok(k))))
    }

    self.hataVer("ifade bekleniyordu, ${self.anlat()} bulundu")
    return self.ifadeD(k, IBos)
  }

  fn listeLitCozumle() -> IfadeD {
    let k = self.konum()
    self.bekle("[", "'['")
    var ogeler: [IfadeD] = []
    let onceki = self.structLitYok
    self.structLitYok = false

    self.satirSonlariniAtla()
    var devam = true
    while self.iyiMi() && devam && !self.suradaMi("]") {
      ogeler.push(self.ifadeCozumle())
      self.satirSonlariniAtla()
      devam = self.al(",")
      self.satirSonlariniAtla()
    }
    self.satirSonlariniAtla()

    self.structLitYok = onceki
    self.bekle("]", "']'")
    return self.ifadeD(k, IListe(ogeler))
  }

  fn eslemeLitCozumle() -> IfadeD {
    let k = self.konum()
    self.bekle("{", "'{'")
    var ciftler: [IfadeCifti] = []
    let onceki = self.structLitYok
    self.structLitYok = false

    self.satirSonlariniAtla()
    var devam = true
    while self.iyiMi() && devam && !self.suradaMi("}") {
      let anahtar = self.ifadeCozumle()
      self.bekle(":", "eşleme değerinden önce ':'")
      self.satirSonlariniAtla()
      ciftler.push(IfadeCifti { anahtar: anahtar, deger: self.ifadeCozumle() })
      self.satirSonlariniAtla()
      devam = self.al(",")
      self.satirSonlariniAtla()
    }
    self.satirSonlariniAtla()

    self.structLitYok = onceki
    self.bekle("}", "'}'")
    return self.ifadeD(k, IEsleme(ciftler))
  }

  // `{ ifade }` ya da `{ deyimler...  son_ifade }` — dal gövdesi.
  fn parantezliIfadeCozumle() -> IfadeD = blokIfadesi(self.dalGovdesiCozumle())

  // Dal gövdesini blok olarak okur.
  fn dalGovdesiCozumle() -> Blok {
    let bas = self.konum()
    self.bekle("{", "'{'")
    self.satirSonlariniAtla()
    let onceki = self.structLitYok
    self.structLitYok = false

    var deyimler: [DeyimD] = []
    while self.iyiMi() && !self.suradaMi("}") {
      if self.suradaMi("eof") {
        self.hataVer("kapatılmamış dal: '}' bekleniyor")
        self.structLitYok = onceki
        return Blok { konum: bas, deyimler: deyimler }
      }
      deyimler.push(self.deyimCozumle())
      self.satirSonlariniAtla()
    }

    self.structLitYok = onceki
    self.bekle("}", "'}'")
    return Blok { konum: bas, deyimler: deyimler }
  }

  // match *ifadesi* kolunun gövdesi.
  //
  // `{` iki anlama gelebilir: blok gövdesi ya da eşleme literali
  // (`Bir -> {"a": 1}`). Önce blok denenir; deyim olarak okunamıyorsa
  // geri sarılıp ifade olarak okunur.
  fn kolDegeriCozumle() -> IfadeD {
    let kayit = self.i
    let hataKaydi = self.hata
    let bayrak = self.structLitYok

    if self.suradaMi("{") {
      let b = self.dalGovdesiCozumle()
      // Boş `{}` blok değil, boş eşleme literalidir.
      if self.hata == none && b.deyimler.len() > 0 {
        return blokIfadesi(b)
      }
      self.i = kayit
      self.hata = hataKaydi
      self.structLitYok = bayrak
    }

    self.structLitYok = false
    let e = self.ifadeCozumle()
    self.structLitYok = bayrak
    return e
  }

  fn egerIfadesiCozumle() -> IfadeD {
    let k = self.konum()
    self.bekle("if", "'if'")
    let kosul = self.kosulCozumle()
    let ise = self.parantezliIfadeCozumle()

    self.satirSonlariniAtla()
    if !self.suradaMi("else") {
      self.hataVer("değer üreten 'if' için 'else' zorunlu")
      return self.ifadeD(k, IBos)
    }
    self.ilerle()
    if self.suradaMi("if") {
      return self.ifadeD(k, IEger(kosul, ise, self.egerIfadesiCozumle()))
    }
    return self.ifadeD(k, IEger(kosul, ise, self.parantezliIfadeCozumle()))
  }

  fn matchIfadesiCozumle() -> IfadeD {
    let k = self.konum()
    self.bekle("match", "'match'")
    let konu = self.kosulCozumle()
    self.bekle("{", "'{'")
    self.satirSonlariniAtla()

    var kollar: [Kol] = []
    while self.iyiMi() && !self.suradaMi("}") {
      if self.suradaMi("eof") {
        self.hataVer("kapatılmamış match: '}' bekleniyor")
        return self.ifadeD(k, IMatch(konu, kollar))
      }
      let desen = self.desenCozumle()
      let okKonumu = self.konum()
      self.bekle("->", "desenden sonra '->'")
      kollar.push(Kol {
        konum: okKonumu, desen: desen, govde: GIfade(self.kolDegeriCozumle())
      })
      self.satirSonlariniAtla()
    }
    self.bekle("}", "'}'")
    if self.iyiMi() && kollar.len() == 0 {
      self.hataVer("match en az bir dal içermeli")
    }
    return self.ifadeD(k, IMatch(konu, kollar))
  }

  fn lambdaCozumle() -> IfadeD {
    let k = self.konum()
    let acilis = self.ilerle()          // `|` ya da `||` (parametresiz)
    var params: [Parametre] = []

    if acilis.tur == "|" {
      var devam = true
      while self.iyiMi() && devam && !self.suradaMi("|") {
        let pKonum = self.konum()
        let ad = self.beklenenAd("lambda parametresi")
        var tip: TipD? = none
        if self.al(":") {
          tip = self.tipCozumle()
        }
        params.push(Parametre { konum: pKonum, ad: ad, tip: tip })
        devam = self.al(",")
      }
      self.bekle("|", "lambda parametrelerini kapatan '|'")
    }

    var donus: TipD? = none
    if self.al("->") {
      donus = self.tipCozumle()
    }

    if self.suradaMi("{") {
      return self.ifadeD(k, ILambda(params, donus, GBlok(self.blokCozumle())))
    }
    return self.ifadeD(k, ILambda(params, donus, GIfade(self.ifadeCozumle())))
  }

  // --- metin literali -----------------------------------------------------

  // Ham metni (tırnaklarıyla) parçalara ayırır; gömmeler yeniden çözümlenir.
  fn metinCozumle(ham: String, k: Konum) -> Ifade {
    var parcalar: [MetinParcasi] = []
    for hp in hamParcalar(ham) {
      match hp {
        HDuz(s) -> parcalar.push(Duz(s))
        HGomme(kaynak, ofset) -> {
          // Gömme ayrı çözümlenir; içindeki düğümlerin konumu, Python
          // tarafındaki gibi metin literalinin konumuna taşınır.
          // Metin literali tek satırdadır (lexer satır sonunda kapatılmamış
          // metni reddeder), bu yüzden yalnızca sütun kayar.
          let gommeKonumu = Konum { satir: k.satir, sutun: k.sutun + ofset }
          match ifadeMetinden(kaynak) {
            GTamam(e) -> parcalar.push(Gomme(konumuTasi(e, gommeKonumu)))
            GHata(mesaj) -> self.hataVer("metin gömmesinde hata: ${mesaj}")
          }
        }
      }
    }
    return IMetin(parcalar)
  }
}

// Tip parametreleri ve sınırları bir arada döndürmek için.
struct TipParametreleri {
  adlar: [String]
  sinirlar: [TipSiniri]
}

// --- yardımcı işlevler ----------------------------------------------------

// Tek ifadelik blok doğrudan o ifadedir; çoklu blok IBlok olur.
//
// Tek ifade durumunu sarmalamamak hem üretilen kodu sade tutar hem de bu
// özellik eklenmeden önce yazılmış ağaçlarla aynı kalmasını sağlar.
fn blokIfadesi(b: Blok) -> IfadeD {
  if b.deyimler.len() == 1 {
    match b.deyimler[0].ic {
      SIfade(e) -> return e
      _ -> {}
    }
  }
  return IfadeD { konum: b.konum, ic: IBlok(b) }
}

// Atamanın sol tarafı: değişken, alan ya da dizin olmalı.
fn atanabilirMi(e: Ifade) -> Bool = match e {
  IAd(_) -> true
  IAlan(_, _, _) -> true
  IDizin(_, _) -> true
  _ -> false
}

fn buyukHarfliAdMi(e: Ifade) -> Bool = match e {
  IAd(ad) -> ad.len() > 0 && buyukHarfMi(ad.charAt(0))
  _ -> false
}

fn adiniAl(e: Ifade) -> String = match e {
  IAd(ad) -> ad
  _ -> ""
}

// --- metin literalini parçalara ayırma ------------------------------------

enum HamParca {
  HDuz(String)
  // Gömme kaynağı ve ham metin içindeki başlangıç ofseti. Ofset, gömme
  // içindeki düğümlerin konumunu hesaplamak için gerekli.
  HGomme(String, Int)
}

enum GommeSonucu {
  GTamam(IfadeD)
  GHata(String)
}

// Kaçış dizilerini çözer, `${...}` gömmelerini ayırır.
// `ham` tırnaklarıyla birlikte gelir.
fn hamParcalar(ham: String) -> [HamParca] {
  var parcalar: [HamParca] = []
  var tampon = ""
  var i = 1                       // açılış tırnağını atla
  let son = ham.len() - 1         // kapanış tırnağı

  while i < son {
    let c = ham.charAt(i)

    if c == "\\" {
      let kacis = karakter(ham, i + 1)
      i += 2
      if kacis == "n" {
        tampon += "\n"
      } else {
        if kacis == "t" {
          tampon += "\t"
        } else {
          if kacis == "r" {
            tampon += "\r"
          } else {
            if kacis == "u" {
              // \u{XXXX}
              var j = i + 1       // `{` sonrası
              var onaltilik = ""
              while j < son && ham.charAt(j) != "}" {
                onaltilik += ham.charAt(j)
                j += 1
              }
              tampon += koddan(tabandanCevir(onaltilik.lower(), 16))
              i = j + 1
            } else {
              if kacis == "0" {
                tampon += koddan(0)
              } else {
                tampon += kacis
              }
            }
          }
        }
      }
      continue
    }

    if c == "$" && karakter(ham, i + 1) == "{" {
      if tampon.len() > 0 {
        parcalar.push(HDuz(tampon))
        tampon = ""
      }
      i += 2
      let icBas = i
      var derinlik = 1
      var kaynak = ""
      while i < son && derinlik > 0 {
        let d = ham.charAt(i)
        if d == "{" {
          derinlik += 1
          kaynak += d
          i += 1
          continue
        }
        if d == "}" {
          derinlik -= 1
          if derinlik == 0 {
            i += 1
            continue
          }
          kaynak += d
          i += 1
          continue
        }
        if d == "\"" {
          // Gömme içindeki metin literali olduğu gibi kopyalanır.
          kaynak += d
          i += 1
          while i < son && ham.charAt(i) != "\"" {
            if ham.charAt(i) == "\\" {
              kaynak += ham.charAt(i)
              i += 1
            }
            if i < son {
              kaynak += ham.charAt(i)
              i += 1
            }
          }
          if i < son {
            kaynak += ham.charAt(i)
            i += 1
          }
          continue
        }
        kaynak += d
        i += 1
      }
      parcalar.push(HGomme(kaynak, icBas))
      continue
    }

    tampon += c
    i += 1
  }

  // Boş metin de bir düz parçadır: `""` → [Duz("")]. Aksi hâlde parçasız
  // bir metin literali kalır ve iki çözümleyici ayrışır.
  if tampon.len() > 0 || parcalar.len() == 0 {
    parcalar.push(HDuz(tampon))
  }
  return parcalar
}

// Gömme ayrı bir çözümleyiciyle okunur; oradaki satır/sütun gömmenin kendi
// metnine göredir. Python tarafı da bu düğümleri metin literalinin konumuna
// taşır, burada aynısı yapılır.
fn konumuTasi(d: IfadeD, k: Konum) -> IfadeD =
  IfadeD { konum: k, ic: icKonumuTasi(d.ic, k) }

fn icKonumuTasi(e: Ifade, k: Konum) -> Ifade = match e {
  IMetin(parcalar) -> IMetin(parcalar.map(|p| parcaKonumuTasi(p, k)))
  IListe(ogeler) -> IListe(ogeler.map(|o| konumuTasi(o, k)))
  IEsleme(ciftler) -> IEsleme(ciftler.map(|c| IfadeCifti {
    anahtar: konumuTasi(c.anahtar, k), deger: konumuTasi(c.deger, k)
  }))
  IStruct(ad, targs, alanlar) -> IStruct(ad, targs, alanlar.map(
    |a| AlanDegeri { ad: a.ad, deger: konumuTasi(a.deger, k) }))
  ITekli(op, x) -> ITekli(op, konumuTasi(x, k))
  IIkili(op, sol, sag) -> IIkili(op, konumuTasi(sol, k), konumuTasi(sag, k))
  IAralik(bas, son, dahil) -> IAralik(konumuTasi(bas, k), konumuTasi(son, k), dahil)
  ICagri(hedef, args) -> ICagri(konumuTasi(hedef, k), args.map(|a| konumuTasi(a, k)))
  IDizin(nesne, dizin) -> IDizin(konumuTasi(nesne, k), konumuTasi(dizin, k))
  IAlan(nesne, ad, guvenli) -> IAlan(konumuTasi(nesne, k), ad, guvenli)
  IAc(x) -> IAc(konumuTasi(x, k))
  ILambda(params, ret, govde) -> ILambda(
    params.map(|p| Parametre { konum: k, ad: p.ad, tip: p.tip }),
    ret,
    govdeKonumuTasi(govde, k))
  IEger(kosul, ise, yoksa) -> IEger(
    konumuTasi(kosul, k), konumuTasi(ise, k), konumuTasi(yoksa, k))
  IBlok(b) -> IBlok(blokKonumuTasi(b, k))
  IMatch(konu, kollar) -> IMatch(
    konumuTasi(konu, k), kollar.map(|c| kolKonumuTasi(c, k)))
  _ -> e
}

fn parcaKonumuTasi(p: MetinParcasi, k: Konum) -> MetinParcasi = match p {
  Duz(s) -> Duz(s)
  Gomme(e) -> Gomme(konumuTasi(e, k))
}

fn govdeKonumuTasi(g: Govde, k: Konum) -> Govde = match g {
  GBlok(b) -> GBlok(blokKonumuTasi(b, k))
  GDeyim(d) -> GDeyim(deyimKonumuTasi(d, k))
  GIfade(e) -> GIfade(konumuTasi(e, k))
}

fn blokKonumuTasi(b: Blok, k: Konum) -> Blok = Blok {
  konum: k,
  deyimler: b.deyimler.map(|d| deyimKonumuTasi(d, k))
}

fn kolKonumuTasi(c: Kol, k: Konum) -> Kol = Kol {
  konum: k,
  desen: desenKonumuTasi(c.desen, k),
  govde: govdeKonumuTasi(c.govde, k)
}

fn desenKonumuTasi(d: DesenD, k: Konum) -> DesenD = DesenD {
  konum: k,
  ic: match d.ic {
    DDeger(e) -> DDeger(konumuTasi(e, k))
    DVaryant(enumAdi, varyant, altlar) -> DVaryant(
      enumAdi, varyant, altlar.map(|a| desenKonumuTasi(a, k)))
    _ -> d.ic
  }
}

fn deyimKonumuTasi(d: DeyimD, k: Konum) -> DeyimD = DeyimD {
  konum: k,
  ic: icDeyimKonumuTasi(d.ic, k)
}

fn icDeyimKonumuTasi(s: Deyim, k: Konum) -> Deyim = match s {
  SLet(ad, tip, deger, degisebilir) -> SLet(
    ad, tip, if deger == none { none } else { konumuTasi(deger!, k) }, degisebilir)
  SAtama(op, hedef, deger) -> SAtama(op, konumuTasi(hedef, k), konumuTasi(deger, k))
  SIfade(e) -> SIfade(konumuTasi(e, k))
  SDonus(e) -> SDonus(if e == none { none } else { konumuTasi(e!, k) })
  SEger(kosul, ise, yoksa) -> SEger(
    konumuTasi(kosul, k), blokKonumuTasi(ise, k), yoksaKonumuTasi(yoksa, k))
  SWhile(kosul, govde) -> SWhile(konumuTasi(kosul, k), blokKonumuTasi(govde, k))
  SFor(adlar, kaynak, govde) -> SFor(
    adlar, konumuTasi(kaynak, k), blokKonumuTasi(govde, k))
  SMatch(konu, kollar) -> SMatch(
    konumuTasi(konu, k), kollar.map(|c| kolKonumuTasi(c, k)))
  _ -> s
}

fn yoksaKonumuTasi(y: Yoksa, k: Konum) -> Yoksa = match y {
  YYok -> YYok
  YBlok(b) -> YBlok(blokKonumuTasi(b, k))
  YEger(d) -> YEger(deyimKonumuTasi(d, k))
}

// --- dışa açılan giriş noktaları ------------------------------------------

fn cozumleyiciKur(tokenlar: [Token]) -> Cozumleyici = Cozumleyici {
  tokenlar: tokenlar,
  i: 0,
  structLitYok: false,
  hata: none
}

// Gömme içindeki tek bir ifadeyi çözümler.
fn ifadeMetinden(kaynak: String) -> GommeSonucu {
  match tokenlestir(kaynak) {
    LexSonucu.Hata(h) -> return GHata(h.mesaj)
    LexSonucu.Tamam(tokenlar) -> {
      let c = cozumleyiciKur(tokenlar)
      c.satirSonlariniAtla()
      let e = c.ifadeCozumle()
      c.satirSonlariniAtla()
      if c.hata != none {
        return GHata(c.hata!.mesaj)
      }
      if !c.suradaMi("eof") {
        return GHata("gömmede fazladan token var")
      }
      return GTamam(e)
    }
  }
}

// Kaynak metni çözümler.
fn cozumle(kaynak: String) -> Cozum {
  match tokenlestir(kaynak) {
    LexSonucu.Hata(h) -> return CHata(CozumHatasi {
      mesaj: h.mesaj, satir: h.satir, sutun: h.sutun
    })
    LexSonucu.Tamam(tokenlar) -> {
      let c = cozumleyiciKur(tokenlar)
      let m = c.modulCozumle()
      if c.hata != none {
        return CHata(c.hata!)
      }
      return CTamam(m)
    }
  }
}

// Kaynağın S-ifadesi; iki çözümleyiciyi karşılaştırmak için.
fn sifadeUret(kaynak: String) -> String {
  match cozumle(kaynak) {
    CTamam(m) -> return yazModul(m)
    CHata(h) -> return "HATA " + h.goster()
  }
}

// Konumlu S-ifadesi: satır/sütun hesabını da karşılaştırmak için.
fn sifadeUretKonumlu(kaynak: String) -> String {
  match cozumle(kaynak) {
    CTamam(m) -> return yazModulKonumlu(m)
    CHata(h) -> return "HATA " + h.goster()
  }
}
